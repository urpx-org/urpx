digraph "Metric & Measurement Entities" {
    rankdir=TB;
    bgcolor="white";
    pad=0.4;
    nodesep=0.8;
    ranksep=0.9;
    fontname="Inter, Helvetica, Arial, sans-serif";
    label="Metric & Measurement Entities (URPX v0.5.0)";
    labelloc="t";
    fontsize=14;
    fontcolor="#1a365d";
    node [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=10, style=filled, fontcolor="#1a365d"];
    edge [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=8, fontcolor="#1a365d"];

    // Section classes
    MetricInput [
        label="MetricInput"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    MetricSpecification [
        label="MetricSpecification"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    CalculationMethod [
        label="CalculationMethod"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];

    // Object property edges
    MetricInput -> CalculationMethod [
        label="hasCalculationMethod\n0..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    MetricInput -> MetricSpecification [
        label="hasMetricSpecification\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];

    // Layout-specified rank groups
    { rank=same; MetricInput; }
    { rank=same; MetricSpecification; CalculationMethod; }

    subgraph cluster_legend {
        label="Legend";
        fontname="Inter, Helvetica, Arial, sans-serif";
        fontsize=11;
        fontcolor="#1a365d";
        style=rounded;
        color="#cccccc";
        bgcolor="#f8f8f8";
        margin=12;

        leg_class [label="OWL Class\n(this section)", shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5];
        leg_src [label=" ", shape=point, width=0.01];
        leg_tgt1 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt1 [label="object property", color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
    }
}