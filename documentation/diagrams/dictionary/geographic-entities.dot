digraph "Geographic Entities" {
    rankdir=TB;
    bgcolor="white";
    pad=0.4;
    nodesep=0.7;
    ranksep=0.9;
    fontname="Inter, Helvetica, Arial, sans-serif";
    label="Geographic Entities (URPX v0.2.0)";
    labelloc="t";
    fontsize=14;
    fontcolor="#1a365d";
    node [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=10, style=filled, fontcolor="#1a365d"];
    edge [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=8, fontcolor="#1a365d"];

    // Section classes
    AdministrativeBoundary [
        label="Administrative\nBoundary"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    State [
        label="State"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    County [
        label="County"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    Municipality [
        label="Municipality"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ServiceTerritory [
        label="ServiceTerritory"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];

    // Object property edges

    // Layout-specified rank groups
    { rank=same; AdministrativeBoundary; }
    { rank=same; State; County; Municipality; }
    State -> County [style=invis];
    County -> Municipality [style=invis];
    { rank=same; ServiceTerritory; }

    subgraph cluster_legend {
        label="Legend";
        fontname="Inter, Helvetica, Arial, sans-serif";
        fontsize=11;
        fontcolor="#1a365d";
        style=rounded;
        color="#cccccc";
        bgcolor="#f8f8f8";
        margin=12;

        leg_class [label="OWL Class\n(this section)", shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5];
        leg_xref [label="OWL Class\n(other section)", shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"];
        leg_src [label=" ", shape=point, width=0.01];
        leg_tgt1 [label=" ", shape=point, width=0.01];
        leg_tgt2 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt1 [label="object property", color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
        leg_src -> leg_tgt2 [label="cross-section ref", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
    }
}