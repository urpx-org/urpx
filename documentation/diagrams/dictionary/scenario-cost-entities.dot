digraph "Scenario & Cost Entities" {
    rankdir=LR;
    bgcolor="white";
    pad=0.4;
    nodesep=0.7;
    ranksep=0.9;
    fontname="Inter, Helvetica, Arial, sans-serif";
    label="Scenario & Cost Entities (URPX v0.5.1)";
    labelloc="t";
    fontsize=14;
    fontcolor="#1a365d";
    node [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=10, style=filled, fontcolor="#1a365d"];
    edge [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=8, fontcolor="#1a365d"];

    // Section classes
    Scenario [
        label="Scenario"
        shape=box, style="filled,rounded", fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ScenarioCostModel [
        label="ScenarioCostModel"
        shape=box, style="filled,rounded", fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ScenarioCostResult [
        label="ScenarioCostResult"
        shape=box, style="filled,rounded", fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];

    // Cross-section references
    CoverageClaim [
        label="CoverageClaim"
        shape=box, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,rounded,dashed"
    ];
    CustomerProfile [
        label="CustomerProfile"
        shape=box, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,rounded,dashed"
    ];
    RatePlanVersion [
        label="RatePlanVersion"
        shape=box, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,rounded,dashed"
    ];
    ServicePointProfile [
        label="Service\nPointProfile"
        shape=box, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,rounded,dashed"
    ];

    // Object property edges
    Scenario -> CustomerProfile [
        label="hasCustomerProfile\n0..1", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    Scenario -> ServicePointProfile [
        label="hasServicePointProfile\n0..1", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ScenarioCostModel -> RatePlanVersion [
        label="consumesVersion\n0..*", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ScenarioCostModel -> Scenario [
        label="forScenario\n0..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ScenarioCostModel -> CoverageClaim [
        label="hasCoverageClaim\n0..*", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ScenarioCostModel -> ScenarioCostResult [
        label="producesResult\n0..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ScenarioCostResult -> CoverageClaim [
        label="hasCoverageClaim\n0..1", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];

    // Auto-computed rank hints
    { rank=same; Scenario; ScenarioCostResult; }

    subgraph cluster_legend {
        label="Legend";
        fontname="Inter, Helvetica, Arial, sans-serif";
        fontsize=11;
        fontcolor="#1a365d";
        style=rounded;
        color="#cccccc";
        bgcolor="#f8f8f8";
        margin=12;

        leg_class [label="OWL Class\n(this section)", shape=box, style="filled,rounded", fillcolor="#aaccff", color="#1a5276", penwidth=2.5];
        leg_xref [label="OWL Class\n(other section)", shape=box, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,rounded,dashed"];
        leg_src [label=" ", shape=point, width=0.01];
        leg_tgt1 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt1 [label="object property", color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
        leg_tgt2 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt2 [label="cross-section ref", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
    }
}