digraph "Core Rate Plan Entities" {
    rankdir=TB;
    bgcolor="white";
    pad=0.4;
    nodesep=0.6;
    ranksep=0.9;
    fontname="Inter, Helvetica, Arial, sans-serif";
    label="Core Rate Plan Entities (URPX v0.3.0)";
    labelloc="t";
    fontsize=14;
    fontcolor="#1a365d";
    node [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=10, style=filled, fontcolor="#1a365d"];
    edge [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=8, fontcolor="#1a365d"];

    // Section classes
    URPXPackage [
        label="URPXPackage"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    RatePlan [
        label="RatePlan"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    RatePlanIdentifier [
        label="RatePlanIdentifier"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    RatePlanVersion [
        label="RatePlanVersion"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    RatePlanModifier [
        label="RatePlanModifier"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    RatePlanModifierIdentifier [
        label="RatePlanModifier\nIdentifier"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    RatePlanModifierVersion [
        label="RatePlanModifier\nVersion"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];

    // Object property edges
    URPXPackage -> RatePlan [
        label="hasRatePlan\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5, weight=10
    ];
    URPXPackage -> RatePlanModifier [
        label="hasRatePlanModifier\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5, weight=10
    ];
    RatePlan -> RatePlanIdentifier [
        label="hasIdentifier\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5, weight=8
    ];
    RatePlanVersion -> RatePlan [
        label="applicableToRatePlan\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5, weight=10
    ];
    RatePlanVersion -> RatePlan [
        label="forRatePlan\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5, weight=10
    ];
    RatePlanVersion -> RatePlanIdentifier [
        label="hasIdentifier\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    RatePlanVersion -> RatePlanModifier [
        label="hasModifierOptions\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    RatePlanVersion -> RatePlanModifierVersion [
        label="hasModifierVersionOptions\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    RatePlanModifier -> RatePlanModifierIdentifier [
        label="hasIdentifier\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    RatePlanModifierVersion -> RatePlan [
        label="applicableToRatePlan\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    RatePlanModifierVersion -> RatePlanVersion [
        label="applicableToRatePlanVersion\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    RatePlanModifierVersion -> RatePlanModifier [
        label="forRatePlanModifier\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5, weight=10
    ];
    RatePlanModifierVersion -> RatePlanModifierIdentifier [
        label="hasIdentifier\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];

    // Layout-specified rank groups
    { rank=same; URPXPackage; }
    { rank=same; RatePlan; RatePlanModifier; }
    { rank=same; RatePlanIdentifier; RatePlanVersion; RatePlanModifierVersion; }

    subgraph cluster_legend {
        label="Legend";
        fontname="Inter, Helvetica, Arial, sans-serif";
        fontsize=11;
        fontcolor="#1a365d";
        style=rounded;
        color="#cccccc";
        bgcolor="#f8f8f8";
        margin=12;

        leg_class [label="OWL Class\n(this section)", shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5];
        leg_src [label=" ", shape=point, width=0.01];
        leg_tgt1 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt1 [label="object property", color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
    }
}