digraph "Condition Modeling" {
    rankdir=TB;
    bgcolor="white";
    pad=0.4;
    nodesep=0.9;
    ranksep=1.1;
    start=42;
    fontname="Inter, Helvetica, Arial, sans-serif";
    label="Condition Modeling (URPX v0.4.0)";
    labelloc="t";
    fontsize=14;
    fontcolor="#1a365d";
    node [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=10, style=filled, fontcolor="#1a365d"];
    edge [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=8, fontcolor="#1a365d"];

    // Section classes
    EligibilityRule [
        label="EligibilityRule"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ApplicabilityRule [
        label="ApplicabilityRule"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ApplicabilityGroup [
        label="ApplicabilityGroup"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ConditionExpression [
        label="Condition\nExpression"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ConditionNode [
        label="ConditionNode"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    BooleanOperationNode [
        label="BooleanOperation\nNode"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ComparisonNode [
        label="ComparisonNode"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    OperationNode [
        label="OperationNode"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    CustomOperandNode [
        label="CustomOperandNode"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    DatatypeOperandNode [
        label="DatatypeOperand\nNode"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ObjectOperandNode [
        label="ObjectOperandNode"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    GeneralRule [
        label="GeneralRule"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];

    // Cross-section references
    DataSourceReference [
        label="DataSource\nReference"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"
    ];
    MetricInput [
        label="MetricInput"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"
    ];
    PricingModel [
        label="PricingModel"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"
    ];

    // Object property edges
    EligibilityRule -> PricingModel [
        label="contributedBy\n0..*", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    EligibilityRule -> ConditionExpression [
        label="hasConditionExpression\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    EligibilityRule -> DataSourceReference [
        label="hasDataSourceReference\n0..*", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ApplicabilityRule -> PricingModel [
        label="contributedBy\n0..*", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ApplicabilityRule -> ConditionExpression [
        label="hasConditionExpression\n0..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ApplicabilityGroup -> ConditionExpression [
        label="hasConditionExpression\n0..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ConditionExpression -> ConditionNode [
        label="rootNode\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ConditionExpression -> ComparisonNode [
        label="rootNode\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ConditionExpression -> BooleanOperationNode [
        label="rootNode\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    BooleanOperationNode -> ConditionNode [
        label="operandNodes\n1..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    BooleanOperationNode -> ComparisonNode [
        label="operandNodes\n1..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ComparisonNode -> DatatypeOperandNode [
        label="leftOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ComparisonNode -> ObjectOperandNode [
        label="leftOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ComparisonNode -> CustomOperandNode [
        label="leftOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ComparisonNode -> OperationNode [
        label="leftOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ComparisonNode -> DatatypeOperandNode [
        label="rightOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ComparisonNode -> ObjectOperandNode [
        label="rightOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ComparisonNode -> CustomOperandNode [
        label="rightOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ComparisonNode -> OperationNode [
        label="rightOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    OperationNode -> DatatypeOperandNode [
        label="leftOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    OperationNode -> ObjectOperandNode [
        label="leftOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    OperationNode -> CustomOperandNode [
        label="leftOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    OperationNode -> DatatypeOperandNode [
        label="rightOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    OperationNode -> ObjectOperandNode [
        label="rightOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    OperationNode -> CustomOperandNode [
        label="rightOperand\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    CustomOperandNode -> MetricInput [
        label="referencesMetricInput\n0..1", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    DatatypeOperandNode -> MetricInput [
        label="referencesMetricInput\n0..1", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ObjectOperandNode -> MetricInput [
        label="referencesMetricInput\n0..1", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    GeneralRule -> PricingModel [
        label="contributedBy\n0..*", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    GeneralRule -> ApplicabilityRule [
        label="hasApplicabilityRule\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    GeneralRule -> DataSourceReference [
        label="hasDataSourceReference\n1..*", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];

    subgraph cluster_legend {
        label="Legend";
        fontname="Inter, Helvetica, Arial, sans-serif";
        fontsize=11;
        fontcolor="#1a365d";
        style=rounded;
        color="#cccccc";
        bgcolor="#f8f8f8";
        margin=12;

        leg_class [label="OWL Class\n(this section)", shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5];
        leg_xref [label="OWL Class\n(other section)", shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"];
        leg_src [label=" ", shape=point, width=0.01];
        leg_tgt1 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt1 [label="object property", color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
        leg_tgt2 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt2 [label="cross-section ref", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
    }
}