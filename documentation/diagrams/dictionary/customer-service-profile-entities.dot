digraph "Customer & Service Profile Entities" {
    rankdir=TB;
    bgcolor="white";
    pad=0.4;
    nodesep=0.6;
    ranksep=0.9;
    fontname="Inter, Helvetica, Arial, sans-serif";
    label="Customer & Service Profile Entities (URPX v0.2.0)";
    labelloc="t";
    fontsize=14;
    fontcolor="#1a365d";
    node [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=10, style=filled, fontcolor="#1a365d"];
    edge [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=8, fontcolor="#1a365d"];

    // Section classes
    Profile [
        label="Profile"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    CustomerProfile [
        label="CustomerProfile"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ServicePointProfile [
        label="ServicePoint\nProfile"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ProfileAlternative [
        label="ProfileAlternative"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ProfileAlternatives [
        label="ProfileAlternatives"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    AlternativeDimension [
        label="Alternative\nDimension"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    AlternativeDimensions [
        label="Alternative\nDimensions"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ServiceClass [
        label="ServiceClass"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    RateGroup [
        label="RateGroup"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    ProgramEnrollment [
        label="ProgramEnrollment"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    PriorRatePlan [
        label="PriorRatePlan"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    DistributedEnergyResource [
        label="DistributedEnergy\nResource"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];
    Scenario [
        label="Scenario"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5
    ];

    // Cross-section references
    ConditionExpression [
        label="Condition\nExpression"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"
    ];
    MetricInput [
        label="MetricInput"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"
    ];
    RatePlan [
        label="RatePlan"
        shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"
    ];

    // Per-class datatype nodes
    CustomerProfile_dt_string [
        label="xsd:string"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    ServicePointProfile_dt_decimal [
        label="xsd:decimal"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    ProfileAlternative_dt_string [
        label="xsd:string"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    AlternativeDimension_dt_string [
        label="xsd:string"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    AlternativeDimension_dt_anyURI [
        label="xsd:anyURI"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    ServiceClass_dt_string [
        label="xsd:string"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    RateGroup_dt_string [
        label="xsd:string"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    ProgramEnrollment_dt_date [
        label="xsd:date"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    PriorRatePlan_dt_date [
        label="xsd:date"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];
    DistributedEnergyResource_dt_decimal [
        label="xsd:decimal"
        shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"
    ];

    // Object property edges
    CustomerProfile -> PriorRatePlan [
        label="hasPriorRatePlan\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    CustomerProfile -> ProgramEnrollment [
        label="hasProgramEnrollment\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ServicePointProfile -> DistributedEnergyResource [
        label="hasDistributedEnergyResource\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ProfileAlternative -> ConditionExpression [
        label="hasConditionExpression\n1..1", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ProfileAlternatives -> AlternativeDimensions [
        label="hasAlternativeDimensions\n1..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    ProfileAlternatives -> ProfileAlternative [
        label="hasProfileAlternative\n2..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5, weight=8
    ];
    AlternativeDimension -> MetricInput [
        label="referencesMetricInput\n0..*", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    AlternativeDimensions -> AlternativeDimension [
        label="hasAlternativeDimension\n1..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5, weight=8
    ];
    ServiceClass -> RateGroup [
        label="hasRateGroup\n0..*", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    RateGroup -> ServiceClass [
        label="parentServiceClass\n0..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    PriorRatePlan -> RatePlan [
        label="referencesRatePlan\n0..1", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    Scenario -> CustomerProfile [
        label="hasCustomerProfile\n0..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];
    Scenario -> ServicePointProfile [
        label="hasServicePointProfile\n0..1", color="#1a5276", fontcolor="#1a5276", penwidth=1.5
    ];

    // Datatype property edges
    CustomerProfile -> CustomerProfile_dt_string [
        label="billingCycleCode\n0..*", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    CustomerProfile -> CustomerProfile_dt_string [
        label="creditRating\n0..*", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    ServicePointProfile -> ServicePointProfile_dt_decimal [
        label="averageMonthlyUsage\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    ServicePointProfile -> ServicePointProfile_dt_decimal [
        label="billedDemand\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    ProfileAlternative -> ProfileAlternative_dt_string [
        label="defaultSelectionLogic\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    AlternativeDimension -> AlternativeDimension_dt_string [
        label="dimensionDisplayName\n1..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    AlternativeDimension -> AlternativeDimension_dt_anyURI [
        label="dimensionProperty\n1..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    ServiceClass -> ServiceClass_dt_string [
        label="serviceClassCleaned\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    ServiceClass -> ServiceClass_dt_string [
        label="serviceClassName\n1..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    RateGroup -> RateGroup_dt_string [
        label="rateGroupIdentifier\n1..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    RateGroup -> RateGroup_dt_string [
        label="rateGroupName\n1..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    ProgramEnrollment -> ProgramEnrollment_dt_date [
        label="enrollmentEndDate\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    ProgramEnrollment -> ProgramEnrollment_dt_date [
        label="enrollmentStartDate\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    PriorRatePlan -> PriorRatePlan_dt_date [
        label="enrollmentEndDate\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    PriorRatePlan -> PriorRatePlan_dt_date [
        label="enrollmentStartDate\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    DistributedEnergyResource -> DistributedEnergyResource_dt_decimal [
        label="evChargingCapacity\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];
    DistributedEnergyResource -> DistributedEnergyResource_dt_decimal [
        label="powerRating\n0..1", color="#22c55e", fontcolor="#166534",
        style=dashed, penwidth=1.5
    ];

    // Layout-specified rank groups
    { rank=same; Profile; }
    { rank=same; CustomerProfile; ServicePointProfile; }
    CustomerProfile -> ServicePointProfile [style=invis];
    { rank=same; ProfileAlternatives; ProfileAlternative; }
    ProfileAlternatives -> ProfileAlternative [style=invis];
    { rank=same; AlternativeDimensions; AlternativeDimension; }
    AlternativeDimensions -> AlternativeDimension [style=invis];
    { rank=same; ServiceClass; RateGroup; }
    ServiceClass -> RateGroup [style=invis];
    { rank=same; ProgramEnrollment; PriorRatePlan; DistributedEnergyResource; }
    ProgramEnrollment -> PriorRatePlan [style=invis];
    PriorRatePlan -> DistributedEnergyResource [style=invis];

    subgraph cluster_legend {
        label="Legend";
        fontname="Inter, Helvetica, Arial, sans-serif";
        fontsize=11;
        fontcolor="#1a365d";
        style=rounded;
        color="#cccccc";
        bgcolor="#f8f8f8";
        margin=12;

        leg_class [label="OWL Class\n(this section)", shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=2.5];
        leg_xref [label="OWL Class\n(other section)", shape=ellipse, fillcolor="#aaccff", color="#1a5276", penwidth=1, style="filled,dashed"];
        leg_dt [label="XSD Datatype", shape=rectangle, fillcolor="#ccffcc", color="#22c55e", penwidth=2, fontname="monospace"];
        leg_src [label=" ", shape=point, width=0.01];
        leg_tgt1 [label=" ", shape=point, width=0.01];
        leg_tgt2 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt1 [label="object property", color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
        leg_src -> leg_tgt2 [label="cross-section ref", style=dashed, color="#1a5276", fontcolor="#1a5276", penwidth=1.5];
        leg_tgt3 [label=" ", shape=point, width=0.01];
        leg_src -> leg_tgt3 [label="datatype property", style=dashed, color="#22c55e", fontcolor="#166534", penwidth=1.5];
    }
}