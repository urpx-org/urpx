          "urpx:name": "PG&E Peak Day Pricing Program Information",
          "urpx:description": "PG&E's Peak Day Pricing program page. Events called on hot days when demand reaches extreme levels. 9-15 events/year, 4-9pm, day-ahead notice. Bill protection for first 12 months.",
          "urpx:mediaType": { "@id": "urpx:textHtml" }
        },
        {
          "@type": "urpx:DataSourceReference",
