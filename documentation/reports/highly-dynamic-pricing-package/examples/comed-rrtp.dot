    n_price_il_tax [
        label="{Price|name: IL Distribution Tax\lunitPrice: 0.00113\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_price_storm [
        label="{Price|name: Storm Hardening\lunitPrice: 0.00486\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_ps_adjustments [
        label="{PriceSet|startDate: 2026-01-01\l}"
        fillcolor="#00ADEF"
        color="#0088cc"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_price_env [
        label="{Price|name: Environmental Cost Recovery\lunitPrice: 0.00198\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_price_ee [
        label="{Price|name: Energy Efficiency\lunitPrice: 0.00241\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_price_rps [
        label="{Price|name: Renewable Portfolio Standard\lunitPrice: 0.00312\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_price_zes [
        label="{Price|name: Zero Emission Standard\lunitPrice: 0.00178\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
