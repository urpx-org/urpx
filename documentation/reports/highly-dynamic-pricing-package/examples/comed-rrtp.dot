        color="#0088cc"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_price_capacity [
        label="{Price|name: Capacity Obligation\lunitPrice: 0.02418\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_price_transmission [
        label="{Price|name: Transmission Services\lunitPrice: 0.01892\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_ps_delivery [
        label="{PriceSet|startDate: 2026-01-01\l}"
