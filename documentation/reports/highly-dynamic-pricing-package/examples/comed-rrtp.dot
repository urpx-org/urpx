    ];
    n_ledger_delivery -> n_mi_energy [
        label="referencesMetricInput"
        color="#999999"
        fontcolor="#999999"
        style=dashed
        penwidth=1
    ];
    n_ledger_service -> n_mi_meter [
        label="referencesMetricInput"
        color="#999999"
        fontcolor="#999999"
        style=dashed
        penwidth=1
    ];
    n_ledger_adjustments -> n_mi_energy [
        label="referencesMetricInput"
        color="#999999"
        fontcolor="#999999"
        style=dashed
        penwidth=1
    ];

    // Ledger -> PriceDefinitions
    n_ledger_supply -> n_pd_hourly_supply [
        label="hasPriceDefinition"
        color="#1a5276"
