        penwidth=1.5
    ];
    n_bm -> n_ledger_adjustments [
        label="hasLedger"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];

    // Ledger -> MetricInput references
    n_ledger_supply -> n_mi_energy [
