digraph "ComEd Residential Real-Time Pricing (RRTP)" {
    rankdir=TB;
    bgcolor="white";
    pad=0.5;
    nodesep=0.5;
    ranksep=0.7;
    fontname="Inter, Helvetica, Arial, sans-serif";
    label="ComEd Residential Real-Time Pricing (RRTP)";
    labelloc="t";
    fontsize=16;
    fontcolor="#1a365d";
    node [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=9, style=filled, shape=Mrecord];
    edge [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=8, fontcolor="#1a365d"];

    // --- Document Container ---
    n_hdp_doc [
        label="{HighlyDynamicPricesDocument|name: ComEd Residential Real-Time Pricing\leffectiveDateTime: 2026-01-01T00:00:00\lpriceCurrency: USD\ltimezoneIdentifier: America/Chicago\l}"
        fillcolor="#CC3311"
        color="#aa1100"
        fontcolor="#ffffff"
        penwidth=2.5
    ];

    // --- Rate Plan ---
    n_comed_rrtp [
        label="{RatePlan|ratePlanIdentifier: RRTP\lname: Residential Real-Time Pricing\linitialEffectiveDate: 2007-01-01\l}"
        fillcolor="#00386e"
        color="#002244"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_comed_rrtp_v [
        label="{RatePlanVersion|effectiveDateTime: 2026-01-01T00:00:00\lpriceCurrency: USD\lcommodity: electricity\lserviceRole: bundledServiceRole\l}"
        fillcolor="#1c5a8f"
        color="#0e3a5f"
        fontcolor="#ffffff"
        penwidth=2
    ];

    // --- Organization & ISO ---
    n_org_comed [
        label="{Organization|legalName: Commonwealth Edison Company\leiaId: 4110\lorganizationType: utilityOrganization\l}"
        fillcolor="#BBCC33"
        color="#99aa11"
        fontcolor="#333333"
        penwidth=2
    ];
    n_iso_pjm [
        label="{SystemOperator|legalName: PJM Interconnection LLC\lorganizationType: isoOrganization\l}"
        fillcolor="#99AA00"
        color="#778800"
        fontcolor="#ffffff"
        penwidth=2
    ];

    // --- Data Source References ---
    n_dsr_tariff [
        label="{DataSourceReference|fileName: ComEd_RRTP_Tariff_2026-01-01.pdf\lmediaType: application/pdf\l}"
        fillcolor="#A8D8CF"
        color="#86b6ad"
        fontcolor="#333333"
        penwidth=2
    ];
    n_dsr_live [
        label="{DataSourceReference|name: ComEd Hourly Pricing Live Prices API\lurl: hourlypricing.comed.com/live-prices/\lmediaType: text/html\l}"
        fillcolor="#A8D8CF"
        color="#86b6ad"
        fontcolor="#333333"
        penwidth=2
    ];

    // --- Eligibility ---
    n_er_residential [
        label="{EligibilityRule|description: Residential customers with\l  interval meter (smart meter)\l}"
        fillcolor="#AA3377"
        color="#882255"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_cp_residential [
        label="{CustomerProfile|customerKind: residentialKind\l}"
        fillcolor="#CC6677"
        color="#aa4455"
        fontcolor="#ffffff"
        penwidth=2
    ];

    // --- Plan Elements ---
    n_pe [
        label="PlanElements"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_season_summer [
        label="{Season|seasonName: Summer\lmonths: Jun-Sep\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_season_winter [
        label="{Season|seasonName: Winter\lmonths: Oct-May\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];

    // --- Metric Inputs ---
    n_mi_energy [
        label="{MetricInput|name: Hourly kWh Energy Consumption\lmetricInputType: measuredMetricInput\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_ms_energy [
        label="{MetricSpecification|measurementKind: energy\lunitOfMeasure: kWh\lflowDirection: forward\lintervalDuration: PT1H\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_mi_meter [
        label="{MetricInput|name: Per Meter Charges\lmetricInputType: profileMetricInput\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];

    // --- Billing Model ---
    n_bm [
        label="BillingModel"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];

    // --- Ledgers ---
    n_ledger_supply [
        label="{Ledger|name: Hourly Supply Prices\lledgerType: supplyLedger\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_ledger_delivery [
        label="{Ledger|name: Delivery Charges\lledgerType: deliveryLedger\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_ledger_service [
        label="{Ledger|name: Customer Service Charges\lledgerType: bundledLedger\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_ledger_adjustments [
        label="{Ledger|name: Adjustment Charges\lledgerType: bundledLedger\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];

    // --- Price Definitions ---
    n_pd_hourly_supply [
        label="{PriceDefinition|name: Hourly Energy Supply Price\lchargeType: usageCharge\lbillPortion: supplyPortion\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_capacity [
        label="{PriceDefinition|name: Capacity Obligation Charge\lchargeType: usageCharge\lbillPortion: supplyPortion\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_transmission [
        label="{PriceDefinition|name: Transmission Services Charge\lchargeType: transmission\lbillPortion: supplyPortion\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_dist_facilities [
        label="{PriceDefinition|name: Distribution Facilities\lchargeType: usageCharge\lbillPortion: deliveryPortion\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_il_tax [
        label="{PriceDefinition|name: IL Electricity Distribution Tax\lchargeType: taxCharge\lbillPortion: deliveryPortion\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_storm [
        label="{PriceDefinition|name: Storm Hardening\lchargeType: reliabilityCharge\lbillPortion: deliveryPortion\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_customer [
        label="{PriceDefinition|name: Customer Charge\lchargeType: minimumBill\lbillPortion: bundledPortion\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_env [
        label="{PriceDefinition|name: Environmental Cost Recovery\lchargeType: environmentalFunding\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_ee [
        label="{PriceDefinition|name: Energy Efficiency Programs\lchargeType: publicBenefits\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_rps [
        label="{PriceDefinition|name: Renewable Portfolio Standard\lchargeType: environmentalFunding\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];
    n_pd_zes [
        label="{PriceDefinition|name: Zero Emission Standard\lchargeType: environmentalFunding\l}"
        fillcolor="#aaccff"
        color="#1a5276"
        fontcolor="#1a365d"
        penwidth=2
    ];

    // --- Calculation Method ---
    n_cm_hourly [
        label="{CalculationMethod|intervalDuration: PT1H\lcalculationFormula: hourlyLMP + retailAdder\l}"
        fillcolor="#DDCC77"
        color="#bbaa55"
        fontcolor="#333333"
        penwidth=2
    ];

    // --- Prices Container ---
    n_prices [
        label="Prices"
        fillcolor="#00bd7e"
        color="#009966"
        fontcolor="#ffffff"
        penwidth=2
    ];

    // --- Individual Prices ---
    n_price_customer [
