        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2
    ];
    n_price_hourly_supply [
        label="{Price|name: Hourly Energy Supply Price\l  (Day-Ahead LMP + Retail Adder)\lunitPrice: 0.00735 (retail adder)\lstartDate: 2026-01-01\l}"
        fillcolor="#44BB99"
        color="#339977"
        fontcolor="#ffffff"
        penwidth=2.5
    ];

    // --- Dynamic Pricing (KEY NEW FEATURE) ---
    n_dp_hourly [
        label="{DynamicPricing|dynamicPricingType: realTimePricing\lpriceSource: wholesaleMarketSource\lupdateFrequency: hourlyUpdates\lpriceFloor: 0.00000\lpriceCeiling: 2.00000\l}"
        fillcolor="#EE3377"
        color="#cc1155"
        fontcolor="#ffffff"
        penwidth=2.5
    ];
    n_pur_lmp [
        label="{PriceUpdateRule|name: PJM Day-Ahead LMP for ComEd Zone\ldescription: Hourly supply price = PJM\l  day-ahead LMP, published by 16:00 EST\l  for following operating day\l}"
