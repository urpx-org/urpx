        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ledger_adjustments -> n_pd_ee [
        label="hasPriceDefinition"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ledger_adjustments -> n_pd_rps [
