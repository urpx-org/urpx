    subgraph cluster_legend {
        label="Legend — Node Colors by @type";
        fontname="Inter, Helvetica, Arial, sans-serif";
        fontsize=10;
        fontcolor="#1a365d";
        style=rounded;
        color="#cccccc";
        bgcolor="#f8f8f8";
        margin=12;
        leg_0 [label="HighlyDynamicPricesDocument", shape=box, fillcolor="#CC3311", color="#aa1100", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_1 [label="RatePlan", shape=box, fillcolor="#00386e", color="#002244", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_2 [label="RatePlanVersion", shape=box, fillcolor="#1c5a8f", color="#0e3a5f", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_3 [label="Organization", shape=box, fillcolor="#BBCC33", color="#99aa11", fontcolor="#333333", fontsize=9, penwidth=1.5];
        leg_4 [label="SystemOperator", shape=box, fillcolor="#99AA00", color="#778800", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_5 [label="DataSourceReference", shape=box, fillcolor="#A8D8CF", color="#86b6ad", fontcolor="#333333", fontsize=9, penwidth=1.5];
        leg_6 [label="EligibilityRule", shape=box, fillcolor="#AA3377", color="#882255", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
