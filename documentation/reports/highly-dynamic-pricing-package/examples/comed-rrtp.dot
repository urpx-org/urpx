    n_ps_delivery -> n_price_il_tax [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_delivery -> n_price_storm [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_prices -> n_ps_adjustments [
        label="hasPriceSet"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_adjustments -> n_price_env [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_adjustments -> n_price_ee [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
