    // Ledger -> PriceDefinitions (service)
    n_ledger_service -> n_pd_customer [
        label="hasPriceDefinition"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];

    // Version -> Prices
    n_rpv -> n_prices [
        label="hasPrices"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_prices -> n_price_customer [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
