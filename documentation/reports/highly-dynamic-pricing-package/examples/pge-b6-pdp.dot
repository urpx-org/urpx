    // Price -> DynamicPricing (KEY RELATIONSHIP)
    n_price_pdp_critical -> n_dp [
        label="hasDynamicPricing"
        color="#EE3377"
        fontcolor="#EE3377"
        penwidth=2.5
    ];
    n_dp -> n_pur [
        label="hasPriceUpdateRule"
        color="#EE3377"
        fontcolor="#EE3377"
        penwidth=2
    ];

    // Price -> PriceDefinition references
    n_price_pdp_critical -> n_pd_pdp_critical [
        label="referencesPriceDefinition"
        color="#999999"
        fontcolor="#999999"
        style=dashed
        penwidth=1
    ];
    n_price_pdp_credit -> n_pd_pdp_credit [
        label="referencesPriceDefinition"
        color="#999999"
        fontcolor="#999999"
        style=dashed
        penwidth=1
    ];
    n_price_customer -> n_pd_customer [
        label="referencesPriceDefinition"
        color="#999999"
        fontcolor="#999999"
        style=dashed
        penwidth=1
    ];

    // Price Sets
    n_prices -> n_ps_gen [
        label="hasPriceSet"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_gen -> n_price_gen_s_pk [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_gen -> n_price_gen_s_off [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_gen -> n_price_gen_w_pk [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_gen -> n_price_gen_w_off [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_prices -> n_ps_dist [
        label="hasPriceSet"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_dist -> n_price_dist_s_pk [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_dist -> n_price_dist_s_off [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_dist -> n_price_dist_w_pk [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_dist -> n_price_dist_w_off [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_dist -> n_price_transmission [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_prices -> n_ps_demand [
        label="hasPriceSet"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_demand -> n_price_demand_summer [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];
    n_ps_demand -> n_price_demand_winter [
        label="hasPrice"
        color="#1a5276"
        fontcolor="#1a5276"
        penwidth=1.5
    ];

    subgraph cluster_legend {
        label="Legend — Node Colors by @type";
        fontname="Inter, Helvetica, Arial, sans-serif";
        fontsize=10;
        fontcolor="#1a365d";
        style=rounded;
        color="#cccccc";
        bgcolor="#f8f8f8";
        margin=12;
        leg_0 [label="HighlyDynamicPricesDocument", shape=box, fillcolor="#CC3311", color="#aa1100", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_1 [label="RatePlan / RatePlanVersion", shape=box, fillcolor="#00386e", color="#002244", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_2 [label="Organization / SystemOperator", shape=box, fillcolor="#BBCC33", color="#99aa11", fontcolor="#333333", fontsize=9, penwidth=1.5];
        leg_3 [label="DataSourceReference", shape=box, fillcolor="#A8D8CF", color="#86b6ad", fontcolor="#333333", fontsize=9, penwidth=1.5];
        leg_4 [label="EligibilityRule / CustomerProfile", shape=box, fillcolor="#AA3377", color="#882255", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_5 [label="PlanElements / Season / MetricInput / Ledger / PriceDefinition", shape=box, fillcolor="#aaccff", color="#1a5276", fontcolor="#1a365d", fontsize=9, penwidth=1.5];
        leg_6 [label="TOUSchedule / TOUTier / TOUPeriod", shape=box, fillcolor="#DDCC77", color="#bbaa55", fontcolor="#333333", fontsize=9, penwidth=1.5];
        leg_7 [label="Prices", shape=box, fillcolor="#00bd7e", color="#009966", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_8 [label="Price", shape=box, fillcolor="#44BB99", color="#339977", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_9 [label="PriceSet", shape=box, fillcolor="#00ADEF", color="#0088cc", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_10 [label="DynamicPricing", shape=box, fillcolor="#EE3377", color="#cc1155", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_11 [label="PriceUpdateRule", shape=box, fillcolor="#EE7733", color="#cc5511", fontcolor="#ffffff", fontsize=9, penwidth=1.5];
        leg_0 -> leg_1 -> leg_2 -> leg_3 -> leg_4 -> leg_5 -> leg_6 -> leg_7 -> leg_8 -> leg_9 -> leg_10 -> leg_11 [style=invis];
    }
