digraph "PG&E Small General TOU with Peak Day Pricing (B-6 PDP)" {
    rankdir=TB;
    bgcolor="white";
    pad=0.5;
    nodesep=0.5;
    ranksep=0.7;
    fontname="Inter, Helvetica, Arial, sans-serif";
    label="PG&E Small General TOU with Peak Day Pricing (B-6 PDP)";
    labelloc="t";
    fontsize=16;
    fontcolor="#1a365d";
    node [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=9, style=filled, shape=Mrecord];
    edge [fontname="Inter, Helvetica, Arial, sans-serif", fontsize=8, fontcolor="#1a365d"];

    // --- Document Container ---
    n_hdp_doc [
        label="{HighlyDynamicPricesDocument|name: PG\&E Small General TOU\l  with Peak Day Pricing (B-6 PDP)\leffectiveDateTime: 2026-01-01T00:00:00\lpriceCurrency: USD\ltimezoneIdentifier: America/Los_Angeles\l}"
        fillcolor="#CC3311"
        color="#aa1100"
        fontcolor="#ffffff"
        penwidth=2.5
    ];

    // --- Rate Plan ---
