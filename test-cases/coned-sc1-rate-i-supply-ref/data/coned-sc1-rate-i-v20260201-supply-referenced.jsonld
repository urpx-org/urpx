          "@type": "urpx:BillingModel",
          "urpx:hasLedger": {
            "@id": "coned:ledger-supply",
            "@type": "urpx:Ledger",
            "urpx:name": "Supply",
            "urpx:ledgerType": { "@id": "urpx:supplyLedger" }
          },
          "urpx:hasPriceDefinition": {
            "@id": "coned:pd-supply-service-charge",
            "@type": "urpx:PriceDefinition",
            "urpx:contributedBy": { "@id": "coned:pm-sc1-supply-service-2026-02-01" },
            "urpx:name": "Supply Service Charge",
            "urpx:chargeType": { "@id": "urpx:usageCharge" },
            "urpx:chargeCategory": { "@id": "urpx:auxiliaryCharge" },
