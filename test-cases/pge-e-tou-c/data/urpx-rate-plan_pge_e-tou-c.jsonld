      "urpx:hasCoverageClaim": {
        "@type": "urpx:CoverageClaim",
        "@id": "pge:cc-e-tou-c-baseline-tier-2026-03-01",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "pge:eval-e-tou-c-baseline-tier-2026-03-01",
          "urpx:description": "The Baseline Credit and Conservation Incentive Adjustment prices effective 2026-03-01 are carried inline for the full territory × code × season baseline allowance matrix (10 territories × 2 codes × 2 seasons). Code M / Code S medical baseline allowances are not modeled, so coverage is partial. No component is priced externally, so the modifier version is self-contained."
        }
      },
      "urpx:version": "2026-03-01",
      "urpx:modifierVersionNumber": "2026-03-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Baseline Credit and Conservation Incentive Adjustment for PG&E Schedule E-TOU-C, modeled per the territory × code × season baseline allowance matrix (10 territories × 2 codes × 2 seasons = 40 cells). The Baseline Credit (-$0.08140/kWh) applies to Tier 1 (within baseline) usage only; the CIA applies to all usage with two values: -$0.02786/kWh on Tier 1 and +$0.05354/kWh on Tier 2 + Tier 2 Continued (over baseline). Tier boundaries are baseline-allowance-keyed and vary per cell; the Tier 2 cap is 4× the Tier 1 baseline per Special Condition 1. Cell selection is structural via urpx:ProfileAlternatives (territory + code dimensions); each urpx:ServiceTiers container references the matching urpx:ProfileAlternative. Code M / Code S medical baseline allowances are NOT modeled here — they require Rule 19 + Preliminary Statement Part A extraction (tracked separately as URPXT-qwr in the project tracker).",
      "urpx:effectiveDateTime": "2026-03-01T00:00:00",
      "urpx:priceCurrency": "USD",
