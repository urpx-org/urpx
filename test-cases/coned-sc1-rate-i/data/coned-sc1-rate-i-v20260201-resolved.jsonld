      "urpx:hasCoverageClaim": {
        "@id": "coned:cc-sc1-rate-i-v20260201",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": { "@id": "urpx:partial" },
        "urpx:confidence": { "@id": "urpx:verified" },
        "urpx:selfContained": true,
        "urpx:hasTemporalScope": {
          "@id": "coned:ts-cc-sc1-rate-i-v20260201-coverage",
          "@type": "urpx:TemporalScope",
          "urpx:scopeKind": { "@id": "urpx:coverage" },
          "urpx:startDate": "2026-02-01",
          "urpx:endDate": "2026-06-02"
        },
        "urpx:explainedBy": {
          "@id": "coned:eval-sc1-rate-i-v20260201",
          "@type": "urpx:Evaluation",
          "urpx:evaluatedBy": { "@id": "org:consolidated-edison" },
          "urpx:evaluatedOn": { "@value": "2026-05-01T16:00:00Z", "@type": "xsd:dateTime" },
          "urpx:description": "All contributing pricing models carry confidence urpx:verified. Delivery charges are effective-dated 2026-02-01 with no announced end. The MAC energy charge is re-estimated monthly, each Statement of Monthly Adjustment Clause superseding the previous one: the statements from the version effective date through the most recent published one (Nos. 169–172, effective 2026-02-01 through 2026-05-01) are materialised, each price ending when its successor takes effect and the latest left open; later statements re-reconcile into successor versions. The January statement (No. 168) is listed as a contributing source but is fully superseded before the version effective date; its exclusion is recorded machine-readably on this evaluation. MSC is a rolling monthly market feed: the published cycle prices covering the coverage window continuously (2025-12-31 through 2026-06-02, five cycles) are materialised; later cycles publish monthly and re-reconcile into successor versions. Coverage is partial: applicable PSC No. 10 statement charges beyond the MAC are not yet modeled for this plan; the modeled delivery, MAC, and market supply slots are continuous for the coverage window. No component is priced externally (no retrievedElsewhere references), hence selfContained true.",
          "urpx:hasModelExclusion": {
            "@id": "coned:excl-pm-gr26-mac-2026-01-01",
            "@type": "urpx:ModelExclusion",
            "urpx:excludedModel": { "@id": "coned:pm-gr26-mac-2026-01-01" },
            "urpx:exclusionReason": { "@id": "urpx:fullySuperseded" },
            "urpx:description": "Statement No. 168 (effective 2026-01-01) is superseded by Statement No. 169 before this version's effective date, so it contributes no element to the snapshot."
          }
        }
      },
