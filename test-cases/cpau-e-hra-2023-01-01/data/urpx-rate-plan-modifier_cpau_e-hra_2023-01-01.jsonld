              "@id": "urpx:cpau-hra-cond-reserve-above-max",
              "urpx:conditionType": "hydroStabilizationReserveLevel",
              "urpx:operator": { "@id": "urpx:greaterThanOperator" },
              "urpx:conditionValue": "Maximum"
