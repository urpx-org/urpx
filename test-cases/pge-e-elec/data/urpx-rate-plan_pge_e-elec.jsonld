        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "pge:eval-e-elec-2026-01-01",
          "urpx:description": "All plan elements and prices of Schedule E-ELEC effective 2026-01-01 are carried inline from the published tariff sheets, including the generation, distribution, and adjustment prices and the base services charge and California Climate Credit. No component is priced externally, so the version is self-contained."
