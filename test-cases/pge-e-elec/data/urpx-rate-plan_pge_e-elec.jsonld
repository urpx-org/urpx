      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "pge:er-residential-service",
          "urpx:name": "Eligibility for Residential Service",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "pge:ce-residential-service",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "pge:eligibility-root-residential-service",
              "urpx:logicExpression": "customer kind is residential AND customer has a qualifying electric technology or NBT enrollment",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@id": "pge:condition-customer-kind",
                  "@type": "urpx:ComparisonNode",
                  "urpx:logicExpression": "hasCustomerKind = residentialKind",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }
                  }
                },
                {
                  "@id": "pge:condition-qualifying-technology-or-program",
                  "@type": "urpx:BooleanOperationNode",
                  "urpx:logicExpression": "storage OR EV charging OR heat pump OR Net Billing Tariff enrollment",
                  "urpx:operator": {
                    "@id": "urpx:orOperator"
                  },
                  "urpx:operandNodes": [
                    {
                      "@id": "pge:condition-storage",
                      "@type": "urpx:ComparisonNode",
                      "urpx:logicExpression": "derType = storageDER",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "urpx:conditionProperty": {
                          "@id": "urpx:derType"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "urpx:referencesValue": {
                          "@id": "urpx:storageDER"
                        }
                      }
                    },
                    {
                      "@id": "pge:condition-EVCharging",
                      "@type": "urpx:ComparisonNode",
                      "urpx:logicExpression": "derType = evChargingDER",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "urpx:conditionProperty": {
                          "@id": "urpx:derType"
                        }
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:ObjectOperandNode",
                        "urpx:referencesValue": {
                          "@id": "urpx:evChargingDER"
                        }
                      }
                    },
                    {
                      "@id": "pge:condition-heatpump",
                      "@type": "urpx:ComparisonNode",
                      "urpx:logicExpression": "Has Heat Pump = true",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "urpx:customConditionProperty": "Has Heat Pump"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "urpx:booleanValue": true
                      }
                    },
                    {
                      "@id": "pge:condition-NBT",
                      "@type": "urpx:ComparisonNode",
                      "urpx:logicExpression": "Program Enrollment = Net Billing Tariff (NBT)",
                      "urpx:operator": {
                        "@id": "urpx:equalsOperator"
                      },
                      "urpx:leftOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "urpx:customConditionProperty": "Program Enrollment"
                      },
                      "urpx:rightOperand": {
                        "@type": "urpx:CustomOperandNode",
                        "urpx:stringValue": "Net Billing Tariff (NBT)"
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
