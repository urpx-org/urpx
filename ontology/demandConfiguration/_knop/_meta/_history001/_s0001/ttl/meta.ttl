@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/demandConfiguration/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/demandConfiguration" ;
  sflo:hasWorkingKnopInventoryFile <ontology/demandConfiguration/_knop/_inventory/inventory.ttl> .
