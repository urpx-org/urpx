@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/reliabilityCharge/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/reliabilityCharge" ;
  sflo:hasWorkingKnopInventoryFile <ontology/reliabilityCharge/_knop/_inventory/inventory.ttl> .
