@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/distributionStatement/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/distributionStatement" ;
  sflo:hasWorkingKnopInventoryFile <ontology/distributionStatement/_knop/_inventory/inventory.ttl> .
