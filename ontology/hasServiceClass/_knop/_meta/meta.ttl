@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasServiceClass/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasServiceClass" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasServiceClass/_knop/_inventory/inventory.ttl> .
