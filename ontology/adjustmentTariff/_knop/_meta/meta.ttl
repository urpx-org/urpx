@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/adjustmentTariff/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/adjustmentTariff" ;
  sflo:hasWorkingKnopInventoryFile <ontology/adjustmentTariff/_knop/_inventory/inventory.ttl> .
