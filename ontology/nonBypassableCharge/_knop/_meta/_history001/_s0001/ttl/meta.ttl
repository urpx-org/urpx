@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/nonBypassableCharge/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/nonBypassableCharge" ;
  sflo:hasWorkingKnopInventoryFile <ontology/nonBypassableCharge/_knop/_inventory/inventory.ttl> .
