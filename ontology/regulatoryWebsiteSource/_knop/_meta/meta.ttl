@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/regulatoryWebsiteSource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/regulatoryWebsiteSource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/regulatoryWebsiteSource/_knop/_inventory/inventory.ttl> .
