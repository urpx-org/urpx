@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/lessThanOperator/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/lessThanOperator" ;
  sflo:hasWorkingKnopInventoryFile <ontology/lessThanOperator/_knop/_inventory/inventory.ttl> .
