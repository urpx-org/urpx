@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/EnergyServiceProvider/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/EnergyServiceProvider" ;
  sflo:hasWorkingKnopInventoryFile <ontology/EnergyServiceProvider/_knop/_inventory/inventory.ttl> .
