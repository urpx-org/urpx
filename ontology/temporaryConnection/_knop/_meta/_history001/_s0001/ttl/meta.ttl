@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/temporaryConnection/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/temporaryConnection" ;
  sflo:hasWorkingKnopInventoryFile <ontology/temporaryConnection/_knop/_inventory/inventory.ttl> .
