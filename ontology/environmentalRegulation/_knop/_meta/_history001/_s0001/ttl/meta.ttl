@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/environmentalRegulation/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/environmentalRegulation" ;
  sflo:hasWorkingKnopInventoryFile <ontology/environmentalRegulation/_knop/_inventory/inventory.ttl> .
