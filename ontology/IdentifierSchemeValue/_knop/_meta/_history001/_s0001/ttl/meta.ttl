@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/IdentifierSchemeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/IdentifierSchemeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/IdentifierSchemeValue/_knop/_inventory/inventory.ttl> .
