@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ProgramEnrollment/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ProgramEnrollment" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ProgramEnrollment/_knop/_inventory/inventory.ttl> .
