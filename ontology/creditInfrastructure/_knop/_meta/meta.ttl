@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/creditInfrastructure/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/creditInfrastructure" ;
  sflo:hasWorkingKnopInventoryFile <ontology/creditInfrastructure/_knop/_inventory/inventory.ttl> .
