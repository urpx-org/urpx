@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/contractExpirationDate/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/contractExpirationDate" ;
  sflo:hasWorkingKnopInventoryFile <ontology/contractExpirationDate/_knop/_inventory/inventory.ttl> .
