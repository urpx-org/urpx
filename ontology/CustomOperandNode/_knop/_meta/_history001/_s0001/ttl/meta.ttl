@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/CustomOperandNode/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/CustomOperandNode" ;
  sflo:hasWorkingKnopInventoryFile <ontology/CustomOperandNode/_knop/_inventory/inventory.ttl> .
