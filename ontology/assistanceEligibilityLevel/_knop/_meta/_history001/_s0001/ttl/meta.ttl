@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/assistanceEligibilityLevel/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/assistanceEligibilityLevel" ;
  sflo:hasWorkingKnopInventoryFile <ontology/assistanceEligibilityLevel/_knop/_inventory/inventory.ttl> .
