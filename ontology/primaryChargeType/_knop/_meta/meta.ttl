@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/primaryChargeType/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/primaryChargeType" ;
  sflo:hasWorkingKnopInventoryFile <ontology/primaryChargeType/_knop/_inventory/inventory.ttl> .
