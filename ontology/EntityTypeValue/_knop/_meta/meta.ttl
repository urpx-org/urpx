@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/EntityTypeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/EntityTypeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/EntityTypeValue/_knop/_inventory/inventory.ttl> .
