@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/AdministrativeBoundary/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/AdministrativeBoundary" ;
  sflo:hasWorkingKnopInventoryFile <ontology/AdministrativeBoundary/_knop/_inventory/inventory.ttl> .
