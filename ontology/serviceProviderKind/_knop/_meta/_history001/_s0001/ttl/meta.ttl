@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/serviceProviderKind/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/serviceProviderKind" ;
  sflo:hasWorkingKnopInventoryFile <ontology/serviceProviderKind/_knop/_inventory/inventory.ttl> .
