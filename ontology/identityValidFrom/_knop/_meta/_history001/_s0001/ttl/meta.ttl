@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/identityValidFrom/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/identityValidFrom" ;
  sflo:hasWorkingKnopInventoryFile <ontology/identityValidFrom/_knop/_inventory/inventory.ttl> .
