@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/OrganizationTypeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/OrganizationTypeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/OrganizationTypeValue/_knop/_inventory/inventory.ttl> .
