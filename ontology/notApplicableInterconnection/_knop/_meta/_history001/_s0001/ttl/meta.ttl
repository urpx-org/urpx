@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/notApplicableInterconnection/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/notApplicableInterconnection" ;
  sflo:hasWorkingKnopInventoryFile <ontology/notApplicableInterconnection/_knop/_inventory/inventory.ttl> .
