@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasJurisdictionOver/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasJurisdictionOver" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasJurisdictionOver/_knop/_inventory/inventory.ttl> .
