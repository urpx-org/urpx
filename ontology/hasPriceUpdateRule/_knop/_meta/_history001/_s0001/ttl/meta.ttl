@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasPriceUpdateRule/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasPriceUpdateRule" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasPriceUpdateRule/_knop/_inventory/inventory.ttl> .
