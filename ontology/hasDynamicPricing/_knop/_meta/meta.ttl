@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasDynamicPricing/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasDynamicPricing" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasDynamicPricing/_knop/_inventory/inventory.ttl> .
