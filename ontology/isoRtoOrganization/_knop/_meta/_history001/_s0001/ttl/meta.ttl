@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/isoRtoOrganization/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/isoRtoOrganization" ;
  sflo:hasWorkingKnopInventoryFile <ontology/isoRtoOrganization/_knop/_inventory/inventory.ttl> .
