@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/serviceNonMetered/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/serviceNonMetered" ;
  sflo:hasWorkingKnopInventoryFile <ontology/serviceNonMetered/_knop/_inventory/inventory.ttl> .
