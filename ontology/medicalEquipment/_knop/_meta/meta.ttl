@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/medicalEquipment/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/medicalEquipment" ;
  sflo:hasWorkingKnopInventoryFile <ontology/medicalEquipment/_knop/_inventory/inventory.ttl> .
