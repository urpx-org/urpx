@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/modifierVersionNumber/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/modifierVersionNumber" ;
  sflo:hasWorkingKnopInventoryFile <ontology/modifierVersionNumber/_knop/_inventory/inventory.ttl> .
