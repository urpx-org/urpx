@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/regulatoryCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/regulatoryCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/regulatoryCategory/_knop/_inventory/inventory.ttl> .
