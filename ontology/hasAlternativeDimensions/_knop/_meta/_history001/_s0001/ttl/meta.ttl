@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasAlternativeDimensions/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasAlternativeDimensions" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasAlternativeDimensions/_knop/_inventory/inventory.ttl> .
