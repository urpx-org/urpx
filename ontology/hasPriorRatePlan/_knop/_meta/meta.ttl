@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasPriorRatePlan/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasPriorRatePlan" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasPriorRatePlan/_knop/_inventory/inventory.ttl> .
