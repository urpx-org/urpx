@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/dateTimePublished/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/dateTimePublished" ;
  sflo:hasWorkingKnopInventoryFile <ontology/dateTimePublished/_knop/_inventory/inventory.ttl> .
