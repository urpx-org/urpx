@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/municipalOwnership/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/municipalOwnership" ;
  sflo:hasWorkingKnopInventoryFile <ontology/municipalOwnership/_knop/_inventory/inventory.ttl> .
