@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/teslaSupercharger/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/teslaSupercharger" ;
  sflo:hasWorkingKnopInventoryFile <ontology/teslaSupercharger/_knop/_inventory/inventory.ttl> .
