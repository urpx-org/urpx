@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/residentialStandard/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/residentialStandard" ;
  sflo:hasWorkingKnopInventoryFile <ontology/residentialStandard/_knop/_inventory/inventory.ttl> .
