@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/roundTripEfficiency/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/roundTripEfficiency" ;
  sflo:hasWorkingKnopInventoryFile <ontology/roundTripEfficiency/_knop/_inventory/inventory.ttl> .
