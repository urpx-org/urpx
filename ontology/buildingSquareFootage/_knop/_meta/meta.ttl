@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/buildingSquareFootage/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/buildingSquareFootage" ;
  sflo:hasWorkingKnopInventoryFile <ontology/buildingSquareFootage/_knop/_inventory/inventory.ttl> .
