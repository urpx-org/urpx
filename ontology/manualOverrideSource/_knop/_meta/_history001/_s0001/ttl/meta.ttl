@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/manualOverrideSource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/manualOverrideSource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/manualOverrideSource/_knop/_inventory/inventory.ttl> .
