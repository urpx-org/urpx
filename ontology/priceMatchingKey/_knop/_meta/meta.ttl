@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/priceMatchingKey/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/priceMatchingKey" ;
  sflo:hasWorkingKnopInventoryFile <ontology/priceMatchingKey/_knop/_inventory/inventory.ttl> .
