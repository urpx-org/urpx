@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/summerPeakPattern/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/summerPeakPattern" ;
  sflo:hasWorkingKnopInventoryFile <ontology/summerPeakPattern/_knop/_inventory/inventory.ttl> .
