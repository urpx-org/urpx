@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/conservationCharge/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/conservationCharge" ;
  sflo:hasWorkingKnopInventoryFile <ontology/conservationCharge/_knop/_inventory/inventory.ttl> .
