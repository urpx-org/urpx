@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/localRegulatorScheme/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/localRegulatorScheme" ;
  sflo:hasWorkingKnopInventoryFile <ontology/localRegulatorScheme/_knop/_inventory/inventory.ttl> .
