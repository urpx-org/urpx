@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/BillPortionValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/BillPortionValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/BillPortionValue/_knop/_inventory/inventory.ttl> .
