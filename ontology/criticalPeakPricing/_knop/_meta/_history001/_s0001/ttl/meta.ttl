@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/criticalPeakPricing/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/criticalPeakPricing" ;
  sflo:hasWorkingKnopInventoryFile <ontology/criticalPeakPricing/_knop/_inventory/inventory.ttl> .
