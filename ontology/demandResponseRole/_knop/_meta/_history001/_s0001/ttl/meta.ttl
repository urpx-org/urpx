@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/demandResponseRole/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/demandResponseRole" ;
  sflo:hasWorkingKnopInventoryFile <ontology/demandResponseRole/_knop/_inventory/inventory.ttl> .
