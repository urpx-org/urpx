@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/referencesServiceBracket/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/referencesServiceBracket" ;
  sflo:hasWorkingKnopInventoryFile <ontology/referencesServiceBracket/_knop/_inventory/inventory.ttl> .
