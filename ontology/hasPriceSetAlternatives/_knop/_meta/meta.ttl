@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasPriceSetAlternatives/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasPriceSetAlternatives" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasPriceSetAlternatives/_knop/_inventory/inventory.ttl> .
