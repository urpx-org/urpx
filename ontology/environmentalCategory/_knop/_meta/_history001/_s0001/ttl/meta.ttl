@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/environmentalCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/environmentalCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/environmentalCategory/_knop/_inventory/inventory.ttl> .
