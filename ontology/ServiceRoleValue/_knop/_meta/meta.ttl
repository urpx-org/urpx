@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ServiceRoleValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ServiceRoleValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ServiceRoleValue/_knop/_inventory/inventory.ttl> .
