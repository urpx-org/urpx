@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/geographicZoneOther/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/geographicZoneOther" ;
  sflo:hasWorkingKnopInventoryFile <ontology/geographicZoneOther/_knop/_inventory/inventory.ttl> .
