@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/yearlyRecurrence/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/yearlyRecurrence" ;
  sflo:hasWorkingKnopInventoryFile <ontology/yearlyRecurrence/_knop/_inventory/inventory.ttl> .
