@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/religiousInstitution/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/religiousInstitution" ;
  sflo:hasWorkingKnopInventoryFile <ontology/religiousInstitution/_knop/_inventory/inventory.ttl> .
