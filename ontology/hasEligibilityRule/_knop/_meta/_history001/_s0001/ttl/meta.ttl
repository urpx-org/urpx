@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasEligibilityRule/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasEligibilityRule" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasEligibilityRule/_knop/_inventory/inventory.ttl> .
