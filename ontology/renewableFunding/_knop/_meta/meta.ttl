@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/renewableFunding/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/renewableFunding" ;
  sflo:hasWorkingKnopInventoryFile <ontology/renewableFunding/_knop/_inventory/inventory.ttl> .
