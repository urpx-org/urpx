@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/isCommunitySolarCustomer/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/isCommunitySolarCustomer" ;
  sflo:hasWorkingKnopInventoryFile <ontology/isCommunitySolarCustomer/_knop/_inventory/inventory.ttl> .
