@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/marketRegulation/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/marketRegulation" ;
  sflo:hasWorkingKnopInventoryFile <ontology/marketRegulation/_knop/_inventory/inventory.ttl> .
