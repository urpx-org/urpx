@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/purchasedPowerStatement/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/purchasedPowerStatement" ;
  sflo:hasWorkingKnopInventoryFile <ontology/purchasedPowerStatement/_knop/_inventory/inventory.ttl> .
