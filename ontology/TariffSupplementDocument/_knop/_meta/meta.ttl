@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/TariffSupplementDocument/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/TariffSupplementDocument" ;
  sflo:hasWorkingKnopInventoryFile <ontology/TariffSupplementDocument/_knop/_inventory/inventory.ttl> .
