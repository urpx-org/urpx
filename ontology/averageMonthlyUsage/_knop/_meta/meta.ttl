@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/averageMonthlyUsage/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/averageMonthlyUsage" ;
  sflo:hasWorkingKnopInventoryFile <ontology/averageMonthlyUsage/_knop/_inventory/inventory.ttl> .
