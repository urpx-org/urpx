@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/distributionRegulation/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/distributionRegulation" ;
  sflo:hasWorkingKnopInventoryFile <ontology/distributionRegulation/_knop/_inventory/inventory.ttl> .
