@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ChangeReasonValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ChangeReasonValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ChangeReasonValue/_knop/_inventory/inventory.ttl> .
