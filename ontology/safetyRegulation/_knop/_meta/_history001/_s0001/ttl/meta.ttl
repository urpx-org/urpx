@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/safetyRegulation/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/safetyRegulation" ;
  sflo:hasWorkingKnopInventoryFile <ontology/safetyRegulation/_knop/_inventory/inventory.ttl> .
