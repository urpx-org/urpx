@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/nonheatingEndUse/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/nonheatingEndUse" ;
  sflo:hasWorkingKnopInventoryFile <ontology/nonheatingEndUse/_knop/_inventory/inventory.ttl> .
