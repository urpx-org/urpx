@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/serviceClassCleaned/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/serviceClassCleaned" ;
  sflo:hasWorkingKnopInventoryFile <ontology/serviceClassCleaned/_knop/_inventory/inventory.ttl> .
