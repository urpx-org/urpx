@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/directConnection/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/directConnection" ;
  sflo:hasWorkingKnopInventoryFile <ontology/directConnection/_knop/_inventory/inventory.ttl> .
