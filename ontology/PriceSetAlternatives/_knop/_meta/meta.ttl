@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/PriceSetAlternatives/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/PriceSetAlternatives" ;
  sflo:hasWorkingKnopInventoryFile <ontology/PriceSetAlternatives/_knop/_inventory/inventory.ttl> .
