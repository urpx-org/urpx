@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/regulatoryScope/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/regulatoryScope" ;
  sflo:hasWorkingKnopInventoryFile <ontology/regulatoryScope/_knop/_inventory/inventory.ttl> .
