@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasRatePlanVersion/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasRatePlanVersion" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasRatePlanVersion/_knop/_inventory/inventory.ttl> .
