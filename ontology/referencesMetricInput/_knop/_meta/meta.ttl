@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/referencesMetricInput/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/referencesMetricInput" ;
  sflo:hasWorkingKnopInventoryFile <ontology/referencesMetricInput/_knop/_inventory/inventory.ttl> .
