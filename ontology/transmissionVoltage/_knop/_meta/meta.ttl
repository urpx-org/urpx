@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/transmissionVoltage/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/transmissionVoltage" ;
  sflo:hasWorkingKnopInventoryFile <ontology/transmissionVoltage/_knop/_inventory/inventory.ttl> .
