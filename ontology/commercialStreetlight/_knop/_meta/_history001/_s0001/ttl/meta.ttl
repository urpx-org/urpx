@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/commercialStreetlight/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/commercialStreetlight" ;
  sflo:hasWorkingKnopInventoryFile <ontology/commercialStreetlight/_knop/_inventory/inventory.ttl> .
