@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/IntervalSelectionValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/IntervalSelectionValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/IntervalSelectionValue/_knop/_inventory/inventory.ttl> .
