@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/CustomerKindValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/CustomerKindValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/CustomerKindValue/_knop/_inventory/inventory.ttl> .
