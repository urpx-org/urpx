@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/continuousUpdates/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/continuousUpdates" ;
  sflo:hasWorkingKnopInventoryFile <ontology/continuousUpdates/_knop/_inventory/inventory.ttl> .
