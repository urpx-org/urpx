@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/DynamicPricingTypeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/DynamicPricingTypeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/DynamicPricingTypeValue/_knop/_inventory/inventory.ttl> .
