@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ChargeCategoryValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ChargeCategoryValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ChargeCategoryValue/_knop/_inventory/inventory.ttl> .
