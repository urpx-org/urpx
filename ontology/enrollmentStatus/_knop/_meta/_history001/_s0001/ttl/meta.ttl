@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/enrollmentStatus/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/enrollmentStatus" ;
  sflo:hasWorkingKnopInventoryFile <ontology/enrollmentStatus/_knop/_inventory/inventory.ttl> .
