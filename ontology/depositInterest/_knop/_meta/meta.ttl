@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/depositInterest/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/depositInterest" ;
  sflo:hasWorkingKnopInventoryFile <ontology/depositInterest/_knop/_inventory/inventory.ttl> .
