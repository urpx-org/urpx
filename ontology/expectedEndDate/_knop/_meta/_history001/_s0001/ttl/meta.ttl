@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/expectedEndDate/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/expectedEndDate" ;
  sflo:hasWorkingKnopInventoryFile <ontology/expectedEndDate/_knop/_inventory/inventory.ttl> .
