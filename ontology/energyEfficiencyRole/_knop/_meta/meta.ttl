@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/energyEfficiencyRole/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/energyEfficiencyRole" ;
  sflo:hasWorkingKnopInventoryFile <ontology/energyEfficiencyRole/_knop/_inventory/inventory.ttl> .
