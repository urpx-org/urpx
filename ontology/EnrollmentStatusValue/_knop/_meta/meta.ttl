@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/EnrollmentStatusValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/EnrollmentStatusValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/EnrollmentStatusValue/_knop/_inventory/inventory.ttl> .
