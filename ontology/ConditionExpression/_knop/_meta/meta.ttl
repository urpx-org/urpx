@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ConditionExpression/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ConditionExpression" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ConditionExpression/_knop/_inventory/inventory.ttl> .
