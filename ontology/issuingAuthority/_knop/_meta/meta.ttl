@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/issuingAuthority/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/issuingAuthority" ;
  sflo:hasWorkingKnopInventoryFile <ontology/issuingAuthority/_knop/_inventory/inventory.ttl> .
