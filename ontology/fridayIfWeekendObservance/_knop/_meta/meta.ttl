@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/fridayIfWeekendObservance/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/fridayIfWeekendObservance" ;
  sflo:hasWorkingKnopInventoryFile <ontology/fridayIfWeekendObservance/_knop/_inventory/inventory.ttl> .
