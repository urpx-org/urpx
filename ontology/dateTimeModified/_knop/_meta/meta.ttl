@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/dateTimeModified/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/dateTimeModified" ;
  sflo:hasWorkingKnopInventoryFile <ontology/dateTimeModified/_knop/_inventory/inventory.ttl> .
