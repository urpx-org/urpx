@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/airSourceHeatPump/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/airSourceHeatPump" ;
  sflo:hasWorkingKnopInventoryFile <ontology/airSourceHeatPump/_knop/_inventory/inventory.ttl> .
