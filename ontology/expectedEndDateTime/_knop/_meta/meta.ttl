@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/expectedEndDateTime/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/expectedEndDateTime" ;
  sflo:hasWorkingKnopInventoryFile <ontology/expectedEndDateTime/_knop/_inventory/inventory.ttl> .
