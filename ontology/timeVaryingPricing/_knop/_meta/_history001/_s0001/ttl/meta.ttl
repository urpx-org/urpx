@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/timeVaryingPricing/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/timeVaryingPricing" ;
  sflo:hasWorkingKnopInventoryFile <ontology/timeVaryingPricing/_knop/_inventory/inventory.ttl> .
