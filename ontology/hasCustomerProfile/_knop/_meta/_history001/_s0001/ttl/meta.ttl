@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasCustomerProfile/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasCustomerProfile" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasCustomerProfile/_knop/_inventory/inventory.ttl> .
