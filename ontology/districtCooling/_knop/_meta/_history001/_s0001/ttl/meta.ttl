@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/districtCooling/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/districtCooling" ;
  sflo:hasWorkingKnopInventoryFile <ontology/districtCooling/_knop/_inventory/inventory.ttl> .
