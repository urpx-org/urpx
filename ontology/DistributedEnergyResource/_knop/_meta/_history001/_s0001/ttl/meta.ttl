@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/DistributedEnergyResource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/DistributedEnergyResource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/DistributedEnergyResource/_knop/_inventory/inventory.ttl> .
