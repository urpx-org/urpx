@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/greaterThanOperator/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/greaterThanOperator" ;
  sflo:hasWorkingKnopInventoryFile <ontology/greaterThanOperator/_knop/_inventory/inventory.ttl> .
