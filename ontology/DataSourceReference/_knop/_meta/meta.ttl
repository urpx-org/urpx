@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/DataSourceReference/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/DataSourceReference" ;
  sflo:hasWorkingKnopInventoryFile <ontology/DataSourceReference/_knop/_inventory/inventory.ttl> .
