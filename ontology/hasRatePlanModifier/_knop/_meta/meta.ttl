@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasRatePlanModifier/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasRatePlanModifier" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasRatePlanModifier/_knop/_inventory/inventory.ttl> .
