@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/modifierCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/modifierCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/modifierCategory/_knop/_inventory/inventory.ttl> .
