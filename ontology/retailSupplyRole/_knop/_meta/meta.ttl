@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/retailSupplyRole/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/retailSupplyRole" ;
  sflo:hasWorkingKnopInventoryFile <ontology/retailSupplyRole/_knop/_inventory/inventory.ttl> .
