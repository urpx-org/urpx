@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/panelOrientation/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/panelOrientation" ;
  sflo:hasWorkingKnopInventoryFile <ontology/panelOrientation/_knop/_inventory/inventory.ttl> .
