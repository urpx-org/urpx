@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/moderateIncomeProgram/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/moderateIncomeProgram" ;
  sflo:hasWorkingKnopInventoryFile <ontology/moderateIncomeProgram/_knop/_inventory/inventory.ttl> .
