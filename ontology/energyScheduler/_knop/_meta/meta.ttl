@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/energyScheduler/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/energyScheduler" ;
  sflo:hasWorkingKnopInventoryFile <ontology/energyScheduler/_knop/_inventory/inventory.ttl> .
