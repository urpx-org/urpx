@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/profileMetricLedger/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/profileMetricLedger" ;
  sflo:hasWorkingKnopInventoryFile <ontology/profileMetricLedger/_knop/_inventory/inventory.ttl> .
