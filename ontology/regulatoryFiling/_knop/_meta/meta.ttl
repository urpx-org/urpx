@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/regulatoryFiling/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/regulatoryFiling" ;
  sflo:hasWorkingKnopInventoryFile <ontology/regulatoryFiling/_knop/_inventory/inventory.ttl> .
