@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/multipleOrientations/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/multipleOrientations" ;
  sflo:hasWorkingKnopInventoryFile <ontology/multipleOrientations/_knop/_inventory/inventory.ttl> .
