@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/applicableToRateGroup/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/applicableToRateGroup" ;
  sflo:hasWorkingKnopInventoryFile <ontology/applicableToRateGroup/_knop/_inventory/inventory.ttl> .
