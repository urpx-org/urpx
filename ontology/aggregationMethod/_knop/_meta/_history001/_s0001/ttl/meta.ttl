@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/aggregationMethod/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/aggregationMethod" ;
  sflo:hasWorkingKnopInventoryFile <ontology/aggregationMethod/_knop/_inventory/inventory.ttl> .
