@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/DataSourceTypeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/DataSourceTypeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/DataSourceTypeValue/_knop/_inventory/inventory.ttl> .
