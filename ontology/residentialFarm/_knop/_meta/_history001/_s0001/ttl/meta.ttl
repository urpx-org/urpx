@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/residentialFarm/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/residentialFarm" ;
  sflo:hasWorkingKnopInventoryFile <ontology/residentialFarm/_knop/_inventory/inventory.ttl> .
