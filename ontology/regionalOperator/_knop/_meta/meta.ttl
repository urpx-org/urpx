@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/regionalOperator/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/regionalOperator" ;
  sflo:hasWorkingKnopInventoryFile <ontology/regionalOperator/_knop/_inventory/inventory.ttl> .
