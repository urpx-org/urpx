@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/premiseTypeOther/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/premiseTypeOther" ;
  sflo:hasWorkingKnopInventoryFile <ontology/premiseTypeOther/_knop/_inventory/inventory.ttl> .
