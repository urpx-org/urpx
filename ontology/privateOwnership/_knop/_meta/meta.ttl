@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/privateOwnership/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/privateOwnership" ;
  sflo:hasWorkingKnopInventoryFile <ontology/privateOwnership/_knop/_inventory/inventory.ttl> .
