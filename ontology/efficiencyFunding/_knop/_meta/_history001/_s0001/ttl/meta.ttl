@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/efficiencyFunding/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/efficiencyFunding" ;
  sflo:hasWorkingKnopInventoryFile <ontology/efficiencyFunding/_knop/_inventory/inventory.ttl> .
