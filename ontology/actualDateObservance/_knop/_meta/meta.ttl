@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/actualDateObservance/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/actualDateObservance" ;
  sflo:hasWorkingKnopInventoryFile <ontology/actualDateObservance/_knop/_inventory/inventory.ttl> .
