@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasProgramEnrollment/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasProgramEnrollment" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasProgramEnrollment/_knop/_inventory/inventory.ttl> .
