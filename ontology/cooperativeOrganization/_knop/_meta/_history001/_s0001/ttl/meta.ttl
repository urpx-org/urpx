@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/cooperativeOrganization/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/cooperativeOrganization" ;
  sflo:hasWorkingKnopInventoryFile <ontology/cooperativeOrganization/_knop/_inventory/inventory.ttl> .
