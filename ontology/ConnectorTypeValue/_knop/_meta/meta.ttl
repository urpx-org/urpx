@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ConnectorTypeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ConnectorTypeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ConnectorTypeValue/_knop/_inventory/inventory.ttl> .
