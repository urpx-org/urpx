@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/storageCapacity/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/storageCapacity" ;
  sflo:hasWorkingKnopInventoryFile <ontology/storageCapacity/_knop/_inventory/inventory.ttl> .
