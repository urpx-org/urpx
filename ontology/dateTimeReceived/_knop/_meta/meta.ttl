@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/dateTimeReceived/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/dateTimeReceived" ;
  sflo:hasWorkingKnopInventoryFile <ontology/dateTimeReceived/_knop/_inventory/inventory.ttl> .
