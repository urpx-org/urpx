@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/applicableToRatePlan/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/applicableToRatePlan" ;
  sflo:hasWorkingKnopInventoryFile <ontology/applicableToRatePlan/_knop/_inventory/inventory.ttl> .
