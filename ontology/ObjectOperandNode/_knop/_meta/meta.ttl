@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ObjectOperandNode/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ObjectOperandNode" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ObjectOperandNode/_knop/_inventory/inventory.ttl> .
