@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/referencesTouPeriod/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/referencesTouPeriod" ;
  sflo:hasWorkingKnopInventoryFile <ontology/referencesTouPeriod/_knop/_inventory/inventory.ttl> .
