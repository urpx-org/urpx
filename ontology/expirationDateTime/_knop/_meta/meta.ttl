@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/expirationDateTime/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/expirationDateTime" ;
  sflo:hasWorkingKnopInventoryFile <ontology/expirationDateTime/_knop/_inventory/inventory.ttl> .
