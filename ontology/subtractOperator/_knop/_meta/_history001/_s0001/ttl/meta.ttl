@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/subtractOperator/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/subtractOperator" ;
  sflo:hasWorkingKnopInventoryFile <ontology/subtractOperator/_knop/_inventory/inventory.ttl> .
