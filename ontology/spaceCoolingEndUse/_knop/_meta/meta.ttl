@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/spaceCoolingEndUse/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/spaceCoolingEndUse" ;
  sflo:hasWorkingKnopInventoryFile <ontology/spaceCoolingEndUse/_knop/_inventory/inventory.ttl> .
