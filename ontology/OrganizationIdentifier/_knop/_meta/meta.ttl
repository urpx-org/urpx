@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/OrganizationIdentifier/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/OrganizationIdentifier" ;
  sflo:hasWorkingKnopInventoryFile <ontology/OrganizationIdentifier/_knop/_inventory/inventory.ttl> .
