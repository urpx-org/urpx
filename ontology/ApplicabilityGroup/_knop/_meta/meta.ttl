@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ApplicabilityGroup/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ApplicabilityGroup" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ApplicabilityGroup/_knop/_inventory/inventory.ttl> .
