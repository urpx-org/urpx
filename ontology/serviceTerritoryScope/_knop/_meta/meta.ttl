@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/serviceTerritoryScope/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/serviceTerritoryScope" ;
  sflo:hasWorkingKnopInventoryFile <ontology/serviceTerritoryScope/_knop/_inventory/inventory.ttl> .
