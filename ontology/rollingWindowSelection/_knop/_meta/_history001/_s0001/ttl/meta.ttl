@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/rollingWindowSelection/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/rollingWindowSelection" ;
  sflo:hasWorkingKnopInventoryFile <ontology/rollingWindowSelection/_knop/_inventory/inventory.ttl> .
