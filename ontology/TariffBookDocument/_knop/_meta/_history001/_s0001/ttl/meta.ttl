@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/TariffBookDocument/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/TariffBookDocument" ;
  sflo:hasWorkingKnopInventoryFile <ontology/TariffBookDocument/_knop/_inventory/inventory.ttl> .
