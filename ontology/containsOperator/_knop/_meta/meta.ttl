@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/containsOperator/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/containsOperator" ;
  sflo:hasWorkingKnopInventoryFile <ontology/containsOperator/_knop/_inventory/inventory.ttl> .
