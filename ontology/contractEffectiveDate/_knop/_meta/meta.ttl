@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/contractEffectiveDate/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/contractEffectiveDate" ;
  sflo:hasWorkingKnopInventoryFile <ontology/contractEffectiveDate/_knop/_inventory/inventory.ttl> .
