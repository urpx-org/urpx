@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/effectiveDateTime/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/effectiveDateTime" ;
  sflo:hasWorkingKnopInventoryFile <ontology/effectiveDateTime/_knop/_inventory/inventory.ttl> .
