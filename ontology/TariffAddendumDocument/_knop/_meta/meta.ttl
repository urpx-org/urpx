@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/TariffAddendumDocument/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/TariffAddendumDocument" ;
  sflo:hasWorkingKnopInventoryFile <ontology/TariffAddendumDocument/_knop/_inventory/inventory.ttl> .
