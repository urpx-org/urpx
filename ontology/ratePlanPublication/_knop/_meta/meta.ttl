@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ratePlanPublication/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ratePlanPublication" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ratePlanPublication/_knop/_inventory/inventory.ttl> .
