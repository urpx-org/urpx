@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/districtHeatingConnection/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/districtHeatingConnection" ;
  sflo:hasWorkingKnopInventoryFile <ontology/districtHeatingConnection/_knop/_inventory/inventory.ttl> .
