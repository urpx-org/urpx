@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/TariffStatementDocument/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/TariffStatementDocument" ;
  sflo:hasWorkingKnopInventoryFile <ontology/TariffStatementDocument/_knop/_inventory/inventory.ttl> .
