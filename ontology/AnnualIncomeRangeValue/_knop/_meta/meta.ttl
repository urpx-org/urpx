@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/AnnualIncomeRangeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/AnnualIncomeRangeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/AnnualIncomeRangeValue/_knop/_inventory/inventory.ttl> .
