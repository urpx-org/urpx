@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasServiceTiers/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasServiceTiers" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasServiceTiers/_knop/_inventory/inventory.ttl> .
