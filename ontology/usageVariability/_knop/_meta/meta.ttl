@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/usageVariability/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/usageVariability" ;
  sflo:hasWorkingKnopInventoryFile <ontology/usageVariability/_knop/_inventory/inventory.ttl> .
