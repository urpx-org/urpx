@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/greenEnergyProgram/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/greenEnergyProgram" ;
  sflo:hasWorkingKnopInventoryFile <ontology/greenEnergyProgram/_knop/_inventory/inventory.ttl> .
