@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasPriceSetAlternative/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasPriceSetAlternative" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasPriceSetAlternative/_knop/_inventory/inventory.ttl> .
