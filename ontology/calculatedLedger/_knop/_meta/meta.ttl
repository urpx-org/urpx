@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/calculatedLedger/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/calculatedLedger" ;
  sflo:hasWorkingKnopInventoryFile <ontology/calculatedLedger/_knop/_inventory/inventory.ttl> .
