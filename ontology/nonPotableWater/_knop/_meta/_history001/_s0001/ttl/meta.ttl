@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/nonPotableWater/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/nonPotableWater" ;
  sflo:hasWorkingKnopInventoryFile <ontology/nonPotableWater/_knop/_inventory/inventory.ttl> .
