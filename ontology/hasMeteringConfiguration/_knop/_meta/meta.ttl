@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasMeteringConfiguration/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasMeteringConfiguration" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasMeteringConfiguration/_knop/_inventory/inventory.ttl> .
