@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ippOrganization/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ippOrganization" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ippOrganization/_knop/_inventory/inventory.ttl> .
