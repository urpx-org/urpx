@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasDataSourceReference/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasDataSourceReference" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasDataSourceReference/_knop/_inventory/inventory.ttl> .
