@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/demandResponseProgram/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/demandResponseProgram" ;
  sflo:hasWorkingKnopInventoryFile <ontology/demandResponseProgram/_knop/_inventory/inventory.ttl> .
