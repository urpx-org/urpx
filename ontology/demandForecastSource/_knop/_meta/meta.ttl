@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/demandForecastSource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/demandForecastSource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/demandForecastSource/_knop/_inventory/inventory.ttl> .
