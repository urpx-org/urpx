@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/dataCenterEndUse/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/dataCenterEndUse" ;
  sflo:hasWorkingKnopInventoryFile <ontology/dataCenterEndUse/_knop/_inventory/inventory.ttl> .
