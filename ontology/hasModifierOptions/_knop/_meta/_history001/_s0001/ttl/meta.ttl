@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasModifierOptions/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasModifierOptions" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasModifierOptions/_knop/_inventory/inventory.ttl> .
