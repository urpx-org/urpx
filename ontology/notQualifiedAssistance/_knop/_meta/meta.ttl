@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/notQualifiedAssistance/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/notQualifiedAssistance" ;
  sflo:hasWorkingKnopInventoryFile <ontology/notQualifiedAssistance/_knop/_inventory/inventory.ttl> .
