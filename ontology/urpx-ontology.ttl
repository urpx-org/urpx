    skos:prefLabel "Vulnerable Customer" .


# --- Tax Exempt Status Property (TaxExemptStatusValue) ---

urpx:exempt rdf:type urpx:TaxExemptStatusValue ;
    rdfs:label "Tax Exempt"@en ;
    skos:definition "Fully tax-exempt status - qualified for full tax exemption" ;
    skos:prefLabel "Exempt" .

urpx:nonExempt rdf:type urpx:TaxExemptStatusValue ;
    rdfs:label "Non-Exempt"@en ;
    skos:definition "Non-exempt tax status - standard taxation applies" ;
    skos:prefLabel "Non-Exempt" .

urpx:partialExempt rdf:type urpx:TaxExemptStatusValue ;
    rdfs:label "Partial Exempt"@en ;
    skos:definition "Partially tax-exempt status - qualified for partial tax exemption" ;
    skos:prefLabel "Partial Exempt" .

urpx:pendingVerification rdf:type urpx:TaxExemptStatusValue ;
    rdfs:label "Pending Verification"@en ;
    skos:definition "Tax exemption status pending verification - application under review" ;
    skos:prefLabel "Pending Verification" .


# --- TOU Tier Standard Name Property (TOUTierStandardNameValue) ---

urpx:criticalPeakTier rdf:type urpx:TOUTierStandardNameValue ;
    rdfs:label "Critical Peak Tier"@en ;
    skos:definition "Critical peak pricing tier - emergency demand response period" ;
    skos:prefLabel "Critical Peak" .

urpx:midPeakTier rdf:type urpx:TOUTierStandardNameValue ;
    rdfs:label "Mid Peak Tier"@en ;
    skos:definition "Mid peak pricing tier - moderate demand period" ;
    skos:prefLabel "Mid Peak" .

urpx:offPeakTier rdf:type urpx:TOUTierStandardNameValue ;
    rdfs:label "Off Peak Tier"@en ;
    skos:definition "Off peak pricing tier - low demand period" ;
    skos:prefLabel "Off Peak" .

urpx:peakTier rdf:type urpx:TOUTierStandardNameValue ;
    rdfs:label "Peak Tier"@en ;
    skos:definition "Peak pricing tier - high demand period" ;
    skos:prefLabel "Peak" .

urpx:shoulderTier rdf:type urpx:TOUTierStandardNameValue ;
    rdfs:label "Shoulder Tier"@en ;
    skos:definition "Shoulder pricing tier - transition period between peak and off-peak" ;
    skos:prefLabel "Shoulder" .

urpx:superOffPeakTier rdf:type urpx:TOUTierStandardNameValue ;
    rdfs:label "Super Off Peak Tier"@en ;
    skos:definition "Super off peak pricing tier - lowest cost period" ;
    skos:prefLabel "Super Off Peak" .

urpx:superPeakTier rdf:type urpx:TOUTierStandardNameValue ;
    rdfs:label "Super Peak Tier"@en ;
    skos:definition "Super peak pricing tier - highest cost period" ;
    skos:prefLabel "Super Peak" .


