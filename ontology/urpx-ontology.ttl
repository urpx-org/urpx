urpx:IntervalAlignmentValue a owl:Class ;
    rdfs:label "Interval Alignment Value"@en ;
    rdfs:comment "Defines how a temporal interval is anchored or aligned (e.g., calendar year, billing period, or rolling start)." ;
    owl:equivalentClass [ owl:oneOf ( urpx:calendarAligned urpx:billingPeriodAligned urpx:rollingAligned urpx:fixedAligned ) ] ;
    skos:note "Used in conjunction with intervalDuration to specify the precise temporal boundary of the metric measurement period." .

urpx:IntervalSelectionValue a owl:Class ;
    rdfs:label "Interval Selection Value"@en ;
    rdfs:comment "Defines how periods are selected or evaluated (e.g., rolling window, consecutive periods)." ;
    owl:equivalentClass [ owl:oneOf ( urpx:rollingWindowSelection urpx:consecutivePeriodsSelection urpx:fixedWindowSelection ) ] ;
    skos:note "Used in MetricSpecification to define non-standard temporal data aggregation/selection, particularly for eligibility rules." .

urpx:IntervalTypeValue a owl:Class ;
    rdfs:label "Interval Type Value"@en ;
    rdfs:comment "Single consolidated enumeration for standard temporal intervals used in billing and measurement" ;
    owl:equivalentClass [ owl:oneOf ( urpx:realTimeInterval urpx:fiveMinuteInterval urpx:fifteenMinuteInterval urpx:thirtyMinuteInterval urpx:hourlyInterval urpx:dailyInterval urpx:weeklyInterval urpx:monthlyInterval urpx:quarterlyInterval urpx:annualInterval urpx:customInterval ) ] ;
    skos:note "Consolidates all interval-related enumerations (BillingIntervalTypeValue, MeasurementIntervalTypeValue, CycleTypeValue) into one canonical list. Used for semantic labeling of required xsd:duration properties." .

urpx:InverterTypeValue a owl:Class ;
