# --- Update Frequency Property (UpdateFrequencyValue) ---

urpx:continuousUpdates rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "Continuous Updates"@en ;
    skos:definition "Continuous real-time price updates" ;
    skos:prefLabel "Continuous" .

urpx:dailyUpdates rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "Daily Updates"@en ;
    skos:definition "Price updates daily (P1D)" ;
    skos:prefLabel "Daily" .

urpx:eventTriggeredUpdates rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "Event Triggered Updates"@en ;
    skos:definition "Price updates triggered by specific market or grid events" ;
    skos:prefLabel "Event Triggered" .

urpx:every15Minutes rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "Every 15 Minutes"@en ;
    skos:definition "Price updates every 15 minutes (PT15M)" ;
    skos:prefLabel "Every 15 Minutes" .

urpx:every5Minutes rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "Every 5 Minutes"@en ;
    skos:definition "Price updates every 5 minutes (PT5M)" ;
    skos:prefLabel "Every 5 Minutes" .

urpx:hourlyUpdates rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "Hourly Updates"@en ;
    skos:definition "Price updates every hour (PT1H)" ;
    skos:prefLabel "Hourly" .

urpx:monthlyUpdates rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "Monthly Updates"@en ;
    skos:definition "Price updates monthly (P1M)" ;
    skos:prefLabel "Monthly" .

urpx:onDemandUpdates rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "On Demand Updates"@en ;
    skos:definition "Price updates triggered on demand by external events" ;
    skos:prefLabel "On Demand" .

urpx:weeklyUpdates rdf:type urpx:UpdateFrequencyValue ;
    rdfs:label "Weekly Updates"@en ;
    skos:definition "Price updates weekly (P1W)" ;
    skos:prefLabel "Weekly" .

urpx:profileMetricInput a urpx:MetricInputTypeValue ;
    rdfs:label "Profile Metric Input"@en ;
    skos:definition "Metric input from customer/service point profile characteristics" ;
    skos:note "Used for profile characteristics (not meter measurements). Examples: numberOfMeters, numberOfOccupants, buildingSquareFootage, billedDemand (utility estimate). NOT for values calculated from meter data like averageMonthlyUsage or loadFactor (use calculatedMetricInput). Profile characteristics can change over time. References profile properties via profileMetricProperty." .


# --- Voltage Level Property (VoltageLevel) ---

urpx:distributionVoltage rdf:type urpx:VoltageLevelValue ;
    rdfs:label "Distribution Voltage"@en ;
    skos:definition "Distribution voltage level - general distribution system voltage" ;
    skos:prefLabel "Distribution" .

urpx:primaryVoltage rdf:type urpx:VoltageLevelValue ;
    rdfs:label "Primary Voltage"@en ;
    skos:definition "Primary voltage level - typically 2.4kV-34.5kV distribution voltage" ;
    skos:prefLabel "Primary" .

urpx:secondaryVoltage rdf:type urpx:VoltageLevelValue ;
    rdfs:label "Secondary Voltage"@en ;
    skos:definition "Secondary voltage level - typically 120-600V residential and small commercial service" ;
    skos:prefLabel "Secondary" .

urpx:subTransmissionVoltage rdf:type urpx:VoltageLevelValue ;
    rdfs:label "Sub-Transmission Voltage"@en ;
    skos:definition "Sub-transmission voltage level - typically 34.5kV-115kV for regional distribution" ;
    skos:prefLabel "Sub-Transmission" .

urpx:transmissionVoltage rdf:type urpx:VoltageLevelValue ;
    rdfs:label "Transmission Voltage"@en ;
    skos:definition "Transmission voltage level - typically 115kV and above for bulk power transmission" ;
    skos:prefLabel "Transmission" .
