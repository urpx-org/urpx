@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasServiceBracket/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasServiceBracket" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasServiceBracket/_knop/_inventory/inventory.ttl> .
