@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/CustomerProfile/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/CustomerProfile" ;
  sflo:hasWorkingKnopInventoryFile <ontology/CustomerProfile/_knop/_inventory/inventory.ttl> .
