@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasBillingModel/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasBillingModel" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasBillingModel/_knop/_inventory/inventory.ttl> .
