@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasRatePlanModifierVersion/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasRatePlanModifierVersion" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasRatePlanModifierVersion/_knop/_inventory/inventory.ttl> .
