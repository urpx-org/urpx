@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/accumulationMethod/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/accumulationMethod" ;
  sflo:hasWorkingKnopInventoryFile <ontology/accumulationMethod/_knop/_inventory/inventory.ttl> .
