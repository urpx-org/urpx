@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/intervalAlignment/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/intervalAlignment" ;
  sflo:hasWorkingKnopInventoryFile <ontology/intervalAlignment/_knop/_inventory/inventory.ttl> .
