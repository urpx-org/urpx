@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/observesHoliday/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/observesHoliday" ;
  sflo:hasWorkingKnopInventoryFile <ontology/observesHoliday/_knop/_inventory/inventory.ttl> .
