@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/modifierCategoryOther/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/modifierCategoryOther" ;
  sflo:hasWorkingKnopInventoryFile <ontology/modifierCategoryOther/_knop/_inventory/inventory.ttl> .
