@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/RegulatoryAuthority/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/RegulatoryAuthority" ;
  sflo:hasWorkingKnopInventoryFile <ontology/RegulatoryAuthority/_knop/_inventory/inventory.ttl> .
