@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/agriculturalEndUse/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/agriculturalEndUse" ;
  sflo:hasWorkingKnopInventoryFile <ontology/agriculturalEndUse/_knop/_inventory/inventory.ttl> .
