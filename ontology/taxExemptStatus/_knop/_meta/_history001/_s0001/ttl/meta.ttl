@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/taxExemptStatus/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/taxExemptStatus" ;
  sflo:hasWorkingKnopInventoryFile <ontology/taxExemptStatus/_knop/_inventory/inventory.ttl> .
