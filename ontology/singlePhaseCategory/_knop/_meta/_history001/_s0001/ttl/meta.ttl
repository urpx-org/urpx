@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/singlePhaseCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/singlePhaseCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/singlePhaseCategory/_knop/_inventory/inventory.ttl> .
