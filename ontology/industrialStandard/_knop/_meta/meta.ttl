@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/industrialStandard/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/industrialStandard" ;
  sflo:hasWorkingKnopInventoryFile <ontology/industrialStandard/_knop/_inventory/inventory.ttl> .
