@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/dimensionDisplayName/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/dimensionDisplayName" ;
  sflo:hasWorkingKnopInventoryFile <ontology/dimensionDisplayName/_knop/_inventory/inventory.ttl> .
