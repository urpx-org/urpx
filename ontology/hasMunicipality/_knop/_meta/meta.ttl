@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasMunicipality/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasMunicipality" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasMunicipality/_knop/_inventory/inventory.ttl> .
