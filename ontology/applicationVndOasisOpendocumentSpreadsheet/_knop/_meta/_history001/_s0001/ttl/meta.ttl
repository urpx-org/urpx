@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/applicationVndOasisOpendocumentSpreadsheet/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/applicationVndOasisOpendocumentSpreadsheet" ;
  sflo:hasWorkingKnopInventoryFile <ontology/applicationVndOasisOpendocumentSpreadsheet/_knop/_inventory/inventory.ttl> .
