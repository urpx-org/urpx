@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/deliveryPortion/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/deliveryPortion" ;
  sflo:hasWorkingKnopInventoryFile <ontology/deliveryPortion/_knop/_inventory/inventory.ttl> .
