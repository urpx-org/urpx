@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/intervalSelection/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/intervalSelection" ;
  sflo:hasWorkingKnopInventoryFile <ontology/intervalSelection/_knop/_inventory/inventory.ttl> .
