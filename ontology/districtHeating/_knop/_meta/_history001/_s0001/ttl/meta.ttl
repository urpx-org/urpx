@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/districtHeating/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/districtHeating" ;
  sflo:hasWorkingKnopInventoryFile <ontology/districtHeating/_knop/_inventory/inventory.ttl> .
