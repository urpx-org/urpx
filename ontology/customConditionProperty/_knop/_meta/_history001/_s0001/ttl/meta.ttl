@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/customConditionProperty/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/customConditionProperty" ;
  sflo:hasWorkingKnopInventoryFile <ontology/customConditionProperty/_knop/_inventory/inventory.ttl> .
