@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/governmentEntity/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/governmentEntity" ;
  sflo:hasWorkingKnopInventoryFile <ontology/governmentEntity/_knop/_inventory/inventory.ttl> .
