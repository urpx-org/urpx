@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/AlternativeDimension/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/AlternativeDimension" ;
  sflo:hasWorkingKnopInventoryFile <ontology/AlternativeDimension/_knop/_inventory/inventory.ttl> .
