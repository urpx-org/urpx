@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/betweenOperator/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/betweenOperator" ;
  sflo:hasWorkingKnopInventoryFile <ontology/betweenOperator/_knop/_inventory/inventory.ttl> .
