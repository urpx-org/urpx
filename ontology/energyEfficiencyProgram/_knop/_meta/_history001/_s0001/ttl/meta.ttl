@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/energyEfficiencyProgram/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/energyEfficiencyProgram" ;
  sflo:hasWorkingKnopInventoryFile <ontology/energyEfficiencyProgram/_knop/_inventory/inventory.ttl> .
