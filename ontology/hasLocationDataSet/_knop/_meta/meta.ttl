@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasLocationDataSet/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasLocationDataSet" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasLocationDataSet/_knop/_inventory/inventory.ttl> .
