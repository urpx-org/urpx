@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/auxiliaryCharge> sflo:hasReferenceLink <ontology/auxiliaryCharge/_knop/_references#reference001> .

<ontology/auxiliaryCharge/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/auxiliaryCharge> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/auxiliaryCharge/_knop/_references#reference001-source> .

<ontology/auxiliaryCharge/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/releases/v0.2.0> .
