@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/auxiliaryCharge/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/auxiliaryCharge" ;
  sflo:hasWorkingKnopInventoryFile <ontology/auxiliaryCharge/_knop/_inventory/inventory.ttl> .
