@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/timezoneIdentifier/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/timezoneIdentifier" ;
  sflo:hasWorkingKnopInventoryFile <ontology/timezoneIdentifier/_knop/_inventory/inventory.ttl> .
