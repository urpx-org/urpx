@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/prorationMethod/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/prorationMethod" ;
  sflo:hasWorkingKnopInventoryFile <ontology/prorationMethod/_knop/_inventory/inventory.ttl> .
