@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasCalculationMethod/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasCalculationMethod" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasCalculationMethod/_knop/_inventory/inventory.ttl> .
