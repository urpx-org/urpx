@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasApplicabilityGroup/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasApplicabilityGroup" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasApplicabilityGroup/_knop/_inventory/inventory.ttl> .
