@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/municipalityScope/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/municipalityScope" ;
  sflo:hasWorkingKnopInventoryFile <ontology/municipalityScope/_knop/_inventory/inventory.ttl> .
