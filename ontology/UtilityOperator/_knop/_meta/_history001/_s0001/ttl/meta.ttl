@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/UtilityOperator/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/UtilityOperator" ;
  sflo:hasWorkingKnopInventoryFile <ontology/UtilityOperator/_knop/_inventory/inventory.ttl> .
