@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/PriceSetAlternative/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/PriceSetAlternative" ;
  sflo:hasWorkingKnopInventoryFile <ontology/PriceSetAlternative/_knop/_inventory/inventory.ttl> .
