@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/LoadProfileValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/LoadProfileValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/LoadProfileValue/_knop/_inventory/inventory.ttl> .
