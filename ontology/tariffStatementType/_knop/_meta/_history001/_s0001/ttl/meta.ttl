@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/tariffStatementType/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/tariffStatementType" ;
  sflo:hasWorkingKnopInventoryFile <ontology/tariffStatementType/_knop/_inventory/inventory.ttl> .
