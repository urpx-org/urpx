@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/realTimePricing/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/realTimePricing" ;
  sflo:hasWorkingKnopInventoryFile <ontology/realTimePricing/_knop/_inventory/inventory.ttl> .
