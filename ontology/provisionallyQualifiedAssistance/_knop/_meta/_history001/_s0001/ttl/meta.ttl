@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/provisionallyQualifiedAssistance/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/provisionallyQualifiedAssistance" ;
  sflo:hasWorkingKnopInventoryFile <ontology/provisionallyQualifiedAssistance/_knop/_inventory/inventory.ttl> .
