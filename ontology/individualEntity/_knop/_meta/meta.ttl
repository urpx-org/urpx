@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/individualEntity/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/individualEntity" ;
  sflo:hasWorkingKnopInventoryFile <ontology/individualEntity/_knop/_inventory/inventory.ttl> .
