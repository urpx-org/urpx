@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/demandResponsePricing/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/demandResponsePricing" ;
  sflo:hasWorkingKnopInventoryFile <ontology/demandResponsePricing/_knop/_inventory/inventory.ttl> .
