@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/nonResidentialKind/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/nonResidentialKind" ;
  sflo:hasWorkingKnopInventoryFile <ontology/nonResidentialKind/_knop/_inventory/inventory.ttl> .
