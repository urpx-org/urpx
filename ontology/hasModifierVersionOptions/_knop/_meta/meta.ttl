@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasModifierVersionOptions/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasModifierVersionOptions" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasModifierVersionOptions/_knop/_inventory/inventory.ttl> .
