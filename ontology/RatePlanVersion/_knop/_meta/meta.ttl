@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/RatePlanVersion/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/RatePlanVersion" ;
  sflo:hasWorkingKnopInventoryFile <ontology/RatePlanVersion/_knop/_inventory/inventory.ttl> .
