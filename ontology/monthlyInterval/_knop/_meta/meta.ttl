@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/monthlyInterval/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/monthlyInterval" ;
  sflo:hasWorkingKnopInventoryFile <ontology/monthlyInterval/_knop/_inventory/inventory.ttl> .
