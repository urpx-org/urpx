@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/criticalPeakTier/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/criticalPeakTier" ;
  sflo:hasWorkingKnopInventoryFile <ontology/criticalPeakTier/_knop/_inventory/inventory.ttl> .
