@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/dateTimeCreated/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/dateTimeCreated" ;
  sflo:hasWorkingKnopInventoryFile <ontology/dateTimeCreated/_knop/_inventory/inventory.ttl> .
