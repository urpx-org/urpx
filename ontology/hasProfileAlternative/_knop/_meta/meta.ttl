@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasProfileAlternative/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasProfileAlternative" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasProfileAlternative/_knop/_inventory/inventory.ttl> .
