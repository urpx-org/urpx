@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/transmissionLedger/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/transmissionLedger" ;
  sflo:hasWorkingKnopInventoryFile <ontology/transmissionLedger/_knop/_inventory/inventory.ttl> .
