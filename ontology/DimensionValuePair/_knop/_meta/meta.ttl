@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/DimensionValuePair/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/DimensionValuePair" ;
  sflo:hasWorkingKnopInventoryFile <ontology/DimensionValuePair/_knop/_inventory/inventory.ttl> .
