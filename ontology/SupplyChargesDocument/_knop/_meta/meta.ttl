@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/SupplyChargesDocument/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/SupplyChargesDocument" ;
  sflo:hasWorkingKnopInventoryFile <ontology/SupplyChargesDocument/_knop/_inventory/inventory.ttl> .
