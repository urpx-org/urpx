@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/mandatoryChoice/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/mandatoryChoice" ;
  sflo:hasWorkingKnopInventoryFile <ontology/mandatoryChoice/_knop/_inventory/inventory.ttl> .
