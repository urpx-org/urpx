@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasPossibleValues/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasPossibleValues" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasPossibleValues/_knop/_inventory/inventory.ttl> .
