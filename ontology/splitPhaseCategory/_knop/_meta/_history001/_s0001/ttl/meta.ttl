@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/splitPhaseCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/splitPhaseCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/splitPhaseCategory/_knop/_inventory/inventory.ttl> .
