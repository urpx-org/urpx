@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/municipalOrganization/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/municipalOrganization" ;
  sflo:hasWorkingKnopInventoryFile <ontology/municipalOrganization/_knop/_inventory/inventory.ttl> .
