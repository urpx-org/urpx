@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/shacl/ServiceBracketShape/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/shacl/ServiceBracketShape" ;
  sflo:hasWorkingKnopInventoryFile <ontology/shacl/ServiceBracketShape/_knop/_inventory/inventory.ttl> .
