@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/profileMetricProperty/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/profileMetricProperty" ;
  sflo:hasWorkingKnopInventoryFile <ontology/profileMetricProperty/_knop/_inventory/inventory.ttl> .
