@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/threePhaseCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/threePhaseCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/threePhaseCategory/_knop/_inventory/inventory.ttl> .
