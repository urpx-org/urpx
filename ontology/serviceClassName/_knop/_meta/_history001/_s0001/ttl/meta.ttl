@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/serviceClassName/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/serviceClassName" ;
  sflo:hasWorkingKnopInventoryFile <ontology/serviceClassName/_knop/_inventory/inventory.ttl> .
