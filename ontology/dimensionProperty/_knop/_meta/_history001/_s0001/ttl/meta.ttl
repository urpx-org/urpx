@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/dimensionProperty/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/dimensionProperty" ;
  sflo:hasWorkingKnopInventoryFile <ontology/dimensionProperty/_knop/_inventory/inventory.ttl> .
