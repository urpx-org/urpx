@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/publicationType/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/publicationType" ;
  sflo:hasWorkingKnopInventoryFile <ontology/publicationType/_knop/_inventory/inventory.ttl> .
