@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/streetLightingEndUse/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/streetLightingEndUse" ;
  sflo:hasWorkingKnopInventoryFile <ontology/streetLightingEndUse/_knop/_inventory/inventory.ttl> .
