@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/overheadConnection/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/overheadConnection" ;
  sflo:hasWorkingKnopInventoryFile <ontology/overheadConnection/_knop/_inventory/inventory.ttl> .
