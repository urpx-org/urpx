@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/demandSideManagement/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/demandSideManagement" ;
  sflo:hasWorkingKnopInventoryFile <ontology/demandSideManagement/_knop/_inventory/inventory.ttl> .
