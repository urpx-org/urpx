@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/tariffStatement/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/tariffStatement" ;
  sflo:hasWorkingKnopInventoryFile <ontology/tariffStatement/_knop/_inventory/inventory.ttl> .
