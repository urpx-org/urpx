@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/algorithmicSource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/algorithmicSource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/algorithmicSource/_knop/_inventory/inventory.ttl> .
