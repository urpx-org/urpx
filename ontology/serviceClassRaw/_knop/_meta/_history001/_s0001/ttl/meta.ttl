@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/serviceClassRaw/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/serviceClassRaw" ;
  sflo:hasWorkingKnopInventoryFile <ontology/serviceClassRaw/_knop/_inventory/inventory.ttl> .
