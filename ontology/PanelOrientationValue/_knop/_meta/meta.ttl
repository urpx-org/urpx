@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/PanelOrientationValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/PanelOrientationValue" ;
