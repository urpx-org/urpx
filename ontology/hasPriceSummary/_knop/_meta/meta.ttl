@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasPriceSummary/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasPriceSummary" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasPriceSummary/_knop/_inventory/inventory.ttl> .
