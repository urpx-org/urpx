@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/regulatoryOrder/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/regulatoryOrder" ;
  sflo:hasWorkingKnopInventoryFile <ontology/regulatoryOrder/_knop/_inventory/inventory.ttl> .
