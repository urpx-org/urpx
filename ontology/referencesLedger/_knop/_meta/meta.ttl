@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/referencesLedger/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/referencesLedger" ;
  sflo:hasWorkingKnopInventoryFile <ontology/referencesLedger/_knop/_inventory/inventory.ttl> .
