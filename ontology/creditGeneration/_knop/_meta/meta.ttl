@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/creditGeneration/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/creditGeneration" ;
  sflo:hasWorkingKnopInventoryFile <ontology/creditGeneration/_knop/_inventory/inventory.ttl> .
