@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/demandManagementCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/demandManagementCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/demandManagementCategory/_knop/_inventory/inventory.ttl> .
