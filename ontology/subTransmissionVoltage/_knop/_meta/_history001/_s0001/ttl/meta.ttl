@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/subTransmissionVoltage/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/subTransmissionVoltage" ;
  sflo:hasWorkingKnopInventoryFile <ontology/subTransmissionVoltage/_knop/_inventory/inventory.ttl> .
