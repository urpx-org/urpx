@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/adjustmentPowerCost/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/adjustmentPowerCost" ;
  sflo:hasWorkingKnopInventoryFile <ontology/adjustmentPowerCost/_knop/_inventory/inventory.ttl> .
