@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/InverterTypeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/InverterTypeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/InverterTypeValue/_knop/_inventory/inventory.ttl> .
