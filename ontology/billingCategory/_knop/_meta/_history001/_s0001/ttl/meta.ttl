@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/billingCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/billingCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/billingCategory/_knop/_inventory/inventory.ttl> .
