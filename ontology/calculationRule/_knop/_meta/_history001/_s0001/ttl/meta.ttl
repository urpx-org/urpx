@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/calculationRule/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/calculationRule" ;
  sflo:hasWorkingKnopInventoryFile <ontology/calculationRule/_knop/_inventory/inventory.ttl> .
