@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/applicabilityLogic/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/applicabilityLogic" ;
  sflo:hasWorkingKnopInventoryFile <ontology/applicabilityLogic/_knop/_inventory/inventory.ttl> .
