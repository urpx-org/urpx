@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/expiredStatus> sflo:hasReferenceLink <ontology/expiredStatus/_knop/_references#reference001> .

<ontology/expiredStatus/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/expiredStatus> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/expiredStatus/_knop/_references#reference001-source> .

<ontology/expiredStatus/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:targetArtifact <ontology> ;
  sflo:targetHistoricalState <ontology/releases/v0.2.0> .
