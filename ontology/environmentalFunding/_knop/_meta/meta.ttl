@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/environmentalFunding/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/environmentalFunding" ;
  sflo:hasWorkingKnopInventoryFile <ontology/environmentalFunding/_knop/_inventory/inventory.ttl> .
