@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/customerServiceCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/customerServiceCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/customerServiceCategory/_knop/_inventory/inventory.ttl> .
