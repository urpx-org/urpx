@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/quarterlyInterval/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/quarterlyInterval" ;
  sflo:hasWorkingKnopInventoryFile <ontology/quarterlyInterval/_knop/_inventory/inventory.ttl> .
