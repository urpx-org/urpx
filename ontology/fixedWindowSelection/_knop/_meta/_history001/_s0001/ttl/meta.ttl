@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/fixedWindowSelection/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/fixedWindowSelection" ;
  sflo:hasWorkingKnopInventoryFile <ontology/fixedWindowSelection/_knop/_inventory/inventory.ttl> .
