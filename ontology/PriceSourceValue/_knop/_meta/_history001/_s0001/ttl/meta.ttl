@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/PriceSourceValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/PriceSourceValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/PriceSourceValue/_knop/_inventory/inventory.ttl> .
