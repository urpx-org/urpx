@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/referencesValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/referencesValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/referencesValue/_knop/_inventory/inventory.ttl> .
