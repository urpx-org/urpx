@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/wholesaleMarketSource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/wholesaleMarketSource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/wholesaleMarketSource/_knop/_inventory/inventory.ttl> .
