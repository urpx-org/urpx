@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/multiplyOperator/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/multiplyOperator" ;
  sflo:hasWorkingKnopInventoryFile <ontology/multiplyOperator/_knop/_inventory/inventory.ttl> .
