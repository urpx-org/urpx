@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/centralInverter/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/centralInverter" ;
  sflo:hasWorkingKnopInventoryFile <ontology/centralInverter/_knop/_inventory/inventory.ttl> .
