@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/includeNonHolidays/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/includeNonHolidays" ;
  sflo:hasWorkingKnopInventoryFile <ontology/includeNonHolidays/_knop/_inventory/inventory.ttl> .
