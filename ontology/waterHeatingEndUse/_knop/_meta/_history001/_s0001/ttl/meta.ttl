@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/waterHeatingEndUse/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/waterHeatingEndUse" ;
  sflo:hasWorkingKnopInventoryFile <ontology/waterHeatingEndUse/_knop/_inventory/inventory.ttl> .
