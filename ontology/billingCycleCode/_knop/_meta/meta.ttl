@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/billingCycleCode/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/billingCycleCode" ;
  sflo:hasWorkingKnopInventoryFile <ontology/billingCycleCode/_knop/_inventory/inventory.ttl> .
