@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/solarInstallationRole/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/solarInstallationRole" ;
  sflo:hasWorkingKnopInventoryFile <ontology/solarInstallationRole/_knop/_inventory/inventory.ttl> .
