@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/aggregatorOrganization/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/aggregatorOrganization" ;
  sflo:hasWorkingKnopInventoryFile <ontology/aggregatorOrganization/_knop/_inventory/inventory.ttl> .
