@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/nonprofitEntity/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/nonprofitEntity" ;
  sflo:hasWorkingKnopInventoryFile <ontology/nonprofitEntity/_knop/_inventory/inventory.ttl> .
