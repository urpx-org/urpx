@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/TariffPublication/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/TariffPublication" ;
  sflo:hasWorkingKnopInventoryFile <ontology/TariffPublication/_knop/_inventory/inventory.ttl> .
