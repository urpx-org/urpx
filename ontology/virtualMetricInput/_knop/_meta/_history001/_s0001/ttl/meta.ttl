@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/virtualMetricInput/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/virtualMetricInput" ;
  sflo:hasWorkingKnopInventoryFile <ontology/virtualMetricInput/_knop/_inventory/inventory.ttl> .
