@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/VoltageLevelValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/VoltageLevelValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/VoltageLevelValue/_knop/_inventory/inventory.ttl> .
