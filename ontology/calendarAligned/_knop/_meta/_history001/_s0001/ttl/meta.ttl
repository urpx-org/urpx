@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/calendarAligned/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/calendarAligned" ;
  sflo:hasWorkingKnopInventoryFile <ontology/calendarAligned/_knop/_inventory/inventory.ttl> .
