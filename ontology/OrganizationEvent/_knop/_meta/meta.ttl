@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/OrganizationEvent/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/OrganizationEvent" ;
  sflo:hasWorkingKnopInventoryFile <ontology/OrganizationEvent/_knop/_inventory/inventory.ttl> .
