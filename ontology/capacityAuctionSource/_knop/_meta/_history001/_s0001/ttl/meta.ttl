@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/capacityAuctionSource/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/capacityAuctionSource" ;
  sflo:hasWorkingKnopInventoryFile <ontology/capacityAuctionSource/_knop/_inventory/inventory.ttl> .
