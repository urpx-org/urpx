@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/HighlyDynamicPricesDocument/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/HighlyDynamicPricesDocument" ;
  sflo:hasWorkingKnopInventoryFile <ontology/HighlyDynamicPricesDocument/_knop/_inventory/inventory.ttl> .
