@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ancillaryServices/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ancillaryServices" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ancillaryServices/_knop/_inventory/inventory.ttl> .
