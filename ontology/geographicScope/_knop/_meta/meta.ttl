@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/geographicScope/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/geographicScope" ;
  sflo:hasWorkingKnopInventoryFile <ontology/geographicScope/_knop/_inventory/inventory.ttl> .
