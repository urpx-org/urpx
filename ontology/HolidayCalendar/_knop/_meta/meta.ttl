@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/HolidayCalendar/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/HolidayCalendar" ;
  sflo:hasWorkingKnopInventoryFile <ontology/HolidayCalendar/_knop/_inventory/inventory.ttl> .
