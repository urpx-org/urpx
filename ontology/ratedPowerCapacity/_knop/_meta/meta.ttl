@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ratedPowerCapacity/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ratedPowerCapacity" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ratedPowerCapacity/_knop/_inventory/inventory.ttl> .
