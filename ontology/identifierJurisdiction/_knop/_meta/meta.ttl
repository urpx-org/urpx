@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/identifierJurisdiction/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/identifierJurisdiction" ;
  sflo:hasWorkingKnopInventoryFile <ontology/identifierJurisdiction/_knop/_inventory/inventory.ttl> .
