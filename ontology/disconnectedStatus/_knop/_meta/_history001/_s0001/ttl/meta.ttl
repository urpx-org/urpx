@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/disconnectedStatus/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/disconnectedStatus" ;
  sflo:hasWorkingKnopInventoryFile <ontology/disconnectedStatus/_knop/_inventory/inventory.ttl> .
