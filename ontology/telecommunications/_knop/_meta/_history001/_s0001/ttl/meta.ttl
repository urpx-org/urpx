@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/telecommunications/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/telecommunications" ;
  sflo:hasWorkingKnopInventoryFile <ontology/telecommunications/_knop/_inventory/inventory.ttl> .
