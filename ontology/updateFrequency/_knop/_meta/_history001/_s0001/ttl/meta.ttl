@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/updateFrequency/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/updateFrequency" ;
  sflo:hasWorkingKnopInventoryFile <ontology/updateFrequency/_knop/_inventory/inventory.ttl> .
