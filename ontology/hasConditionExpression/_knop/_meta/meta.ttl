@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasConditionExpression/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasConditionExpression" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasConditionExpression/_knop/_inventory/inventory.ttl> .
