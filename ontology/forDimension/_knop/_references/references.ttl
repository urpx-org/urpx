@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/forDimension> sflo:hasReferenceLink <ontology/forDimension/_knop/_references#reference001> .

<ontology/forDimension/_knop/_references#reference001> a sflo:ReferenceLink ;
  sflo:referenceLinkFor <ontology/forDimension> ;
  sflo:hasReferenceRole <https://semantic-flow.github.io/sflo/ontology/referenceRole_canonical> ;
  sflo:hasReferenceSource <ontology/forDimension/_knop/_references#reference001-source> .

<ontology/forDimension/_knop/_references#reference001-source> a sflo:ReferenceSource ;
  sflo:targetArtifact <ontology/shacl> ;
  sflo:targetHistoricalState <ontology/shacl/releases/v0.2.0> .
