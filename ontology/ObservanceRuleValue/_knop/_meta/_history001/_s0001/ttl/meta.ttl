@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ObservanceRuleValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ObservanceRuleValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ObservanceRuleValue/_knop/_inventory/inventory.ttl> .
