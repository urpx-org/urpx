@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/measurementKind/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/measurementKind" ;
  sflo:hasWorkingKnopInventoryFile <ontology/measurementKind/_knop/_inventory/inventory.ttl> .
