@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/dateTimeApproved/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/dateTimeApproved" ;
  sflo:hasWorkingKnopInventoryFile <ontology/dateTimeApproved/_knop/_inventory/inventory.ttl> .
