@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/metricInputType/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/metricInputType" ;
  sflo:hasWorkingKnopInventoryFile <ontology/metricInputType/_knop/_inventory/inventory.ttl> .
