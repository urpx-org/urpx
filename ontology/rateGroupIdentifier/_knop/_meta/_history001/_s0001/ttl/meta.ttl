@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/rateGroupIdentifier/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/rateGroupIdentifier" ;
  sflo:hasWorkingKnopInventoryFile <ontology/rateGroupIdentifier/_knop/_inventory/inventory.ttl> .
