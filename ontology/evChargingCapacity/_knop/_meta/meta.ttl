@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/evChargingCapacity/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/evChargingCapacity" ;
  sflo:hasWorkingKnopInventoryFile <ontology/evChargingCapacity/_knop/_inventory/inventory.ttl> .
