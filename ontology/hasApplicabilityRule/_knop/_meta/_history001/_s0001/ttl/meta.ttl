@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasApplicabilityRule/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasApplicabilityRule" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasApplicabilityRule/_knop/_inventory/inventory.ttl> .
