@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/changeReasonOther/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/changeReasonOther" ;
  sflo:hasWorkingKnopInventoryFile <ontology/changeReasonOther/_knop/_inventory/inventory.ttl> .
