@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/federalOwnership/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/federalOwnership" ;
  sflo:hasWorkingKnopInventoryFile <ontology/federalOwnership/_knop/_inventory/inventory.ttl> .
