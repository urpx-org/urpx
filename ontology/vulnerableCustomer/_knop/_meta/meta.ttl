@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/vulnerableCustomer/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/vulnerableCustomer" ;
  sflo:hasWorkingKnopInventoryFile <ontology/vulnerableCustomer/_knop/_inventory/inventory.ttl> .
