@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/MeasurementTypeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/MeasurementTypeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/MeasurementTypeValue/_knop/_inventory/inventory.ttl> .
