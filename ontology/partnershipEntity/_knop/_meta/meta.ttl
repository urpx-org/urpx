@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/partnershipEntity/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/partnershipEntity" ;
  sflo:hasWorkingKnopInventoryFile <ontology/partnershipEntity/_knop/_inventory/inventory.ttl> .
