@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/billingPeriodAligned/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/billingPeriodAligned" ;
  sflo:hasWorkingKnopInventoryFile <ontology/billingPeriodAligned/_knop/_inventory/inventory.ttl> .
