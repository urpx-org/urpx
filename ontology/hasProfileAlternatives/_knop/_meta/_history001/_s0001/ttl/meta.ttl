@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasProfileAlternatives/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasProfileAlternatives" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasProfileAlternatives/_knop/_inventory/inventory.ttl> .
