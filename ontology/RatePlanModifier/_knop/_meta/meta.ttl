@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/RatePlanModifier/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/RatePlanModifier" ;
  sflo:hasWorkingKnopInventoryFile <ontology/RatePlanModifier/_knop/_inventory/inventory.ttl> .
