@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/referencesProfileAlternative/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/referencesProfileAlternative" ;
  sflo:hasWorkingKnopInventoryFile <ontology/referencesProfileAlternative/_knop/_inventory/inventory.ttl> .
