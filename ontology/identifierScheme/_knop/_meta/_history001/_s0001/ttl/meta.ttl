@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/identifierScheme/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/identifierScheme" ;
  sflo:hasWorkingKnopInventoryFile <ontology/identifierScheme/_knop/_inventory/inventory.ttl> .
