@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ProfileAlternative/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ProfileAlternative" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ProfileAlternative/_knop/_inventory/inventory.ttl> .
