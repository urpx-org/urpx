@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/commercialPumping/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/commercialPumping" ;
  sflo:hasWorkingKnopInventoryFile <ontology/commercialPumping/_knop/_inventory/inventory.ttl> .
