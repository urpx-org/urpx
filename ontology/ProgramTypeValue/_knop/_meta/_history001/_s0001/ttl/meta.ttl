@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/ProgramTypeValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/ProgramTypeValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/ProgramTypeValue/_knop/_inventory/inventory.ttl> .
