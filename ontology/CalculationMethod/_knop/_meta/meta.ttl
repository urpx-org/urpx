@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/CalculationMethod/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/CalculationMethod" ;
  sflo:hasWorkingKnopInventoryFile <ontology/CalculationMethod/_knop/_inventory/inventory.ttl> .
