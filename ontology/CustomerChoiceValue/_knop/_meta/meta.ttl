@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/CustomerChoiceValue/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/CustomerChoiceValue" ;
  sflo:hasWorkingKnopInventoryFile <ontology/CustomerChoiceValue/_knop/_inventory/inventory.ttl> .
