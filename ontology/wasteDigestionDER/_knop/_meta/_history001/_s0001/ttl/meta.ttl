@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/wasteDigestionDER/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/wasteDigestionDER" ;
  sflo:hasWorkingKnopInventoryFile <ontology/wasteDigestionDER/_knop/_inventory/inventory.ttl> .
