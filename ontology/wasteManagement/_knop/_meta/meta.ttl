@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/wasteManagement/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/wasteManagement" ;
  sflo:hasWorkingKnopInventoryFile <ontology/wasteManagement/_knop/_inventory/inventory.ttl> .
