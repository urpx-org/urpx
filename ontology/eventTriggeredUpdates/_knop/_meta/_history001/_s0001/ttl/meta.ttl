@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/eventTriggeredUpdates/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/eventTriggeredUpdates" ;
  sflo:hasWorkingKnopInventoryFile <ontology/eventTriggeredUpdates/_knop/_inventory/inventory.ttl> .
