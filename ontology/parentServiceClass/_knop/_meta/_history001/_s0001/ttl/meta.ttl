@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/parentServiceClass/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/parentServiceClass" ;
  sflo:hasWorkingKnopInventoryFile <ontology/parentServiceClass/_knop/_inventory/inventory.ttl> .
