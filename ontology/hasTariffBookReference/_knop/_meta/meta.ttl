@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/hasTariffBookReference/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/hasTariffBookReference" ;
  sflo:hasWorkingKnopInventoryFile <ontology/hasTariffBookReference/_knop/_inventory/inventory.ttl> .
