@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/profileMetricInput/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/profileMetricInput" ;
  sflo:hasWorkingKnopInventoryFile <ontology/profileMetricInput/_knop/_inventory/inventory.ttl> .
