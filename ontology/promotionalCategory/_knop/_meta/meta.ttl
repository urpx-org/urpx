@base <https://urpx-org.github.io/urpx/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .

<ontology/promotionalCategory/_knop> a sflo:Knop ;
  sflo:designatorPath "ontology/promotionalCategory" ;
  sflo:hasWorkingKnopInventoryFile <ontology/promotionalCategory/_knop/_inventory/inventory.ttl> .
