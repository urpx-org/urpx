# Description: SHACL shapes for validating URPX data against the URPX Ontology.

@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix urpx: <https://urpx-org.github.io/urpx/ontology/> .
@prefix urpx-shacl: <https://urpx-org.github.io/urpx/ontology/shacl/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://urpx-org.github.io/urpx/ontology/shacl>
    a owl:Ontology, sh:ShapesGraph ;
    rdfs:label "URPX Ontology SHACL Shapes"@en ;
    dcterms:creator "Una Smithsimon, Klaar De Schepper, Flux Tailor LLC" ;
    dcterms:description "SHACL shapes for validating URPX data against the URPX Ontology." ;
    dcterms:license <http://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:modified "2026-07-12"^^xsd:date ;
    dcterms:title "URPX SHACL Shapes" ;
    dcterms:hasVersion <https://urpx-org.github.io/urpx/ontology/shacl/releases/v0.3.0> ;
    owl:versionIRI <https://github.com/urpx-org/urpx/raw/v0.3.0/shacl/urpx-shacl.ttl> .

<https://urpx-org.github.io/urpx/ontology/shacl/releases/v0.3.0>
    a owl:Ontology, sh:ShapesGraph ;
    dcterms:isVersionOf <https://urpx-org.github.io/urpx/ontology/shacl> ;
    dcterms:issued "2026-07-07"^^xsd:date ;
    dcat:version "0.3.0" ;
    dcat:distribution <https://urpx-org.github.io/urpx/ontology/shacl/releases/v0.3.0/ttl> .

<https://urpx-org.github.io/urpx/ontology/shacl/releases/v0.3.0/ttl>
    a dcat:Distribution ;
    dcat:downloadURL <https://github.com/urpx-org/urpx/raw/v0.3.0/shacl/urpx-shacl.ttl> ;
    dcat:downloadURL <https://urpx-org.github.io/urpx/ontology/shacl/releases/v0.3.0/ttl/urpx-shacl.ttl> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> .

# ============================================================================
# NODE SHAPES
# ============================================================================

urpx-shacl:AccountServiceAgreementShape
    a sh:NodeShape ;
    rdfs:label "AccountServiceAgreement Shape"@en ;
    sh:targetClass urpx:AccountServiceAgreement ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:contractEffectiveDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:contractExpirationDate ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

urpx-shacl:AlternativeDimensionShape
    a sh:NodeShape ;
    rdfs:label "AlternativeDimension Shape"@en ;
    sh:targetClass urpx:AlternativeDimension ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:dimensionDisplayName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:dimensionProperty ;
        sh:datatype xsd:anyURI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:customDimensionProperty ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:hasPossibleValues ;
        sh:node [ sh:property [ sh:path rdf:first ; sh:minCount 1 ] ] ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:referencesMetricInput ;
        sh:class urpx:MetricInput ;
        sh:minCount 0 ;
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path urpx:dimensionProperty ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:customDimensionProperty ;
                sh:maxCount 0 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:customDimensionProperty ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:dimensionProperty ;
                sh:maxCount 0 ;
            ]
        ]
    ) .

urpx-shacl:AlternativeDimensionsShape
    a sh:NodeShape ;
    rdfs:label "AlternativeDimensions Shape"@en ;
    sh:targetClass urpx:AlternativeDimensions ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:hasAlternativeDimension ;
        sh:class urpx:AlternativeDimension ;
        sh:minCount 1 ;
    ] .

