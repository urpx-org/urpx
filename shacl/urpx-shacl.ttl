urpx-shacl:ServiceBracketShape
    a sh:NodeShape ;
    rdfs:label "ServiceBracket Shape"@en ;
    sh:targetClass urpx:ServiceBracket ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:or (
        [
            sh:property [
                sh:path urpx:lowerBound ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:lowerBoundOperator ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:upperBound ;
                sh:maxCount 0 ;
            ] ;
            sh:property [
                sh:path urpx:upperBoundOperator ;
                sh:maxCount 0 ;
            ] ;
        ]
        [
            sh:property [
                sh:path urpx:lowerBound ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:lowerBoundOperator ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:upperBound ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:upperBoundOperator ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ]
        [
            sh:property [
                sh:path urpx:lowerBound ;
                sh:maxCount 0 ;
            ] ;
            sh:property [
                sh:path urpx:lowerBoundOperator ;
                sh:maxCount 0 ;
            ] ;
            sh:property [
                sh:path urpx:upperBound ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:upperBoundOperator ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
        ]
    ) ;
    sh:property [
        sh:path urpx:appliesInSeason ;
        sh:class urpx:Season ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:lowerBound ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:lowerBoundOperator ;
        sh:node urpx-shacl:OperatorValueShape ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:referencesProfileAlternative ;
        sh:class urpx:ProfileAlternative ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:upperBound ;
