urpx-shacl:BillingCycleShape
    a sh:NodeShape ;
    rdfs:label "BillingCycle Shape"@en ;
    sh:targetClass urpx:BillingCycle ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:cycleStartDay ;
        sh:datatype xsd:integer ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 31 ;
    ] ;
    sh:property [
        sh:path urpx:endDate ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
