        sh:class urpx:Ledger ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:hasPriceDefinition ;
        sh:class urpx:PriceDefinition ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:hasServiceTiers ;
        sh:class urpx:ServiceTiers ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:hasTOUSchedule ;
        sh:class urpx:TOUSchedule ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:prorationMethod ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

urpx-shacl:BooleanOperationNodeShape
    a sh:NodeShape ;
    rdfs:label "BooleanOperationNode Shape"@en ;
    sh:targetClass urpx:BooleanOperationNode ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:operator ;
        sh:node urpx-shacl:BooleanOperatorValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:logicExpression ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:description ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:operandNodes ;
        sh:or (
            [ sh:class urpx:ComparisonNode ]
            [ sh:class urpx:BooleanOperationNode ]
        ) ;
        sh:minCount 1 ;
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path urpx:operator ;
                sh:hasValue urpx:andOperator ;
            ] ;
            sh:property [
                sh:path urpx:operandNodes ;
                sh:minCount 2 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:operator ;
                sh:hasValue urpx:orOperator ;
            ] ;
            sh:property [
                sh:path urpx:operandNodes ;
                sh:minCount 2 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:operator ;
                sh:hasValue urpx:notOperator ;
            ] ;
            sh:property [
                sh:path urpx:operandNodes ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
    ) .

