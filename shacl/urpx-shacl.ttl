urpx-shacl:CustomOperandNodeShape
    a sh:NodeShape ;
    rdfs:label "CustomOperandNode Shape"@en ;
    sh:targetClass urpx:CustomOperandNode ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:customConditionProperty ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:booleanValue ;
        sh:datatype xsd:boolean ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:dateValue ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:dateTimeValue ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:decimalValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:durationValue ;
        sh:datatype xsd:duration ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:gMonthValue ;
        sh:datatype xsd:gMonth ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:gYearValue ;
        sh:datatype xsd:gYear ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:integerValue ;
        sh:datatype xsd:integer ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:referencesMetricInput ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:stringValue ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:timeValue ;
        sh:datatype xsd:time ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path urpx:customConditionProperty ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:referencesMetricInput ;
                sh:maxCount 0 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:booleanValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:referencesMetricInput ;
                sh:minCount 0 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:dateValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:referencesMetricInput ;
                sh:minCount 0 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:dateTimeValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:referencesMetricInput ;
                sh:minCount 0 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:decimalValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:referencesMetricInput ;
                sh:minCount 0 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:durationValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path urpx:referencesMetricInput ;
                sh:minCount 0 ;
                sh:maxCount 1 ;
            ]
