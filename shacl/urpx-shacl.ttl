urpx-shacl:SystemOperatorShape
    a sh:NodeShape ;
    rdfs:label "SystemOperator Shape"@en ;
    rdfs:comment "urpx:operatesIn is deliberately not listed although it is in-domain via Organization: operatesIn links an organization to the ISO/RTO markets it operates in, and a system operator operating in a system operator would be circular. The shape is closed, so instances carrying it do not validate."@en ;
    sh:targetClass urpx:SystemOperator ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:alternateName ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:commodity ;
        sh:node urpx-shacl:CommodityValueShape ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:hasIdentity ;
        sh:class urpx:OrganizationIdentity ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:hasLocationDataSet ;
        sh:class urpx:LocationDataSet ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:legalName ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:organizationType ;
        sh:node urpx-shacl:OrganizationTypeValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:publishes ;
        sh:class urpx:RatePlan ;
        sh:minCount 0 ;
    ] .

urpx-shacl:TariffFilingShape
    a sh:NodeShape ;
    rdfs:label "TariffFiling Shape"@en ;
    sh:targetClass urpx:TariffFiling ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:cancelledBy ;
        sh:or (
            [ sh:class urpx:TariffFiling ]
            [ sh:class urpx:SourcePublication ]
        ) ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:cancelledOn ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:cancelledOnDateTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
