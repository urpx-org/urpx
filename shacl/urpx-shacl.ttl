urpx-shacl:PricingModelShape
    a sh:NodeShape ;
    rdfs:label "PricingModel Shape"@en ;
    sh:targetClass urpx:PricingModel ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:confidence ;
        sh:node urpx-shacl:ConfidenceValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:referencesRatePlan ;
        sh:class urpx:RatePlan ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:referencesRatePlanModifier ;
        sh:class urpx:RatePlanModifier ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:hasPlanElements ;
        sh:class urpx:PlanElements ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:documentedBy ;
        sh:class urpx:DataSourceReference ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:withinPublication ;
        sh:class urpx:TariffFiling ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:pursuantTo ;
        sh:class urpx:GeneralRule ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:hasPrices ;
        sh:class urpx:Prices ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:supersedes ;
        sh:class urpx:PricingModel ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:replaces ;
        sh:class urpx:PricingModel ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:replacedBy ;
        sh:class urpx:PricingModel ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:cancelledBy ;
        sh:or (
            [ sh:class urpx:PricingModel ]
            [ sh:class urpx:SourcePublication ]
        ) ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:cancelledOn ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:cancelledOnDateTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:dateModified ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:dateTimeModified ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:hasGeneralRule ;
        sh:class urpx:GeneralRule ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:effectiveDate ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:description "Validity-window start for a pricing model that is not published within a tariff filing — for example competitive-supply, contract, or scenario pricing. When a pricing model is published within a tariff filing, its validity dates derive from that filing; where a filing and this date are both present, they describe the same window."@en ;
    ] ;
    sh:property [
        sh:path urpx:effectiveDateTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:description "Validity-window start, with dateTime precision, for a pricing model that is not published within a tariff filing — for example competitive-supply, contract, or scenario pricing. When a pricing model is published within a tariff filing, its validity dates derive from that filing; where a filing and this date are both present, they describe the same window."@en ;
    ] ;
    sh:property [
        sh:path urpx:expirationDate ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:description "Validity-window end for a pricing model that is not published within a tariff filing — for example competitive-supply, contract, or scenario pricing. When a pricing model is published within a tariff filing, its validity dates derive from that filing; where a filing and this date are both present, they describe the same window."@en ;
    ] ;
    sh:property [
        sh:path urpx:expirationDateTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:description "Validity-window end, with dateTime precision, for a pricing model that is not published within a tariff filing — for example competitive-supply, contract, or scenario pricing. When a pricing model is published within a tariff filing, its validity dates derive from that filing; where a filing and this date are both present, they describe the same window."@en ;
    ] ;
    sh:property [
        sh:path urpx:expectedEndDate ;
        sh:datatype xsd:date ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:description "Forecast end: provisional end date subject to change, as with pricing effective until further notice. Distinct from the validity-window end carried by expirationDate."@en ;
    ] ;
    sh:property [
        sh:path urpx:expectedEndDateTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:description "Forecast end with dateTime precision: provisional end subject to change, as with pricing effective until further notice. Distinct from the validity-window end carried by expirationDateTime."@en ;
    ] .

