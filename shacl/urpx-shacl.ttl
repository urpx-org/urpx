urpx-shacl:OrganizationShape
    a sh:NodeShape ;
    rdfs:label "Organization Shape"@en ;
    rdfs:comment "Deliberately left open (no sh:closed). Organization is the base class for EnergyServiceProvider, RegulatoryAuthority, SystemOperator, and UtilityOperator; those four shapes are closed and each lists the full property set. Closing this base shape would make every subclass instance fail on its subclass-specific properties, so it serves as a shared property-documentation and soft-validation target only."@en ;
    sh:targetClass urpx:Organization ;
    sh:property [
        sh:path urpx:alternateName ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:commodity ;
        sh:node urpx-shacl:CommodityValueShape ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:hasIdentity ;
        sh:class urpx:OrganizationIdentity ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:hasLocationDataSet ;
        sh:class urpx:LocationDataSet ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:legalName ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:operatesIn ;
        sh:class urpx:SystemOperator ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:organizationType ;
        sh:node urpx-shacl:OrganizationTypeValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:publishes ;
        sh:class urpx:RatePlan ;
        sh:minCount 0 ;
    ] .

