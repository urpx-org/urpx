# ============================================================================
# ENUMERATION VALUE SHAPES
# ============================================================================

urpx-shacl:AccumulationValueShape
    a sh:NodeShape ;
    rdfs:label "AccumulationValue Shape"@en ;
    sh:targetClass urpx:AccumulationValue ;
    sh:nodeKind sh:IRI ;
    sh:in ( urpx:delta urpx:bulk urpx:instantaneous urpx:summation ) .

urpx-shacl:AggregationMethodValueShape
    a sh:NodeShape ;
    rdfs:label "AggregationMethodValue Shape"@en ;
    sh:targetClass urpx:AggregationMethodValue ;
    sh:nodeKind sh:IRI ;
    sh:in ( urpx:sum urpx:average urpx:maximum urpx:minimum urpx:median ) .

urpx-shacl:AnnualIncomeRangeValueShape
    a sh:NodeShape ;
    rdfs:label "AnnualIncomeRangeValue Shape"@en ;
    sh:targetClass urpx:AnnualIncomeRangeValue ;
    sh:nodeKind sh:IRI ;
    sh:in ( urpx:highIncome urpx:lowIncome urpx:middleIncome urpx:moderateIncome urpx:veryLowIncome ) .

urpx-shacl:AssistanceEligibilityLevelValueShape
    a sh:NodeShape ;
    rdfs:label "AssistanceEligibilityLevelValue Shape"@en ;
    sh:targetClass urpx:AssistanceEligibilityLevelValue ;
    sh:nodeKind sh:IRI ;
    sh:in ( urpx:notQualifiedAssistance urpx:provisionallyQualifiedAssistance urpx:qualifiedAssistance urpx:underReviewAssistance ) .

