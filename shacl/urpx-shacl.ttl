urpx-shacl:PriceShape
    a sh:NodeShape ;
    rdfs:label "Price Shape"@en ;
    sh:targetClass urpx:Price ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:xone (
        [
            sh:property [
                sh:path urpx:amount ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:basePrice ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:basedOnPrice ;
                sh:minCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:currentPrice ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:unitPrice ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
    ) ;
    sh:property [
        sh:path urpx:adder ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:appliesInSeason ;
        sh:class urpx:Season ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path urpx:amount ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:basedOnPrice ;
        sh:or (
            [ sh:class urpx:Price ]
            [ sh:class urpx:PriceSummary ]
        ) ;
        sh:minCount 0 ;
    ] ;
    sh:property [
