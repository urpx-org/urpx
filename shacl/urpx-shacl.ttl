urpx-shacl:ScenarioShape
    a sh:NodeShape ;
    rdfs:label "Scenario Shape"@en ;
    sh:targetClass urpx:Scenario ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:or (
        [
            sh:property [
                sh:path urpx:hasCustomerProfile ;
                sh:minCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:hasServicePointProfile ;
                sh:minCount 1 ;
            ]
        ]
    ) ;
    sh:property [
        sh:path urpx:hasCustomerProfile ;
        sh:class urpx:CustomerProfile ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:hasServicePointProfile ;
        sh:class urpx:ServicePointProfile ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

