urpx-shacl:ObjectOperandNodeShape
    a sh:NodeShape ;
    rdfs:label "ObjectOperandNode Shape"@en ;
    sh:targetClass urpx:ObjectOperandNode ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:conditionProperty ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:referencesMetricInput ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:referencesValue ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:xone (
        [
            sh:property [
                sh:path urpx:conditionProperty ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:referencesValue ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path urpx:referencesMetricInput ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
    ) .

urpx-shacl:OperationNodeShape
    a sh:NodeShape ;
    rdfs:label "OperationNode Shape"@en ;
    sh:targetClass urpx:OperationNode ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type urpx:hasTemporalScope ) ;
    sh:property [
        sh:path urpx:leftOperand ;
        sh:or (
            [ sh:class urpx:DatatypeOperandNode ]
            [ sh:class urpx:ObjectOperandNode ]
            [ sh:class urpx:CustomOperandNode ]
            [ sh:class urpx:OperationNode ]
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:operator ;
        sh:node urpx-shacl:OperatorValueShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:rightOperand ;
        sh:or (
            [ sh:class urpx:DatatypeOperandNode ]
            [ sh:class urpx:ObjectOperandNode ]
            [ sh:class urpx:CustomOperandNode ]
            [ sh:class urpx:OperationNode ]
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path urpx:description ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

