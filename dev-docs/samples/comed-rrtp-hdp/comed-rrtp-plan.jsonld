          "urpx:name": "PJM day-ahead LMP plus retail adder",
          "urpx:description": "Synthetic test data supporting specification review; not for production use. Hourly supply price equals the PJM day-ahead LMP for the ComEd zone plus a fixed retail adder. The structured value expression is authoritative.",
          "urpx:hasValueExpression": {
            "@type": "urpx:ValueExpression",
            "urpx:name": "Hourly supply = wholesale price + retail adder",
            "urpx:rootNode": {
              "@type": "urpx:OperationNode",
              "urpx:operator": {
                "@id": "urpx:addOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "urpx:referencesMetricInput": {
