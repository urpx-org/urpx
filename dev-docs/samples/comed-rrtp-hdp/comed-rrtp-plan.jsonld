    {
      "@id": "comed:rrtp",
      "@type": "urpx:RatePlan",
      "urpx:name": "Residential Real-Time Pricing",
      "urpx:description": "Synthetic test data supporting specification review; not for production use. ComEd Residential Real-Time Pricing (RRTP): residential customers pay hourly supply prices set from the PJM day-ahead wholesale market price for the ComEd zone plus a fixed retail adder; delivery charges are fixed. Real-Time Pricing is the utility's name for this rate plan type.",
      "urpx:initialEffectiveDate": "2007-01-01",
      "urpx:timezoneIdentifier": "America/Chicago",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:url": "https://hourlypricing.comed.com/",
