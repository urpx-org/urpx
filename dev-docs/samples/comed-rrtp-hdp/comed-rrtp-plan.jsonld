        "@id": "comed:pd-hourly-energy-supply"
      },
      "urpx:startDate": "2026-01-01",
      "urpx:name": "Hourly energy supply price (day-ahead LMP + retail adder)",
      "urpx:description": "Synthetic test data supporting specification review; not for production use. The unit price shown is the fixed retail adder; the hourly wholesale component is externally sourced and added per the price update rule.",
