      "@id": "pge:b6-pdp",
      "@type": "urpx:RatePlan",
      "urpx:name": "Small General Time-of-Use Service with Peak Day Pricing",
      "urpx:description": "Synthetic test data supporting specification review; not for production use. PG&E Schedule B-6 small general time-of-use service with a Peak Day Pricing overlay: on event days, called day-ahead, the peak-period price is replaced by a higher critical peak price; non-event hours keep standard time-of-use pricing.",
      "urpx:initialEffectiveDate": "2021-03-01",
      "urpx:timezoneIdentifier": "America/Los_Angeles",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:url": "https://www.pge.com/tariffs/assets/pdf/tariffbook/ELEC_SCHEDS_B-6.pdf",
      "urpx:hasIdentifier": {
        "@id": "pge:b6-id-tariff-code",
