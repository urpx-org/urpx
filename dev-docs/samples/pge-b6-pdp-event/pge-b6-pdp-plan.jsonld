    },
    {
      "@id": "pge:price-b6-pdp-critical-peak-v2026-01-01",
      "@type": "urpx:Price",
      "urpx:referencesPriceDefinition": {
        "@id": "pge:pd-b6-pdp-critical-peak"
      },
      "urpx:startDate": "2026-01-01",
      "urpx:name": "Peak Day Pricing critical peak adder",
      "urpx:description": "Synthetic test data supporting specification review; not for production use. Applied during PDP event hours (14:00-18:00 local) on up to 15 event days per year.",
      "urpx:unitPrice": "1.20000",
      "urpx:hasDynamicPricing": {
        "@id": "pge:dp-pdp-event",
        "@type": "urpx:DynamicPricing",
        "urpx:dynamicPricingType": {
          "@id": "urpx:criticalPeakPricing"
        },
        "urpx:priceSource": {
          "@id": "urpx:wholesaleMarketSource"
        },
        "urpx:updateFrequency": {
          "@id": "urpx:eventTriggeredUpdates"
        },
        "urpx:priceCeiling": "1.50000",
        "urpx:priceFloor": "0.60000",
        "urpx:hasPriceUpdateRule": {
          "@id": "pge:pur-pdp-event-trigger",
          "@type": "urpx:PriceUpdateRule",
          "urpx:name": "PDP event day trigger rule",
          "urpx:description": "Synthetic test data supporting specification review; not for production use. The critical peak adder applies during event hours (14:00-18:00 local) on called event days; otherwise it is zero. Events are called by 14:00 the day before based on grid conditions.",
          "urpx:hasValueExpression": {
            "@type": "urpx:ValueExpression",
            "urpx:name": "Event adder applies only during a called event",
            "urpx:rootNode": {
              "@type": "urpx:ConditionalValueNode",
              "urpx:guard": {
                "@type": "urpx:ComparisonNode",
                "urpx:operator": {
                  "@id": "urpx:equalsOperator"
                },
                "urpx:leftOperand": {
                  "@type": "urpx:ObjectOperandNode",
                  "urpx:referencesMetricInput": {
                    "@id": "pge:mi-pdp-event-active"
                  }
                },
                "urpx:rightOperand": {
                  "@type": "urpx:DatatypeOperandNode",
                  "urpx:booleanValue": true
                }
              },
              "urpx:thenOperand": {
                "@type": "urpx:DatatypeOperandNode",
                "urpx:decimalValue": "1.20000"
              },
              "urpx:elseOperand": {
                "@type": "urpx:DatatypeOperandNode",
                "urpx:decimalValue": "0.00000"
              }
            }
          }
        },
        "urpx:hasDynamicPriceEndpoint": [
          {
            "@type": "urpx:DynamicPriceEndpoint",
            "urpx:name": "Peak Day Pricing program information",
            "urpx:url": "https://www.pge.com/en/account/rate-plans/hourly-flex-pricing.html",
            "urpx:endpointProtocol": {
              "@id": "urpx:otherProtocol"
            },
            "urpx:requiresAuthentication": false,
            "urpx:description": "Program information page; event notifications are delivered through the utility demand response channels, not a public price API."
          }
        ]
      }
    },
    {
      "@id": "pge:elig-b6",
      "@type": "urpx:EligibilityRule",
