// URPX Complete Ontology Poster
// Render: fdp -Tsvg urpx-ontology-poster.dot > urpx-ontology-poster.svg
//         fdp -Tpdf -Gsize=33,47 urpx-ontology-poster.dot > urpx-ontology-poster.pdf
// Fonts required: Archivo (title/headers), Roboto (body). Install before rendering.
// * labels denote proposed new properties not yet in the ontology.

digraph "URPX Ontology" {

    graph [
        rankdir=TB,
        size="33,47",
        ratio=fill,
        bgcolor="white",
        fontname="Archivo",
        fontsize=52,
        fontcolor="#00386e",
        label=<<FONT FACE="Archivo" POINT-SIZE="60"><B>URPX Ontology</B></FONT><BR/>
<FONT FACE="Archivo" POINT-SIZE="30">Complete Class &amp; Relationship Overview &#8212; v0.2.0</FONT><BR/>
<FONT FACE="Roboto" POINT-SIZE="18"><I>Dashed nodes = isolated (no connections in current ontology)   |   * edges = proposed properties   |   &#9632; = enum value</I></FONT>>,
        labelloc=t,
        pad=1.2,
        K=1.5,
        maxiter=2000,
        overlap=scale,
        splines=true,
        compound=true,
        sep="+10,10",
    ];

    node [
        fontname="Roboto",
        fontsize=10,
        style=filled,
        fontcolor="#1a365d",
        shape=ellipse,
        penwidth=2,
    ];

    edge [
        fontname="Roboto",
        fontsize=7,
        fontcolor="#555555",
        penwidth=1.2,
    ];

    // =========================================================
    // 1. CORE RATE PLAN ENTITIES
    // Paul Tol Blue pastel — #4477AA base
    // =========================================================
    subgraph cluster_core {
        label=<<FONT FACE="Archivo"><B>Core Rate Plan Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#2266AA";
        style=filled;
        bgcolor="#D4E8F8";
        color="#4477AA";
        penwidth=3;

        URPXDocument        [label="URPXDocument",          fillcolor="#A8CCF0", color="#2266AA"];
        RatePlan            [label="RatePlan",              fillcolor="#A8CCF0", color="#2266AA"];
        RatePlanVersion     [label="RatePlanVersion",       fillcolor="#A8CCF0", color="#2266AA"];
        RatePlanModifier    [label="RatePlanModifier",      fillcolor="#A8CCF0", color="#2266AA"];
        RatePlanModifierVersion [label="RatePlanModifier\nVersion", fillcolor="#A8CCF0", color="#2266AA"];
        AccountServiceAgreement [label="AccountService\nAgreement", fillcolor="#A8CCF0", color="#2266AA",
                                  style="filled,dashed", tooltip="No connections in current ontology"];
    }

    // =========================================================
    // 2. PRICING & ALTERNATIVES ENTITIES
    // Paul Tol Yellow pastel — #CCBB44 base
    // =========================================================
    subgraph cluster_pricing {
        label=<<FONT FACE="Archivo"><B>Pricing &amp; Alternatives Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#887722";
        style=filled;
        bgcolor="#EEEAD0";
        color="#CCBB44";
        penwidth=3;

        Prices                  [label="Prices",                fillcolor="#DDDAA0", color="#887722"];
        PriceSet                [label="PriceSet",              fillcolor="#DDDAA0", color="#887722"];
        PriceSetAlternatives    [label="PriceSet\nAlternatives", fillcolor="#DDDAA0", color="#887722"];
        PriceSetAlternative     [label="PriceSet\nAlternative",  fillcolor="#DDDAA0", color="#887722"];
        Price                   [label="Price",                 fillcolor="#DDDAA0", color="#887722"];
        PriceDefinition         [label="PriceDefinition",       fillcolor="#DDDAA0", color="#887722"];
        PriceSummary            [label="PriceSummary",          fillcolor="#DDDAA0", color="#887722"];
        PriceUpdateRule         [label="PriceUpdateRule",       fillcolor="#DDDAA0", color="#887722"];
        ApplicabilityConstraint [label="Applicability\nConstraint", fillcolor="#DDDAA0", color="#887722"];
        DimensionValuePair      [label="DimensionValue\nPair",  fillcolor="#DDDAA0", color="#887722"];
    }

    // =========================================================
    // 3. METRIC & MEASUREMENT ENTITIES
    // Paul Tol Cyan pastel — #66CCEE base
    // =========================================================
    subgraph cluster_metric {
        label=<<FONT FACE="Archivo"><B>Metric &amp; Measurement Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#226688";
        style=filled;
        bgcolor="#C8EEF8";
        color="#66CCEE";
        penwidth=3;

        MetricInput         [label="MetricInput",           fillcolor="#90D8EC", color="#226688"];
        MetricSpecification [label="MetricSpecification",   fillcolor="#90D8EC", color="#226688"];
        CalculationMethod   [label="CalculationMethod",     fillcolor="#90D8EC", color="#226688",
                              style="filled,dashed", tooltip="No connections in current ontology"];
    }

    // =========================================================
    // 4. PLAN ELEMENTS & BILLING ENTITIES
    // Paul Tol Green pastel — #228833 base
    // =========================================================
    subgraph cluster_plan {
        label=<<FONT FACE="Archivo"><B>Plan Elements &amp; Billing Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#226622";
        style=filled;
        bgcolor="#CCE8CC";
        color="#228833";
        penwidth=3;

        PlanElements [label="PlanElements", fillcolor="#99D0A0", color="#226622"];
        BillingModel [label="BillingModel", fillcolor="#99D0A0", color="#226622"];
        BillingCycle [label="BillingCycle", fillcolor="#99D0A0", color="#226622"];
        Ledger       [label="Ledger",       fillcolor="#99D0A0", color="#226622"];
        ServiceTiers [label="ServiceTiers", fillcolor="#99D0A0", color="#226622"];
        ServiceTier  [label="ServiceTier",  fillcolor="#99D0A0", color="#226622"];
    }

    // =========================================================
    // 5. TEMPORAL & SCHEDULING ENTITIES
    // Paul Tol Violet pastel — #AA3377 → violet shift
    // =========================================================
    subgraph cluster_temporal {
        label=<<FONT FACE="Archivo"><B>Temporal &amp; Scheduling Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#5544AA";
        style=filled;
        bgcolor="#E4DAFF";
        color="#7766CC";
        penwidth=3;

        Season          [label="Season",            fillcolor="#C0AAFE", color="#5544AA"];
        TOUSchedule     [label="TOUSchedule",       fillcolor="#C0AAFE", color="#5544AA"];
        TOUTier         [label="TOUTier",           fillcolor="#C0AAFE", color="#5544AA"];
        TOUPeriod       [label="TOUPeriod",         fillcolor="#C0AAFE", color="#5544AA"];
        TimeBracket     [label="TimeBracket",       fillcolor="#C0AAFE", color="#5544AA"];
        HolidayCalendar [label="HolidayCalendar",   fillcolor="#C0AAFE", color="#5544AA"];
        Holiday         [label="Holiday",           fillcolor="#C0AAFE", color="#5544AA"];
        LocationDataSet [label="LocationDataSet",   fillcolor="#C0AAFE", color="#5544AA"];
        DynamicPricing  [label="DynamicPricing",    fillcolor="#C0AAFE", color="#5544AA"];
    }

    // =========================================================
    // 6. CONDITION MODELING
    // Paul Tol Rose pastel — #EE6677 base
    // =========================================================
    subgraph cluster_condition {
        label=<<FONT FACE="Archivo"><B>Condition Modeling</B></FONT>>;
        fontsize=20;
        fontcolor="#AA2244";
        style=filled;
        bgcolor="#FFD8DC";
        color="#EE6677";
        penwidth=3;

        EligibilityRule   [label="EligibilityRule",   fillcolor="#FFAAAA", color="#AA2244"];
        ApplicabilityRule [label="ApplicabilityRule", fillcolor="#FFAAAA", color="#AA2244"];
        ApplicabilityGroup [label="ApplicabilityGroup", fillcolor="#FFAAAA", color="#AA2244"];
        Condition         [label="Condition",         fillcolor="#FFAAAA", color="#AA2244"];
    }

    // =========================================================
    // 7. CUSTOMER & SERVICE PROFILE ENTITIES
    // Paul Tol Purple pastel — #AA3377 base
    // =========================================================
    subgraph cluster_customer {
        label=<<FONT FACE="Archivo"><B>Customer &amp; Service Profile Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#7744AA";
        style=filled;
        bgcolor="#DDCCE8";
        color="#AA3377";
        penwidth=3;

        Profile                 [label="Profile",                   fillcolor="#C0A0D8", color="#7744AA",
                                  style="filled,dashed", tooltip="No connections in current ontology"];
        CustomerProfile         [label="CustomerProfile",           fillcolor="#C0A0D8", color="#7744AA"];
        ServicePointProfile     [label="ServicePointProfile",       fillcolor="#C0A0D8", color="#7744AA"];
        ProfileAlternative      [label="ProfileAlternative",        fillcolor="#C0A0D8", color="#7744AA"];
        ProfileAlternatives     [label="ProfileAlternatives",       fillcolor="#C0A0D8", color="#7744AA"];
        AlternativeDimension    [label="AlternativeDimension",      fillcolor="#C0A0D8", color="#7744AA"];
        AlternativeDimensions   [label="AlternativeDimensions",     fillcolor="#C0A0D8", color="#7744AA"];
        ServiceClass            [label="ServiceClass",              fillcolor="#C0A0D8", color="#7744AA"];
        RateGroup               [label="RateGroup",                 fillcolor="#C0A0D8", color="#7744AA"];
        ProgramEnrollment       [label="ProgramEnrollment",         fillcolor="#C0A0D8", color="#7744AA"];
        PriorRatePlan           [label="PriorRatePlan",             fillcolor="#C0A0D8", color="#7744AA"];
        DistributedEnergyResource [label="DistributedEnergy\nResource", fillcolor="#C0A0D8", color="#7744AA"];
    }

    // =========================================================
    // 8. ORGANIZATION ENTITIES
    // Paul Tol Slate Blue pastel
    // =========================================================
    subgraph cluster_org {
        label=<<FONT FACE="Archivo"><B>Organization Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#334466";
        style=filled;
        bgcolor="#C8D8E8";
        color="#556688";
        penwidth=3;

        Organization            [label="Organization",          fillcolor="#9CBCD8", color="#445588"];
        RegulatoryAuthority     [label="RegulatoryAuthority",   fillcolor="#9CBCD8", color="#445588"];
        SystemOperator          [label="SystemOperator",        fillcolor="#9CBCD8", color="#445588"];
        UtilityOperator         [label="UtilityOperator",       fillcolor="#9CBCD8", color="#445588",
                                  style="filled,dashed", tooltip="No connections in current ontology"];
        EnergyServiceProvider   [label="EnergyServiceProvider", fillcolor="#9CBCD8", color="#445588"];
        OrganizationEvent       [label="OrganizationEvent",     fillcolor="#9CBCD8", color="#445588",
                                  style="filled,dashed", tooltip="No connections in current ontology"];
        OrganizationIdentity    [label="OrganizationIdentity",  fillcolor="#9CBCD8", color="#445588"];
        OrganizationIdentifier  [label="OrganizationIdentifier", fillcolor="#9CBCD8", color="#445588"];
        OrganizationName        [label="OrganizationName",      fillcolor="#9CBCD8", color="#445588"];
        OrganizationTransition  [label="OrganizationTransition", fillcolor="#9CBCD8", color="#445588",
                                  style="filled,dashed", tooltip="No connections in current ontology"];
    }

    // =========================================================
    // 9. GEOGRAPHIC ENTITIES
    // Paul Tol Olive Green pastel
    // =========================================================
    subgraph cluster_geo {
        label=<<FONT FACE="Archivo"><B>Geographic Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#446633";
        style=filled;
        bgcolor="#DEEACC";
        color="#779944";
        penwidth=3;

        AdministrativeBoundary [label="Administrative\nBoundary", fillcolor="#C0D89A", color="#556633"];
        State                  [label="State",                    fillcolor="#C0D89A", color="#556633"];
        County                 [label="County",                   fillcolor="#C0D89A", color="#556633"];
        Municipality           [label="Municipality",             fillcolor="#C0D89A", color="#556633"];
        ServiceTerritory       [label="ServiceTerritory",         fillcolor="#C0D89A", color="#556633"];
    }

    // =========================================================
    // 10. DOCUMENT TYPE ENTITIES
    // Paul Tol Grey pastel
    // =========================================================
    subgraph cluster_doctype {
        label=<<FONT FACE="Archivo"><B>Document Type Entities</B></FONT>>;
        fontsize=20;
        fontcolor="#444444";
        style=filled;
        bgcolor="#E8E8E8";
        color="#888888";
        penwidth=3;

        TariffPublication           [label="TariffPublication",         fillcolor="#CCCCCC", color="#666666"];
        TariffBookDocument          [label="TariffBookDocument",         fillcolor="#CCCCCC", color="#666666"];
        TariffStatementDocument     [label="TariffStatementDocument",    fillcolor="#CCCCCC", color="#666666"];
        TariffSupplementDocument    [label="TariffSupplementDocument",   fillcolor="#CCCCCC", color="#666666"];
        TariffAddendumDocument      [label="TariffAddendumDocument",     fillcolor="#CCCCCC", color="#666666"];
        SupplyChargesDocument       [label="SupplyChargesDocument",      fillcolor="#CCCCCC", color="#666666"];
        HighlyDynamicPricesDocument [label="HighlyDynamicPrices\nDocument", fillcolor="#CCCCCC", color="#666666"];
        DERExportsDocument          [label="DERExportsDocument",         fillcolor="#CCCCCC", color="#666666"];
        DataSourceReference         [label="DataSourceReference",        fillcolor="#CCCCCC", color="#666666"];
        TariffBookReference         [label="TariffBookReference",        fillcolor="#CCCCCC", color="#666666"];
        TariffStatementReference    [label="TariffStatementReference",   fillcolor="#CCCCCC", color="#666666"];
    }

    // =========================================================
    // 11. CHARGETYPEVALUE ENUMERATION
    // Pale Gold — fans out at the edge of the poster
    // =========================================================
    subgraph cluster_enum_ctv {
        label=<<FONT FACE="Archivo"><B>ChargeTypeValue (Enumeration)</B></FONT>>;
        fontsize=20;
        fontcolor="#776600";
        style=filled;
        bgcolor="#FFF8CC";
        color="#CCAA00";
        penwidth=3;

        node [shape=box, fontname="Roboto", fontsize=8, style=filled, fontcolor="#554400", penwidth=1.5];

        ChargeTypeValue [label="ChargeTypeValue", fillcolor="#FFEE44", color="#886600",
                         fontsize=12, penwidth=3, shape=box];

        cat_adjustment    [label="Adjustment",     fillcolor="#FFE044", color="#886600", penwidth=2, fontsize=9];
        cat_aux           [label="Auxiliary\nCharge", fillcolor="#FFE044", color="#886600", penwidth=2, fontsize=9];
        cat_discount      [label="Discount",       fillcolor="#FFE044", color="#886600", penwidth=2, fontsize=9];
        cat_enviro        [label="Environmental",  fillcolor="#FFE044", color="#886600", penwidth=2, fontsize=9];
        cat_infra         [label="Infrastructure", fillcolor="#FFE044", color="#886600", penwidth=2, fontsize=9];
        cat_regulatory    [label="Regulatory",     fillcolor="#FFE044", color="#886600", penwidth=2, fontsize=9];
        cat_svc           [label="Service\nCharge", fillcolor="#FFE044", color="#886600", penwidth=2, fontsize=9];
        cat_taxes         [label="Taxes",          fillcolor="#FFE044", color="#886600", penwidth=2, fontsize=9];

        inst_adj1  [label="Adjustment\nPower Cost",     fillcolor="#FFFADD", color="#BBBB44"];
        inst_adj2  [label="Adjustment\nRenewable",      fillcolor="#FFFADD", color="#BBBB44"];
        inst_adj3  [label="Adjustment\nTariff",         fillcolor="#FFFADD", color="#BBBB44"];
        inst_adj4  [label="Recovery\nSurcharge",        fillcolor="#FFFADD", color="#BBBB44"];
        inst_adj5  [label="Tariff Rider",               fillcolor="#FFFADD", color="#BBBB44"];

        inst_aux1  [label="Ancillary\nServices",        fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux2  [label="Capacity",                   fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux3  [label="Capacity\nCharge",           fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux4  [label="Congestion\nCharge",         fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux5  [label="Distributed\nGeneration",    fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux6  [label="Donation",                   fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux7  [label="Energy Storage",             fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux8  [label="Generation",                 fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux9  [label="Power Factor",               fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux10 [label="Usage Charge",               fillcolor="#FFFADD", color="#BBBB44"];
        inst_aux11 [label="Volumetric\nCharge",         fillcolor="#FFFADD", color="#BBBB44"];

        inst_dis1  [label="Capital Credit",             fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis2  [label="Credit\nAdministrative",     fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis3  [label="Credit Energy",              fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis4  [label="Credit\nGeneration",         fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis5  [label="Credit\nInfrastructure",     fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis6  [label="Credit Misc",                fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis7  [label="Credit Price\nProtection",   fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis8  [label="Credit\nRenewable",          fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis9  [label="Credit Tariff\nRider",       fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis10 [label="Deposit Credit",             fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis11 [label="Deposit Interest",           fillcolor="#FFFADD", color="#BBBB44"];
        inst_dis12 [label="Heap Discount",              fillcolor="#FFFADD", color="#BBBB44"];

        inst_env1  [label="Conservation\nCharge",       fillcolor="#FFFADD", color="#BBBB44"];
        inst_env2  [label="Efficiency\nFunding",        fillcolor="#FFFADD", color="#BBBB44"];
        inst_env3  [label="Environmental\nFunding",     fillcolor="#FFFADD", color="#BBBB44"];
        inst_env4  [label="Renewable\nFunding",         fillcolor="#FFFADD", color="#BBBB44"];

        inst_inf1  [label="Delivery\nCharge",           fillcolor="#FFFADD", color="#BBBB44"];
        inst_inf2  [label="Demand Direct",              fillcolor="#FFFADD", color="#BBBB44"];
        inst_inf3  [label="Demand\nIndirect",           fillcolor="#FFFADD", color="#BBBB44"];
        inst_inf4  [label="Distribution\nCharge",       fillcolor="#FFFADD", color="#BBBB44"];
        inst_inf5  [label="Reliability\nCharge",        fillcolor="#FFFADD", color="#BBBB44"];
        inst_inf6  [label="Stranded Costs",             fillcolor="#FFFADD", color="#BBBB44"];
        inst_inf7  [label="Transmission",               fillcolor="#FFFADD", color="#BBBB44"];

        inst_reg1  [label="Compliance\nCharge",         fillcolor="#FFFADD", color="#BBBB44"];
        inst_reg2  [label="Demand Side\nManagement",    fillcolor="#FFFADD", color="#BBBB44"];
        inst_reg3  [label="Non-Bypassable\nCharge",     fillcolor="#FFFADD", color="#BBBB44"];
        inst_reg4  [label="Public Benefits",            fillcolor="#FFFADD", color="#BBBB44"];
        inst_reg5  [label="System Benefit\nCharge",     fillcolor="#FFFADD", color="#BBBB44"];
        inst_reg6  [label="Transition\nCharge",         fillcolor="#FFFADD", color="#BBBB44"];

        inst_sc1   [label="Contract Misc",              fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc2   [label="Deposit\nRequest",           fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc3   [label="Facilities",                 fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc4   [label="Handling",                   fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc5   [label="Initiation\nCharge",         fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc6   [label="Minimum Bill",               fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc7   [label="Minimum\nCharge",            fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc8   [label="Rental Fee",                 fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc9   [label="Service\nMetered",           fillcolor="#FFFADD", color="#BBBB44"];
        inst_sc10  [label="Service Non\nMetered",       fillcolor="#FFFADD", color="#BBBB44"];

        inst_tax1  [label="Tax\nAdjustment",            fillcolor="#FFFADD", color="#BBBB44"];
        inst_tax2  [label="Tax Credit",                 fillcolor="#FFFADD", color="#BBBB44"];
        inst_tax3  [label="Tax Misc",                   fillcolor="#FFFADD", color="#BBBB44"];
        inst_tax4  [label="Tax Municipal",              fillcolor="#FFFADD", color="#BBBB44"];
        inst_tax5  [label="Tax Sales",                  fillcolor="#FFFADD", color="#BBBB44"];
        inst_tax6  [label="Tax State",                  fillcolor="#FFFADD", color="#BBBB44"];
        inst_tax7  [label="Tax Utility",                fillcolor="#FFFADD", color="#BBBB44"];

        // Root → categories
        ChargeTypeValue -> cat_adjustment [color="#886600", penwidth=2];
        ChargeTypeValue -> cat_aux        [color="#886600", penwidth=2];
        ChargeTypeValue -> cat_discount   [color="#886600", penwidth=2];
        ChargeTypeValue -> cat_enviro     [color="#886600", penwidth=2];
        ChargeTypeValue -> cat_infra      [color="#886600", penwidth=2];
        ChargeTypeValue -> cat_regulatory [color="#886600", penwidth=2];
        ChargeTypeValue -> cat_svc        [color="#886600", penwidth=2];
        ChargeTypeValue -> cat_taxes      [color="#886600", penwidth=2];

        // Adjustment leaves
        cat_adjustment -> inst_adj1  [color="#BBBB44", penwidth=1];
        cat_adjustment -> inst_adj2  [color="#BBBB44", penwidth=1];
        cat_adjustment -> inst_adj3  [color="#BBBB44", penwidth=1];
        cat_adjustment -> inst_adj4  [color="#BBBB44", penwidth=1];
        cat_adjustment -> inst_adj5  [color="#BBBB44", penwidth=1];

        // Auxiliary Charge leaves
        cat_aux -> inst_aux1   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux2   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux3   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux4   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux5   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux6   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux7   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux8   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux9   [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux10  [color="#BBBB44", penwidth=1];
        cat_aux -> inst_aux11  [color="#BBBB44", penwidth=1];

        // Discount leaves
        cat_discount -> inst_dis1  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis2  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis3  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis4  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis5  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis6  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis7  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis8  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis9  [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis10 [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis11 [color="#BBBB44", penwidth=1];
        cat_discount -> inst_dis12 [color="#BBBB44", penwidth=1];

        // Environmental leaves
        cat_enviro -> inst_env1 [color="#BBBB44", penwidth=1];
        cat_enviro -> inst_env2 [color="#BBBB44", penwidth=1];
        cat_enviro -> inst_env3 [color="#BBBB44", penwidth=1];
        cat_enviro -> inst_env4 [color="#BBBB44", penwidth=1];

        // Infrastructure leaves
        cat_infra -> inst_inf1 [color="#BBBB44", penwidth=1];
        cat_infra -> inst_inf2 [color="#BBBB44", penwidth=1];
        cat_infra -> inst_inf3 [color="#BBBB44", penwidth=1];
        cat_infra -> inst_inf4 [color="#BBBB44", penwidth=1];
        cat_infra -> inst_inf5 [color="#BBBB44", penwidth=1];
        cat_infra -> inst_inf6 [color="#BBBB44", penwidth=1];
        cat_infra -> inst_inf7 [color="#BBBB44", penwidth=1];

        // Regulatory leaves
        cat_regulatory -> inst_reg1 [color="#BBBB44", penwidth=1];
        cat_regulatory -> inst_reg2 [color="#BBBB44", penwidth=1];
        cat_regulatory -> inst_reg3 [color="#BBBB44", penwidth=1];
        cat_regulatory -> inst_reg4 [color="#BBBB44", penwidth=1];
        cat_regulatory -> inst_reg5 [color="#BBBB44", penwidth=1];
        cat_regulatory -> inst_reg6 [color="#BBBB44", penwidth=1];

        // Service Charge leaves
        cat_svc -> inst_sc1  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc2  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc3  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc4  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc5  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc6  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc7  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc8  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc9  [color="#BBBB44", penwidth=1];
        cat_svc -> inst_sc10 [color="#BBBB44", penwidth=1];

        // Taxes leaves
        cat_taxes -> inst_tax1 [color="#BBBB44", penwidth=1];
        cat_taxes -> inst_tax2 [color="#BBBB44", penwidth=1];
        cat_taxes -> inst_tax3 [color="#BBBB44", penwidth=1];
        cat_taxes -> inst_tax4 [color="#BBBB44", penwidth=1];
        cat_taxes -> inst_tax5 [color="#BBBB44", penwidth=1];
        cat_taxes -> inst_tax6 [color="#BBBB44", penwidth=1];
        cat_taxes -> inst_tax7 [color="#BBBB44", penwidth=1];
    }

    // =========================================================
    // WITHIN-SECTION EDGES
    // =========================================================

    // --- Core Rate Plan ---
    URPXDocument     -> RatePlan                [label="hasRatePlan\n0..*",                  color="#2266AA", penwidth=1.8];
    URPXDocument     -> RatePlanModifier        [label="hasRatePlanModifier\n0..*",          color="#2266AA", penwidth=1.8];
    RatePlan         -> RatePlanVersion         [label="hasRatePlanVersion\n1..*",           color="#2266AA", penwidth=1.8];
    RatePlanModifier -> RatePlanModifierVersion [label="hasRatePlanModifierVersion\n1..*",   color="#2266AA", penwidth=1.8];

    // --- Pricing & Alternatives ---
    Prices               -> Price               [label="hasPrice\n0..*",                     color="#887722", penwidth=1.8];
    Prices               -> PriceSet            [label="hasPriceSet\n0..*",                  color="#887722", penwidth=1.8];
    Prices               -> PriceSetAlternatives [label="hasPriceSetAlternatives\n0..*",     color="#887722", penwidth=1.8];
    PriceSet             -> Price               [label="hasPrice\n1..*",                     color="#887722", penwidth=1.8];
    PriceSet             -> PriceSummary        [label="hasPriceSummary\n0..*",              color="#887722", penwidth=1.8];
    PriceSet             -> PriceDefinition     [label="referencesPriceDefinition\n0..1",    color="#887722", penwidth=1.8];
    PriceSetAlternatives -> PriceSetAlternative [label="hasPriceSetAlternative\n1..*",       color="#887722", penwidth=1.8];
    PriceSetAlternative  -> PriceSummary        [label="hasPriceSummary\n0..*",              color="#887722", penwidth=1.8];
    PriceSetAlternative  -> PriceDefinition     [label="referencesPriceDefinition\n0..1",    color="#887722", penwidth=1.8];
    Price                -> PriceDefinition     [label="referencesPriceDefinition\n0..1",    color="#887722", penwidth=1.8];

    // --- Metric & Measurement ---
    MetricInput -> MetricSpecification [label="hasMetricSpecification\n0..*", color="#226688", penwidth=1.8];

    // --- Plan Elements & Billing ---
    PlanElements -> BillingModel [label="hasBillingModel\n1..1",   color="#226622", penwidth=1.8];
    BillingModel -> Ledger       [label="hasLedger\n0..*",         color="#226622", penwidth=1.8];
    BillingModel -> ServiceTiers [label="hasServiceTiers\n0..*",   color="#226622", penwidth=1.8];
    Ledger       -> BillingCycle [label="hasBillingCycle\n0..1",   color="#226622", penwidth=1.8];
    ServiceTiers -> ServiceTier  [label="hasServiceTier\n1..*",    color="#226622", penwidth=1.8];

    // --- Temporal & Scheduling ---
    TOUSchedule     -> TOUTier          [label="hasTOUTier\n1..*",          color="#5544AA", penwidth=1.8];
    TOUSchedule     -> HolidayCalendar  [label="hasCalendar\n0..1",         color="#5544AA", penwidth=1.8];
    TOUTier         -> TOUPeriod        [label="hasTOUPeriod\n1..*",        color="#5544AA", penwidth=1.8];
    TOUPeriod       -> TimeBracket      [label="hasTimeBracket\n1..*",      color="#5544AA", penwidth=1.8];
    TimeBracket     -> Season           [label="appliesInSeason\n0..*",     color="#5544AA", penwidth=1.8];
    HolidayCalendar -> Holiday          [label="hasHoliday\n1..*",          color="#5544AA", penwidth=1.8];
    LocationDataSet -> HolidayCalendar  [label="hasHolidayCalendar\n0..*",  color="#5544AA", penwidth=1.8];

    // --- Condition Modeling ---
    EligibilityRule    -> Condition [label="hasCondition\n0..*", color="#AA2244", penwidth=1.8];
    ApplicabilityRule  -> Condition [label="hasCondition\n0..*", color="#AA2244", penwidth=1.8];

    // --- Customer & Service Profile ---
    CustomerProfile       -> PriorRatePlan           [label="hasPriorRatePlan\n0..*",           color="#7744AA", penwidth=1.8];
    CustomerProfile       -> ProgramEnrollment       [label="hasProgramEnrollment\n0..*",       color="#7744AA", penwidth=1.8];
    ServicePointProfile   -> DistributedEnergyResource [label="hasDistributedEnergyResource\n0..*", color="#7744AA", penwidth=1.8];
    ProfileAlternatives   -> ProfileAlternative      [label="hasProfileAlternative\n2..*",      color="#7744AA", penwidth=1.8];
    ProfileAlternatives   -> AlternativeDimensions   [label="hasAlternativeDimensions\n1..1",   color="#7744AA", penwidth=1.8];
    AlternativeDimensions -> AlternativeDimension    [label="hasAlternativeDimension\n1..*",    color="#7744AA", penwidth=1.8];
    ServiceClass          -> RateGroup               [label="hasRateGroup\n0..*",               color="#7744AA", penwidth=1.8];
    RateGroup             -> ServiceClass            [label="parentServiceClass\n0..1",         color="#7744AA", penwidth=1.8];

    // --- Organization ---
    Organization         -> OrganizationIdentity    [label="hasIdentity\n0..*",          color="#445588", penwidth=1.8];
    Organization         -> SystemOperator          [label="operatesIn\n0..*",           color="#445588", penwidth=1.8];
    RegulatoryAuthority  -> Organization            [label="hasJurisdictionOver\n0..*",  color="#445588", penwidth=1.8];
    RegulatoryAuthority  -> OrganizationIdentity    [label="hasIdentity\n0..*",          color="#445588", penwidth=1.8];
    RegulatoryAuthority  -> SystemOperator          [label="operatesIn\n0..*",           color="#445588", penwidth=1.8];
    SystemOperator       -> OrganizationIdentity    [label="hasIdentity\n0..*",          color="#445588", penwidth=1.8];
    EnergyServiceProvider -> OrganizationIdentity   [label="hasIdentity\n0..*",          color="#445588", penwidth=1.8];
    EnergyServiceProvider -> SystemOperator         [label="operatesIn\n0..*",           color="#445588", penwidth=1.8];
    OrganizationIdentity  -> OrganizationIdentifier [label="hasIdentifier\n0..*",        color="#445588", penwidth=1.8];
    OrganizationIdentity  -> OrganizationName       [label="hasName\n1..1",              color="#445588", penwidth=1.8];

    // --- Document Types ---
    TariffPublication           -> DataSourceReference       [label="hasDataSourceReference\n0..*", color="#666666", penwidth=1.8];
    TariffBookDocument          -> DataSourceReference       [label="hasDataSourceReference\n0..*", color="#666666", penwidth=1.8];
    TariffStatementDocument     -> DataSourceReference       [label="hasDataSourceReference\n0..*", color="#666666", penwidth=1.8];
    HighlyDynamicPricesDocument -> TariffPublication         [label="hasTariffPublication\n0..*",   color="#666666", penwidth=1.8];
    DERExportsDocument          -> TariffPublication         [label="hasTariffPublication\n0..*",   color="#666666", penwidth=1.8];
    DataSourceReference         -> TariffBookReference       [label="hasTariffBookReference\n0..*", color="#666666", penwidth=1.8];
    DataSourceReference         -> TariffStatementReference  [label="hasTariffStatementReference\n0..*", color="#666666", penwidth=1.8];

    // =========================================================
    // CROSS-SECTION EDGES  (dashed, #888888)
    // =========================================================

    // Core ↔ Plan Elements / Prices (suppressed in per-section diagrams; shown here)
    RatePlanVersion -> PlanElements [label="hasPlanElements\n1..1",  color="#888888", style=dashed, penwidth=1.5];
    RatePlanVersion -> Prices       [label="hasPrices\n0..1",        color="#888888", style=dashed, penwidth=1.5];

    // Plan Elements → Pricing  [KEY: Ledger→PriceDefinition, dashed per IDE note]
    Ledger       -> PriceDefinition     [label="hasPriceDefinition\n1..*",           color="#887722", style=dashed, penwidth=1.8];
    Ledger       -> MetricInput         [label="referencesMetricInput\n0..*",        color="#888888", style=dashed, penwidth=1.2];
    ServiceTiers -> MetricInput         [label="referencesMetricInput\n0..*",        color="#888888", style=dashed, penwidth=1.2];
    ServiceTiers -> ProfileAlternative  [label="referencesProfileAlternative\n0..1", color="#888888", style=dashed, penwidth=1.2];

    // Plan Elements → Temporal
    BillingModel -> TOUSchedule [label="hasTOUSchedule\n0..*", color="#888888", style=dashed, penwidth=1.2];

    // Temporal → Pricing
    DynamicPricing -> PriceUpdateRule [label="hasPriceUpdateRule\n0..*", color="#888888", style=dashed, penwidth=1.2];

    // Temporal → Metric / Customer
    TOUSchedule -> MetricInput         [label="referencesMetricInput\n1..*",         color="#888888", style=dashed, penwidth=1.2];
    TOUSchedule -> ProfileAlternative  [label="referencesProfileAlternative\n0..1",  color="#888888", style=dashed, penwidth=1.2];

    // Condition → Customer
    EligibilityRule -> CustomerProfile     [label="hasCustomerProfile\n0..*",     color="#888888", style=dashed, penwidth=1.2];
    EligibilityRule -> ServicePointProfile [label="hasServicePointProfile\n0..*", color="#888888", style=dashed, penwidth=1.2];
    EligibilityRule -> DataSourceReference [label="hasDataSourceReference\n0..*", color="#888888", style=dashed, penwidth=1.2];

    // Condition → Geographic
    ApplicabilityGroup -> State            [label="appliesInState\n0..*",            color="#888888", style=dashed, penwidth=1.2];
    ApplicabilityGroup -> County           [label="appliesInCounty\n0..*",           color="#888888", style=dashed, penwidth=1.2];
    ApplicabilityGroup -> Municipality     [label="appliesInMunicipality\n0..*",     color="#888888", style=dashed, penwidth=1.2];
    ApplicabilityGroup -> ServiceTerritory [label="appliesInServiceTerritory\n0..*", color="#888888", style=dashed, penwidth=1.2];

    // Condition → Pricing
    ApplicabilityGroup -> ApplicabilityConstraint [label="hasExclusionConstraint\n0..*", color="#888888", style=dashed, penwidth=1.2];
    ApplicabilityGroup -> ApplicabilityConstraint [label="hasInclusionConstraint\n0..*", color="#888888", style=dashed, penwidth=1.2];

    // Condition → Metric
    Condition -> MetricSpecification [label="hasMetricSpecification\n0..*", color="#888888", style=dashed, penwidth=1.2];
    Condition -> MetricInput         [label="referencesMetricInput\n0..*",  color="#888888", style=dashed, penwidth=1.2];

    // Customer → Core / Pricing / Metric
    PriorRatePlan       -> RatePlan        [label="referencesRatePlan\n0..1",       color="#888888", style=dashed, penwidth=1.2];
    ProfileAlternative  -> DimensionValuePair [label="hasDimensionValue\n1..*",     color="#888888", style=dashed, penwidth=1.2];
    AlternativeDimension -> MetricInput    [label="referencesMetricInput\n0..*",    color="#888888", style=dashed, penwidth=1.2];

    // Organization → Core / Temporal
    Organization          -> RatePlan        [label="publishes\n0..*",         color="#888888", style=dashed, penwidth=1.2];
    Organization          -> LocationDataSet [label="hasLocationDataSet\n0..*", color="#888888", style=dashed, penwidth=1.2];
    RegulatoryAuthority   -> RatePlan        [label="approves\n0..*",          color="#888888", style=dashed, penwidth=1.2];
    RegulatoryAuthority   -> LocationDataSet [label="hasLocationDataSet\n0..*", color="#888888", style=dashed, penwidth=1.2];
    SystemOperator        -> RatePlan        [label="publishes\n0..*",         color="#888888", style=dashed, penwidth=1.2];
    SystemOperator        -> LocationDataSet [label="hasLocationDataSet\n0..*", color="#888888", style=dashed, penwidth=1.2];
    EnergyServiceProvider -> RatePlan        [label="publishes\n0..*",         color="#888888", style=dashed, penwidth=1.2];
    EnergyServiceProvider -> LocationDataSet [label="hasLocationDataSet\n0..*", color="#888888", style=dashed, penwidth=1.2];

    // Document Types → Core / Pricing
    TariffPublication           -> RatePlan        [label="hasRatePlan\n0..*",         color="#888888", style=dashed, penwidth=1.2];
    TariffPublication           -> RatePlanModifier [label="hasRatePlanModifier\n0..*", color="#888888", style=dashed, penwidth=1.2];
    TariffBookDocument          -> RatePlan        [label="hasRatePlan\n0..*",         color="#888888", style=dashed, penwidth=1.2];
    TariffBookDocument          -> RatePlanModifier [label="hasRatePlanModifier\n0..*", color="#888888", style=dashed, penwidth=1.2];
    TariffStatementDocument     -> RatePlanModifier [label="hasRatePlanModifier\n0..*", color="#888888", style=dashed, penwidth=1.2];
    TariffStatementDocument     -> Prices           [label="hasPrices\n1..1",           color="#888888", style=dashed, penwidth=1.2];
    TariffSupplementDocument    -> Prices           [label="hasPrices\n1..1",           color="#888888", style=dashed, penwidth=1.2];
    TariffAddendumDocument      -> Prices           [label="hasPrices\n1..1",           color="#888888", style=dashed, penwidth=1.2];
    TariffAddendumDocument      -> RatePlanModifier [label="hasRatePlanModifier\n0..*", color="#888888", style=dashed, penwidth=1.2];
    SupplyChargesDocument       -> Prices           [label="hasPrices\n1..1",           color="#888888", style=dashed, penwidth=1.2];
    HighlyDynamicPricesDocument -> RatePlan         [label="hasRatePlan\n0..*",         color="#888888", style=dashed, penwidth=1.2];
    HighlyDynamicPricesDocument -> RatePlanModifier [label="hasRatePlanModifier\n0..*", color="#888888", style=dashed, penwidth=1.2];
    DERExportsDocument          -> RatePlan         [label="hasRatePlan\n0..*",         color="#888888", style=dashed, penwidth=1.2];
    DERExportsDocument          -> RatePlanModifier [label="hasRatePlanModifier\n0..*", color="#888888", style=dashed, penwidth=1.2];

    // Pricing → Enum
    PriceDefinition -> ChargeTypeValue [label="chargeType\n0..*", color="#887722", style=dashed, penwidth=1.5];

    // =========================================================
    // PROPOSED EDGES  (* = not yet in ontology)
    // Lighter grey dashes. Connects isolated nodes to the graph.
    // =========================================================

    // AccountServiceAgreement — proposed: RatePlanVersion holds agreements
    RatePlanVersion -> AccountServiceAgreement [
        label="hasAccountServiceAgreement *\n0..*",
        color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"
    ];

    // Profile — proposed: superclass of CustomerProfile + ServicePointProfile
    Profile -> CustomerProfile      [label="subClassOf *", color="#BBBBBB", style=dashed, penwidth=1.2,
                                     fontcolor="#999999", arrowhead=onormal];
    Profile -> ServicePointProfile  [label="subClassOf *", color="#BBBBBB", style=dashed, penwidth=1.2,
                                     fontcolor="#999999", arrowhead=onormal];

    // CalculationMethod — proposed: MetricSpecification specifies calculation
    MetricSpecification -> CalculationMethod [
        label="hasCalculationMethod *\n0..*",
        color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"
    ];

    // Geographic hierarchy — proposed: all currently unconnected within-section
    AdministrativeBoundary -> State        [label="contains *\n0..*", color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];
    AdministrativeBoundary -> County       [label="contains *\n0..*", color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];
    AdministrativeBoundary -> Municipality [label="contains *\n0..*", color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];
    ServiceTerritory -> AdministrativeBoundary [label="coveredBy *\n0..*", color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];

    // Organization lonely nodes — proposed
    UtilityOperator    -> OrganizationIdentity [label="hasIdentity *\n0..*",         color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];
    UtilityOperator    -> LocationDataSet      [label="hasLocationDataSet *\n0..*",  color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];
    UtilityOperator    -> RatePlan             [label="publishes *\n0..*",           color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];
    Organization       -> OrganizationEvent    [label="hasOrganizationEvent *\n0..*", color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];
    OrganizationEvent  -> OrganizationTransition [label="resultsIn *\n0..*",         color="#BBBBBB", style=dashed, penwidth=1.2, fontcolor="#999999"];

    // =========================================================
    // LEGEND
    // =========================================================
    subgraph cluster_legend {
        label=<<FONT FACE="Archivo"><B>Legend</B></FONT>>;
        fontsize=18;
        fontcolor="#333333";
        style=filled;
        bgcolor="#FAFAFA";
        color="#CCCCCC";
        penwidth=2;
        margin=20;

        node [fontname="Roboto", fontsize=9, style=filled, fontcolor="#333333"];

        leg_class  [label="OWL Class",             shape=ellipse, fillcolor="#CCDDEE", color="#445566", penwidth=2];
        leg_lonely [label="Isolated class\n(no edges yet)",  shape=ellipse, fillcolor="#CCDDEE", color="#445566", penwidth=2, style="filled,dashed"];
        leg_enum   [label="■ Enum value",           shape=box,     fillcolor="#FFFADD", color="#BBBB44", penwidth=1.5];
        leg_cat    [label="■ Enum category",        shape=box,     fillcolor="#FFE044", color="#886600", penwidth=2];

        leg_s1 [shape=point, width=0.01, label=""];
        leg_t1 [shape=point, width=0.01, label=""];
        leg_s1 -> leg_t1 [label="  object property (within section)",    color="#445588", penwidth=1.8, fontname="Roboto", fontsize=8];

        leg_s2 [shape=point, width=0.01, label=""];
        leg_t2 [shape=point, width=0.01, label=""];
        leg_s2 -> leg_t2 [label="  cross-section reference",             color="#888888", style=dashed, penwidth=1.2, fontname="Roboto", fontsize=8];

        leg_s3 [shape=point, width=0.01, label=""];
        leg_t3 [shape=point, width=0.01, label=""];
        leg_s3 -> leg_t3 [label="  proposed new property * (not in ontology)", color="#BBBBBB", style=dashed, penwidth=1.2, fontname="Roboto", fontsize=8];

        leg_note [shape=plaintext, fontname="Roboto", fontsize=9, fontcolor="#666666",
                  label="Section colors from Paul Tol v2.7 palette (colorblind-safe, no orange).\nDashed nodes appear in the data dictionary but have no\nontology connections in the current v0.2.0 release.\n* Proposed properties are editorial suggestions only."];
    }

}
