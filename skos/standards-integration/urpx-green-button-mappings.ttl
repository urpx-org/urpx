@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix urpx: <https://schema.urpx.org/> .
@prefix gb: <http://naesb.org/espi#> .

<https://schema.urpx.org/mapping/green-button> 
    a owl:Ontology ;
    rdfs:label "URPX to Green Button Mappings"@en ;
    dcterms:title "URPX - Green Button ESPI Integration" ;
    dcterms:description "SKOS alignment between URPX Ontology and Green Button (NAESB ESPI) standard."@en ;
    dcterms:created "2026-01-27"^^xsd:date ;
    dcterms:modified "2026-01-27"^^xsd:date ;
    owl:versionInfo "0.1.1" .

# ============================================
# GBC Structural Extensions
# ============================================

urpx:RatePlan skos:relatedMatch gb:PricingStructure ;
    skos:note "URPX RatePlan URL serves as the resolvable URI for the ESPI PricingStructure hook."@en .

urpx:Price skos:broadMatch gb:LineItem ;
    skos:note "URPX procedural prices map to static ESPI bill line items."@en .

# ============================================
# Green Button ServiceCategory Mappings
# ============================================

gb:ServiceCategory_Electricity a skos:Concept ;
    skos:prefLabel "Electricity"@en ;
    skos:notation "0" ;
    skos:exactMatch urpx:electricity .

gb:ServiceCategory_Gas a skos:Concept ;
    skos:prefLabel "Natural Gas"@en ;
    skos:notation "1" ;
    skos:exactMatch urpx:naturalGas .

gb:ServiceCategory_Water a skos:Concept ;
    skos:prefLabel "Water"@en ;
    skos:notation "2" ;
    skos:exactMatch urpx:water .

gb:ServiceCategory_Heat a skos:Concept ;
    skos:prefLabel "Heat"@en ;
    skos:notation "4" ;
    skos:exactMatch urpx:steam .

# ============================================
# Green Button KindCategory Mappings
# ============================================

gb:KindCategory_Access a skos:Concept ;
    skos:prefLabel "Access Charge"@en ;
    skos:notation "1" ;
    skos:exactMatch urpx:minimumCharge ;
    skos:note "Access charge maps to URPX minimumCharge."@en .

gb:KindCategory_Demand a skos:Concept ;
    skos:prefLabel "Demand"@en ;
    skos:notation "2" ;
    skos:exactMatch urpx:demandDirect ;
    skos:note "Demand charge maps to URPX demandDirect."@en .

gb:KindCategory_Energy a skos:Concept ;
    skos:prefLabel "Energy"@en ;
    skos:notation "3" ;
    skos:exactMatch urpx:usageCharge ;
    skos:note "Energy charge maps to URPX usageCharge."@en .

gb:KindCategory_FixedCharge a skos:Concept ;
    skos:prefLabel "Fixed Charge"@en ;
    skos:notation "4" ;
    skos:closeMatch urpx:serviceMetered, urpx:minimumCharge ;
    skos:note "Fixed charge maps to URPX serviceMetered or minimumCharge."@en .

gb:KindCategory_Tax a skos:Concept ;
    skos:prefLabel "Tax"@en ;
    skos:notation "5" ;
    skos:exactMatch urpx:taxes ;
    skos:note "Tax category maps directly to urpx:taxes."@en .

gb:KindCategory_Fee a skos:Concept ;
    skos:prefLabel "Fee"@en ;
    skos:notation "6" ;
    skos:closeMatch urpx:rentalFee, urpx:initiationCharge, urpx:handling ;
    skos:note "Fee category maps to various URPX auxiliary fees."@en .

gb:KindCategory_Rebate a skos:Concept ;
    skos:prefLabel "Rebate"@en ;
    skos:notation "7" ;
    skos:exactMatch urpx:discount ;
    skos:note "Rebate maps to URPX discount category."@en .

gb:KindCategory_GenerationCredit a skos:Concept ;
    skos:prefLabel "Generation Credit"@en ;
    skos:notation "8" ;
    skos:exactMatch urpx:creditGeneration ;
    skos:note "Generation credit maps to URPX creditGeneration."@en .

gb:KindCategory_Other a skos:Concept ;
    skos:prefLabel "Other"@en ;
    skos:notation "9" ;
    skos:closeMatch urpx:contractMisc, urpx:ancillaryServices ;
    skos:note "Other category maps to miscellaneous URPX charges."@en .

# ============================================
# Green Button ItemKind Mappings
# ============================================

gb:itemKind_energy a skos:Concept ;
    skos:exactMatch urpx:usageCharge .

gb:itemKind_demand a skos:Concept ;
    skos:exactMatch urpx:demandDirect .

gb:itemKind_service a skos:Concept ;
    skos:exactMatch urpx:serviceMetered .

gb:itemKind_tax a skos:Concept ;
    skos:exactMatch urpx:taxSales .

gb:itemKind_adjustment a skos:Concept ;
    skos:exactMatch urpx:adjustmentPowerCost .

# ============================================
# URPX to Green Button Reverse Alignment (Informational)
# ============================================

urpx:serviceCharge skos:closeMatch gb:KindCategory_Access, gb:KindCategory_FixedCharge .
urpx:taxes skos:exactMatch gb:KindCategory_Tax .
urpx:auxiliaryCharge skos:closeMatch gb:KindCategory_Energy, gb:KindCategory_Demand, gb:KindCategory_Fee, gb:KindCategory_Other .
urpx:discount skos:closeMatch gb:KindCategory_Rebate, gb:KindCategory_GenerationCredit .
