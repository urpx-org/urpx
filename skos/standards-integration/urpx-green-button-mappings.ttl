@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix urpx: <https://urpx.org/ns/ontology/> .
@prefix gb: <http://naesb.org/espi#> .

<https://urpx.org/ns/ontology/mapping/green-button>
    a owl:Ontology ;
    rdfs:label "URPX to Green Button Mappings"@en ;
    dcterms:title "URPX - Green Button ESPI Integration" ;
    dcterms:description "SKOS alignment between URPX and the Green Button (NAESB ESPI) standard, verified against the NAESB ESPI V4 schemas."@en ;
    dcterms:created "2026-01-27"^^xsd:date ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    dcterms:conformsTo <https://urpx.org/ns/ontology/releases/v0.3.0> ;
    rdfs:seeAlso <https://urpx.org/ns/ontology> ;
    owl:versionInfo "0.3.0" ;
    rdfs:comment "Draft alignment, under working-group review. The matches below are a work in progress and are not a published mapping profile."@en .

# ============================================
# Structural anchors (confirmed in ESPI V4)
# ============================================

urpx:RatePlan skos:relatedMatch gb:PricingStructure ;
    skos:note "The RatePlan URL is the resolvable URI for the ESPI PricingStructure hook. The rate plan is the identity a customer is on; its pricing content is carried by pricing models consolidated into versions."@en .

urpx:PriceSummary skos:closeMatch gb:LineItem ;
    skos:note "A Green Button bill line item is typically a summary of several URPX prices. PriceSummary aggregates prices into the subtotal presented as one bill line item, which is how URPX prices line up against a real bill."@en .

urpx:Price skos:broadMatch gb:LineItem ;
    skos:note "An individual URPX price is finer-grained than a Green Button bill line item; several prices roll up into one line item via PriceSummary."@en .

# ============================================
# ServiceCategory (ESPI V4 ServiceKind codes)
# ============================================

gb:ServiceCategory_Electricity a skos:Concept ;
    skos:prefLabel "Electricity"@en ;
    skos:notation "0" ;
    skos:exactMatch urpx:electricity .

gb:ServiceCategory_Gas a skos:Concept ;
    skos:prefLabel "Natural Gas"@en ;
    skos:notation "1" ;
    skos:exactMatch urpx:naturalGas .

gb:ServiceCategory_Water a skos:Concept ;
    skos:prefLabel "Water"@en ;
    skos:notation "2" ;
    skos:exactMatch urpx:water .

gb:ServiceCategory_Heat a skos:Concept ;
    skos:prefLabel "Heat"@en ;
    skos:notation "4" ;
    skos:exactMatch urpx:steam .

# ============================================
# Line Item Alignment — ESPI V4 ItemKind to URPX charge category
# (LineItem/itemKind; espi_v4.xsd ItemKind simple type)
# A Green Button bill line item is a summarized unit; it lines up with an URPX charge category rather than a single fine-grained charge type. Payment (9) and Information (10) carry no charge and are outside this alignment.
# ============================================

gb:ItemKind_EnergyGenerationFee a skos:Concept ;
    skos:prefLabel "Energy Generation Fee"@en ;
    skos:notation "1" ;
    skos:closeMatch urpx:auxiliaryCharge .

gb:ItemKind_EnergyDeliveryFee a skos:Concept ;
    skos:prefLabel "Energy Delivery Fee"@en ;
    skos:notation "2" ;
    skos:closeMatch urpx:infrastructure .

gb:ItemKind_EnergyUsageFee a skos:Concept ;
    skos:prefLabel "Energy Usage Fee"@en ;
    skos:notation "3" ;
    skos:closeMatch urpx:auxiliaryCharge .

gb:ItemKind_AdministrativeFee a skos:Concept ;
    skos:prefLabel "Administrative Fee"@en ;
    skos:notation "4" ;
    skos:closeMatch urpx:serviceCharge .

gb:ItemKind_Tax a skos:Concept ;
    skos:prefLabel "Tax"@en ;
    skos:notation "5" ;
    skos:closeMatch urpx:taxes .

gb:ItemKind_EnergyGenerationCredit a skos:Concept ;
    skos:prefLabel "Energy Generation Credit"@en ;
    skos:notation "6" ;
    skos:closeMatch urpx:discount .

gb:ItemKind_EnergyDeliveryCredit a skos:Concept ;
    skos:prefLabel "Energy Delivery Credit"@en ;
    skos:notation "7" ;
    skos:closeMatch urpx:discount .

gb:ItemKind_AdministrativeCredit a skos:Concept ;
    skos:prefLabel "Administrative Credit"@en ;
    skos:notation "8" ;
    skos:closeMatch urpx:discount .

# ============================================
# Tariff riders (ESPI V4 TariffRiderRefs)
# ============================================

gb:TariffRiderRefs a skos:Concept ;
    skos:prefLabel "Tariff Rider References"@en ;
    skos:note "A retail structure: a list of TariffRiderRef entries (riderType, enrollmentStatus, effectiveDate) carried on a usage summary or service delivery point."@en .

# TariffRiderRef's enrollmentStatus is a three-member enum; URPX's EnrollmentStatusValue carries six. The three pairings below are the ones with a direct counterpart, left as skos:closeMatch; URPX's remaining states (expired, suspended, terminated) are not forced onto this enum. Scoped to the rider EnrollmentStatus used inside TariffRiderRef — customer_v4.xsd defines a separate, same-named EnrollmentStatus for Demand Response program enrollment that is out of scope here.

gb:EnrollmentStatus_Enrolled a skos:Concept ;
    skos:prefLabel "Enrolled"@en ;
    skos:notation "enrolled" ;
    skos:closeMatch urpx:activeStatus .

gb:EnrollmentStatus_Unenrolled a skos:Concept ;
    skos:prefLabel "Unenrolled"@en ;
    skos:notation "unenrolled" ;
    skos:closeMatch urpx:inactiveStatus .

gb:EnrollmentStatus_EnrolledPending a skos:Concept ;
    skos:prefLabel "Enrolled Pending"@en ;
    skos:notation "enrolledPending" ;
    skos:closeMatch urpx:pendingStatus .

# ============================================
# tariffProfile (ESPI V4 UsageSummary / ServiceDeliveryPoint)
# ============================================

gb:tariffProfile a skos:Concept ;
    skos:prefLabel "Tariff Profile"@en ;
    skos:closeMatch urpx:name ;
    skos:note "tariffProfile carries the name of a rate plan. The alignment to urpx:name holds where urpx:name is the name of a RatePlan; urpx:name is a general-purpose label across the vocabulary, so this mapping is scoped to its use on a RatePlan. tariffProfile is a String256 value, capped at 256 characters and carrying no identifier scheme or uniqueness constraint, so resolving a tariffProfile string to a specific rate plan by name alone needs a disambiguating key such as utility, service territory, or effective window. urpx:RatePlanIdentifier is the better fit only if a producer profile or a Green Button Alliance restriction declares tariffProfile a coded identifier; RatePlanIdentifierShape requires exactly one skos:notation and one scheme IRI, which a free String256 cannot supply on its own, so no identifier alignment is recorded here absent that condition."@en .
