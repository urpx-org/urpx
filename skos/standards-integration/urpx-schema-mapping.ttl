@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix urpx: <https://urpx.org/ns/ontology/> .
@prefix schema: <http://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://urpx.org/ns/ontology/mapping/schema-org> a owl:Ontology ;
    rdfs:label "URPX to Schema.org SKOS Mapping"@en ;
    owl:imports <https://urpx.org/ns/ontology> .

# ============================================
# PROPERTY MAPPINGS (URPX -> Schema.org)
# ============================================
# Note: URPX properties are typically more constrained than the broad schema.org properties they map to.

urpx:startDate skos:broadMatch schema:startDate .
urpx:startDateTime skos:broadMatch schema:startDate .
urpx:endDate skos:broadMatch schema:endDate .
urpx:endDateTime skos:broadMatch schema:endDate .

urpx:priceCurrency skos:broadMatch schema:priceCurrency .
urpx:description skos:broadMatch schema:description .
urpx:name skos:broadMatch schema:name .
urpx:url skos:broadMatch schema:url .
urpx:version skos:broadMatch schema:version .
urpx:timeZone skos:broadMatch schema:timeZone .
urpx:datePublished skos:broadMatch schema:datePublished .
urpx:legalName skos:broadMatch schema:legalName .
