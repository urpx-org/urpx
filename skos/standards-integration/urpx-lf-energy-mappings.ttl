@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix urpx: <https://urpx.org/ns/ontology/> .
@prefix lfe: <https://lfenergy.org/cds/> .

<https://urpx.org/ns/ontology/mapping/lf-energy> 
    a owl:Ontology ;
    rdfs:label "URPX to LF Energy CDS Mappings"@en ;
    dcterms:title "URPX - LF Energy CDS Integration" ;
    dcterms:description "SKOS alignment between URPX Ontology and LF Energy Customer Data Specification (CDS)."@en ;
    dcterms:created "2026-01-27"^^xsd:date ;
    dcterms:modified "2026-09-17"^^xsd:date ;
    owl:versionInfo "0.1.1" ;
    rdfs:comment "Draft alignment, under working-group review. The matches below are a work in progress and are not a published mapping profile."@en .

# ============================================
# LF Energy LineItemKind Mappings
# ============================================

lfe:RegularCharge a skos:Concept ;
    skos:prefLabel "Regular Charge"@en ;
    skos:closeMatch urpx:serviceCharge, urpx:auxiliaryCharge, urpx:infrastructure ;
    skos:note "Standard utility charges map to multiple URPX categories depending on context."@en .

lfe:Tax a skos:Concept ;
    skos:prefLabel "Tax"@en ;
    skos:exactMatch urpx:taxes ;
    skos:note "Maps directly to urpx:taxes category."@en .

lfe:Surcharge a skos:Concept ;
    skos:prefLabel "Surcharge"@en ;
    skos:closeMatch urpx:adjustment, urpx:regulatory, urpx:environmental ;
    skos:note "Additional charges/adjustments map to URPX adjustment, regulatory, or environmental categories."@en .

lfe:Discount a skos:Concept ;
    skos:prefLabel "Discount"@en ;
    skos:exactMatch urpx:discount ;
    skos:note "Maps directly to urpx:discount category."@en .

lfe:Credit a skos:Concept ;
    skos:prefLabel "Credit"@en ;
    skos:exactMatch urpx:discount ;
    skos:note "Credits map to urpx:discount category in URPX (which includes credits)."@en .

# ============================================
# LF Energy ChargeType Mappings
# ============================================

lfe:BaseCharge a skos:Concept ;
    skos:prefLabel "Base Charge"@en ;
    skos:exactMatch urpx:minimumCharge ;
    skos:note "Basic monthly service charge maps to URPX minimumCharge."@en .

lfe:ConsumptionCharge a skos:Concept ;
    skos:prefLabel "Consumption Charge"@en ;
    skos:exactMatch urpx:usageCharge ;
    skos:note "Usage-based energy charges map to URPX usageCharge."@en .

lfe:DemandCharge a skos:Concept ;
    skos:prefLabel "Demand Charge"@en ;
    skos:exactMatch urpx:demandDirect ;
    skos:note "Peak demand charges map to URPX demandDirect."@en .

lfe:FixedCharge a skos:Concept ;
    skos:prefLabel "Fixed Charge"@en ;
    skos:closeMatch urpx:minimumCharge, urpx:serviceMetered ;
    skos:note "Fixed monthly charges map to URPX minimumCharge or serviceMetered depending on context."@en .

lfe:CustomerCharge a skos:Concept ;
    skos:prefLabel "Customer Charge"@en ;
    skos:exactMatch urpx:minimumCharge ;
    skos:note "Monthly customer service charge maps to URPX minimumCharge."@en .

# ============================================
# URPX to LF Energy Reverse Alignment (Informational)
# ============================================

urpx:serviceCharge skos:closeMatch lfe:BaseCharge, lfe:FixedCharge, lfe:RegularCharge .
urpx:taxes skos:exactMatch lfe:Tax .
urpx:auxiliaryCharge skos:closeMatch lfe:ConsumptionCharge, lfe:DemandCharge, lfe:RegularCharge .
urpx:adjustment skos:closeMatch lfe:Surcharge .
urpx:regulatory skos:closeMatch lfe:Surcharge .
urpx:environmental skos:closeMatch lfe:Surcharge .
urpx:infrastructure skos:closeMatch lfe:RegularCharge .
